---
// src/views/Recipes/Detail/index.astro
import { getLocale } from '../../../i18n/i18n';
import './styles.css';
import RecipeCard from '../../../components/recipes/RecipeCard.astro';
import RelatedRecipesCarousel from '../../../components/recipes/RelatedRecipesCarousel.astro';
import Breadcrumb from '../../../components/common/Breadcrumb/Breadcrumb.astro';
import LazyImage from '../../../components/common/LazyImage.astro';
import IngredientsCarousel from '../../../components/recipes/IngredientsCarousel.astro';
import ShareButton from '../../../components/common/ShareButton.astro';
import VideoModal from '../../../components/recipes/VideoModal.astro';
import { getAllRecipes, getRecipeBySlug } from '../../../services/api/recipes';

interface RecipeItem {
  id: string;
  slug?: string;
  title: string;
  description?: string;
  ingredients?: string[];
  instructions?: string[];
  preparation_time?: number;
  servings?: number;
  people?: string | number;
  image?: string;
  tags?: string[];
  product_image?: string;
  difficulty?: string;
  video?: string;
  date?: string;
}

const { currentLang, recipeId } = Astro.props;

// Obtener recetas desde el CMS (con fallback local)
const cmsRecipes = await getAllRecipes(currentLang);

const recipeModules = import.meta.glob<{ default: any }>("../../../locales/*/recipes/*.json");
const localRecipes: any[] = [];
for (const path in recipeModules) {
  const langMatch = path.match(/locales\/([^/]+)\//);
  const pathLang = langMatch?.[1];
  if (pathLang === currentLang) {
    const mod = await recipeModules[path]();
    const item = mod.default ?? (mod as any);
    if (item?.id) localRecipes.push(item);
  }
}

const allRecipes: any[] = cmsRecipes.length > 0 ? cmsRecipes : localRecipes;

let recipe = await getRecipeBySlug(recipeId, currentLang);
if (!recipe) {
  recipe = allRecipes.find((item: any) => item.id === recipeId || item.slug === recipeId) || null;
}

const relatedRecipes = allRecipes
  .filter((item: any) => item.id !== recipe?.id && item.slug !== recipe?.slug)
  .sort((a: any, b: any) => {
    const dateA = a.date;
    const dateB = b.date;
    if (!dateA && dateB) return 1;
    if (dateA && !dateB) return -1;
    if (!dateA && !dateB) return 0;
    return new Date(dateB).getTime() - new Date(dateA).getTime();
  })
  .slice(0, 5);

if (!recipe) {
  throw new Error(`Recipe with id ${recipeId} not found`);
}

// Shared labels
const recipesAssets = {
  ingredientsLabel: currentLang === 'es' ? 'Inventario' : 'Inventory',
  preparationLabel: currentLang === 'es' ? 'Tutorial' : 'Tutorial',
  timeLabel: currentLang === 'es' ? 'Tiempo' : 'Time',
  difficultyLabel: currentLang === 'es' ? 'Dificultad' : 'Difficulty',
  related_recipes: currentLang === 'es' ? 'Recetas relacionadas' : 'Related recipes',
  dragonTitleTop: currentLang === 'es' ? 'DESCUBRE TU DRAGÓN' : 'DISCOVER YOUR DRAGON',
  dragonTitleBottom: currentLang === 'es' ? '¿QUIÉN ARDE MÁS?' : 'WHO BURNS MORE?'
};

function formatTime(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  
  if (currentLang === 'es') {
    return hours > 0 
      ? `${hours}h ${mins}min` 
      : `${mins}min`;
  } else {
    return hours > 0 
      ? `${hours}h ${mins}m` 
      : `${mins}m`;
  }
}
---
<div style="background: radial-gradient(circle at 50% 50%, #2c0b0b 0%, #150404 80%);" class="pb-0 overflow-hidden">
  <div class="w-full max-w-6xl mx-auto px-4 pt-12">
    
  </div>

  <!-- Hero: imagen + datos principales -->
  <section id="hero" class="pt-8 md:pt-24 pb-8" transition:animate="slide">
    <div class="w-full max-w-6xl mx-auto px-4 flex flex-col md:flex-row gap-8 items-start md:items-stretch">
      <!-- Columna 1: Imagen -->
      {recipe.image && (
        <div class="w-full md:w-1/2 flex justify-center md:justify-start">
          <div 
            class={`relative rounded-2xl overflow-hidden w-full max-w-lg h-72 md:h-96 bg-black/30 ${recipe.video ? 'group cursor-pointer' : ''}`}
            data-has-video={recipe.video ? 'true' : 'false'}
            data-video-url={recipe.video || ''}
            id="recipe-detail-image"
          >
            <LazyImage
              src={recipe.image}
              alt={recipe.title}
              class="w-full h-full object-cover"
              onerror="this.onerror=null;this.src='/images/recipes/placeholder.jpg';"
              transition:name={`recipe-image-${recipe.id}`}
            />
            
            <!-- Icono de play si tiene video - estilo boton carousel redondo -->
            {recipe.video && (
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-all duration-300 cursor-pointer">
                <div class="w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[rgba(255,45,48,0.25)] transition-colors duration-200">
                  <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    class="h-10 w-10 md:h-12 md:w-12 text-white ml-1" 
                    viewBox="0 0 24 24" 
                    fill="currentColor"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Columna 2: título, share, tiempo, dificultad -->
      <div class="w-full md:w-1/2 flex flex-col gap-6 md:py-4 text-white">
        <h1 class="font-title md:text-5xl text-4xl font-bold text-white uppercase italic leading-tight">
          {recipe.title}
        </h1>

        <!-- Compartir: íconos blancos -->
        <div>
          <ShareButton className="mt-1" lang={currentLang} url={Astro.url.href} />
        </div>

        <!-- Tiempo y dificultad -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
          <div class="flex items-center gap-3 rounded-xl border border-white/20 bg-black/30 px-4 py-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-orange-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-wide text-white/70">{recipesAssets.timeLabel}</span>
              <span class="text-sm md:text-base font-semibold">{formatTime(recipe.preparation_time)}</span>
            </div>
          </div>

          <div class="flex items-center gap-3 rounded-xl border border-white/20 bg-black/30 px-4 py-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-orange-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              />
            </svg>
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-wide text-white/70">{recipesAssets.difficultyLabel}</span>
              <span class="text-sm md:text-base font-semibold">{recipe.difficulty || (currentLang === 'es' ? '---' : '---')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Acordeones: Inventario / Tutorial -->
  <section id="recipe-details" class="mb-8 pb-8">
    <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-4">
      <!-- Ingredientes / Inventario -->
      <details class="group bg-black/40 border border-white/15 rounded-2xl overflow-hidden">
        <summary class="flex items-center justify-between cursor-pointer px-5 py-4 select-none">
          <span class="font-title text-xl text-white uppercase italic">
            {recipesAssets.ingredientsLabel}
          </span>
          <span class="flex items-center justify-center w-6 h-6 rounded-full border border-white/40 text-sm font-bold text-white">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">-</span>
          </span>
        </summary>
        <div class="px-5 pb-5 text-white">
          <ul class="list-disc list-inside space-y-2 text-white">
            {recipe.ingredients.map((item: string) => (
              <li class="text-white text-base md:text-lg">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </details>

      <!-- Preparación / Tutorial -->
      <details class="group bg-black/40 border border-white/15 rounded-2xl overflow-hidden recipe-preparation">
        <summary class="flex items-center justify-between cursor-pointer px-5 py-4 select-none">
          <span class="font-title text-xl text-white uppercase italic">
            {recipesAssets.preparationLabel}
          </span>
          <span class="flex items-center justify-center w-6 h-6 rounded-full border border-white/40 text-sm font-bold text-white">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">-</span>
          </span>
        </summary>
        <div class="px-5 pb-5 text-white prep-text">
          <ul class="list-disc list-inside space-y-2 text-white">
            {recipe.instructions.map((instruction: string) => (
              <li class="text-white text-base md:text-lg">
                {instruction}
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </section>

  <div id="suggestions_related" class="mt-[-2rem] flex flex-col justify-center items-center pt-12 pb-16 " transition:animate="fade">
    <div class="w-full max-w-6xl px-4">
      <div class="flex items-start justify-between gap-4 mb-10">
        <div class="title text-left">
          <p>{recipesAssets.dragonTitleTop}</p>
          <p>{recipesAssets.dragonTitleBottom}</p>
        </div>

        {relatedRecipes.length > 1 && (
          <div class="flex gap-3 flex-shrink-0">
            <button
              type="button"
              id="relPrevRelated"
              class="w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
              aria-label="Anterior"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <button
              type="button"
              id="relNextRelated"
              class="w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
              aria-label="Siguiente"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.0002 7 15.0002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        )}
      </div>

      <!-- Carousel reutilizable con la lista de recetas sugeridas (usa RecipeCard) -->
      <div class="w-full mt-6">
        {relatedRecipes.length > 0 && (
          <RelatedRecipesCarousel items={relatedRecipes} prevBtnId="relPrevRelated" nextBtnId="relNextRelated" />
        )}
      </div>
    </div>
  </div>


<!-- Close background wrapper -->
</div>

<!-- Video Modal -->
{recipe.video && <VideoModal videoId={recipe.video} isOpen={false} />}

<script>
  // Este script se ejecuta solo en el navegador
  document.addEventListener('DOMContentLoaded', () => {
    // Manejo de imágenes que fallan al cargar
    document.querySelectorAll('.recipe-detail img').forEach(img => {
      if (!img.hasAttribute('onerror')) {
        img.addEventListener('error', function(this: HTMLImageElement) {
          this.onerror = null;
          this.src = '/images/recipes/placeholder.jpg';
        });
      }
    });
    
    // Manejar clic en la imagen del detalle si tiene video
    const detailImage = document.getElementById('recipe-detail-image');
    if (detailImage && detailImage.dataset.hasVideo === 'true') {
      detailImage.addEventListener('click', (e) => {
        e.preventDefault();
        const videoUrl = detailImage.dataset.videoUrl;
        if (videoUrl) {
          if ((window as any).openVideoModal) {
            (window as any).openVideoModal(videoUrl);
          } else {
            document.dispatchEvent(new CustomEvent('open-video-modal', { 
              detail: { videoUrl } 
            }));
          }
        }
      });
    }
  });
  
  // También para Astro page transitions
  document.addEventListener('astro:page-load', () => {
    const detailImage = document.getElementById('recipe-detail-image');
    if (detailImage && detailImage.dataset.hasVideo === 'true') {
      detailImage.addEventListener('click', (e) => {
        e.preventDefault();
        const videoUrl = detailImage.dataset.videoUrl;
        if (videoUrl) {
          if ((window as any).openVideoModal) {
            (window as any).openVideoModal(videoUrl);
          } else {
            document.dispatchEvent(new CustomEvent('open-video-modal', { 
              detail: { videoUrl } 
            }));
          }
        }
      });
    }
  });
</script>
