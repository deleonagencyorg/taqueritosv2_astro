---
// src/views/Recipes/index.astro
import { getLocale } from '../../i18n/i18n';
import './styles.css';
import RecipeCard from '../../components/recipes/RecipeCard.astro';
import LazyImage from '../../components/common/LazyImage.astro';
import PixelGrid from '../../components/atoms/PixelGrid.astro';
import Breadcrumb from '../../components/common/Breadcrumb/Breadcrumb.astro';
import VideoHero from '../../components/common/VideoHero/VideoHero.astro';

interface Recipe {
  id: string;
  title: string;
  image?: string;
  ['preview-image']?: string;
  preparation_time: number;
  type?: string;
  // Ahora `product` es un array de strings (puede haber más de un producto por receta)
  product?: string[];
  video?: string;
  date?: string;
}

const currentLang = getLocale();

// Get all recipe files with correct Vite glob typing
const recipeModules = import.meta.glob<{default: Recipe}>('../../locales/*/recipes/*.json');
const allRecipes: Recipe[] = [];

// Process each file
for (const path in recipeModules) {
  // Usar regex para extraer el idioma del path (funciona con rutas relativas y absolutas)
  const langMatch = path.match(/locales\/([^/]+)\//);
  const pathLang = langMatch?.[1];
  if (pathLang === currentLang) {
    const module = await recipeModules[path]();
    const item = module.default ?? (module as any);
    // Guardar solo entradas válidas con id y title
    if (item?.id && item?.title) allRecipes.push(item);
  }
}

// Ordenar recetas por fecha descendente (más nuevas primero), sin fecha al final
allRecipes.sort((a: Recipe, b: Recipe) => {
  const dateA = (a as any).date;
  const dateB = (b as any).date;
  
  // Si A no tiene fecha, va al final
  if (!dateA && dateB) return 1;
  // Si B no tiene fecha, va al final
  if (dateA && !dateB) return -1;
  // Si ninguno tiene fecha, mantener orden original
  if (!dateA && !dateB) return 0;
  // Orden descendente (más reciente primero)
  return new Date(dateB).getTime() - new Date(dateA).getTime();
});

// Shared translations
const noRecipesText = currentLang === 'es' 
  ? 'No hay recetas disponibles en este momento.' 
  : 'No recipes available at this time.';
const noFilterResultsText = currentLang === 'es'
  ? 'No se encontraron resultados para la selección'
  : 'No results found for the selection';

// Filter labels
const categoryFilterLabels = currentLang === 'es'
  ? {
      label: 'Momento del dia',
      all: 'Todas las recetas',
      breakfast: 'Desayuno',
      lunch: 'Almuerzo',
      snack: 'Snack',
    }
  : {
      label: 'Meal',
      all: 'All recipes',
      breakfast: 'Breakfast',
      lunch: 'Lunch',
      snack: 'Snack',
    };

const productFilterLabels = currentLang === 'es'
  ? {
      label: 'Producto',
      all: 'Todos los productos',
    }
  : {
      label: 'Product',
      all: 'All products',
    };

// Normaliza la categoría de receta.
// Nota: en los JSON se usa "type" para cosas como el tipo de media (p.ej. "image").
// Para los filtros debemos priorizar la propiedad "category" si existe.
function normalizeType(r: Recipe): string {
  const rawCategory = String((r as any).category || '').toLowerCase().trim();
  const rawType = String((r as any).type || '').toLowerCase().trim();

  // Primero intentar con category
  const raw = rawCategory || rawType;

  if (['breakfast', 'desayuno'].includes(raw)) return 'breakfast';
  if (['brunch'].includes(raw)) return 'brunch';
  if (['lunch', 'almuerzo'].includes(raw)) return 'lunch';
  if (['snack'].includes(raw)) return 'snack';
  return 'other';
}

function getRecipeGridImage(recipe: Recipe): string {
  const previewImage = String((recipe as any)['preview-image'] || '').trim();
  if (previewImage.length > 0) return previewImage;

  const mainImage = String(recipe.image || '').trim();
  return mainImage || '/images/recipes/placeholder.jpg';
}

// Unique product options for the product filter (extract from recipes)
const productOptions = Array.from(
  new Set(
    allRecipes
      .flatMap((r) => {
        const p = (r as any).product;
        if (Array.isArray(p)) return p;
        return p ? [p] : [];
      })
      .map((p) => String(p).trim())
      .filter((p) => p.length > 0)
  )
);


// Video hero config for Recipes page
const videoUrl = 'https://snack.yummiespromociones.com/taqueritos/videotaqueritos.mp4';
const fallbackImageUrl = 'https://snack.yummiespromociones.com/taqueritos/videorecetas.png';
---
<div class="-mt-px -mb-px overflow-hidden" style="background: radial-gradient(circle at 50% 50%, #2c0b0b 0%, #150404 80%);">
  <div id="herovideo" class="pt-0">
    <VideoHero
      videoUrl={videoUrl}
      mobileVideoUrl="https://snack.yummiespromociones.com/taqueritos/tabla-quesos.mp4"
      fallbackImageUrl={fallbackImageUrl}
      height="520px"
      width="100%"
      showOverlay={false}
    />
  </div>

  <div class="container mx-auto px-4 py-18 mt-0">

    <div class="h-8 md:h-12"></div>

    <!-- Filter Dropdowns -->
    <div class="w-full flex flex-col md:flex-row gap-4 mb-10 max-w-5xl mx-auto md:items-end relative z-30">
      <!-- Category filter -->
      <div class="flex-1 text-left relative custom-dropdown-container z-20" data-filter-id="categoryFilter">
        <label for="categoryFilter" class="block text-sm md:text-base font-semibold text-white mb-2">
          {categoryFilterLabels.label}
        </label>
        
        <select
          id="categoryFilter"
          class="sr-only"
          tabindex="-1"
          aria-hidden="true"
        >
          <option value="all">{categoryFilterLabels.all}</option>
          <option value="breakfast">{categoryFilterLabels.breakfast}</option>
          <option value="lunch">{categoryFilterLabels.lunch}</option>
          <option value="snack">{categoryFilterLabels.snack}</option>
        </select>

        <button
          type="button"
          class="custom-dropdown-btn w-full flex items-center justify-between bg-transparent border border-white rounded-md px-4 py-2.5 text-white text-sm md:text-base font-semibold focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-orange-400 transition-all cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="custom-dropdown-label truncate">{categoryFilterLabels.all}</span>
          <svg class="w-4 h-4 text-white/80 transition-transform duration-200 shrink-0 ml-2 custom-dropdown-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          class="custom-dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 w-full bg-[#1e0808] border border-white/30 rounded-md shadow-2xl py-2 z-50 backdrop-blur-md max-h-60 overflow-y-auto"
          role="listbox"
        >
          <button
            type="button"
            class="custom-dropdown-item w-full text-left px-4 py-2.5 text-sm md:text-base text-white font-semibold bg-white/10 hover:bg-white/15 transition-colors flex items-center justify-between cursor-pointer active:bg-orange-500/20"
            data-value="all"
            role="option"
            aria-selected="true"
          >
            <span>{categoryFilterLabels.all}</span>
            <svg class="check-icon w-4 h-4 text-orange-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
          <button
            type="button"
            class="custom-dropdown-item w-full text-left px-4 py-2.5 text-sm md:text-base text-white/90 hover:bg-white/15 hover:text-white font-semibold transition-colors flex items-center justify-between cursor-pointer active:bg-orange-500/20"
            data-value="breakfast"
            role="option"
            aria-selected="false"
          >
            <span>{categoryFilterLabels.breakfast}</span>
            <svg class="check-icon w-4 h-4 text-orange-400 shrink-0 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
          <button
            type="button"
            class="custom-dropdown-item w-full text-left px-4 py-2.5 text-sm md:text-base text-white/90 hover:bg-white/15 hover:text-white font-semibold transition-colors flex items-center justify-between cursor-pointer active:bg-orange-500/20"
            data-value="lunch"
            role="option"
            aria-selected="false"
          >
            <span>{categoryFilterLabels.lunch}</span>
            <svg class="check-icon w-4 h-4 text-orange-400 shrink-0 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
          <button
            type="button"
            class="custom-dropdown-item w-full text-left px-4 py-2.5 text-sm md:text-base text-white/90 hover:bg-white/15 hover:text-white font-semibold transition-colors flex items-center justify-between cursor-pointer active:bg-orange-500/20"
            data-value="snack"
            role="option"
            aria-selected="false"
          >
            <span>{categoryFilterLabels.snack}</span>
            <svg class="check-icon w-4 h-4 text-orange-400 shrink-0 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>

      {/* Product filter: solo se muestra si hay productos configurados */}
      {productOptions.length > 0 && (
        <div class="flex-1 text-left relative custom-dropdown-container z-10" data-filter-id="productFilter">
          <label for="productFilter" class="block text-sm md:text-base font-semibold text-white mb-2">
            {productFilterLabels.label}
          </label>
          <select
            id="productFilter"
            class="sr-only"
            tabindex="-1"
            aria-hidden="true"
          >
            <option value="all">{productFilterLabels.all}</option>
            {productOptions.map((product) => (
              <option value={product.toLowerCase()}>{product}</option>
            ))}
          </select>

          <button
            type="button"
            class="custom-dropdown-btn w-full flex items-center justify-between bg-transparent border border-white rounded-md px-4 py-2.5 text-white text-sm md:text-base font-semibold focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-orange-400 transition-all cursor-pointer"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span class="custom-dropdown-label truncate">{productFilterLabels.all}</span>
            <svg class="w-4 h-4 text-white/80 transition-transform duration-200 shrink-0 ml-2 custom-dropdown-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            class="custom-dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 w-full bg-[#1e0808] border border-white/30 rounded-md shadow-2xl py-2 z-50 backdrop-blur-md max-h-60 overflow-y-auto"
            role="listbox"
          >
            <button
              type="button"
              class="custom-dropdown-item w-full text-left px-4 py-2.5 text-sm md:text-base text-white font-semibold bg-white/10 hover:bg-white/15 transition-colors flex items-center justify-between cursor-pointer active:bg-orange-500/20"
              data-value="all"
              role="option"
              aria-selected="true"
            >
              <span>{productFilterLabels.all}</span>
              <svg class="check-icon w-4 h-4 text-orange-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>
            {productOptions.map((product) => (
              <button
                type="button"
                class="custom-dropdown-item w-full text-left px-4 py-2.5 text-sm md:text-base text-white/90 hover:bg-white/15 hover:text-white font-semibold transition-colors flex items-center justify-between cursor-pointer active:bg-orange-500/20"
                data-value={product.toLowerCase()}
                role="option"
                aria-selected="false"
              >
                <span>{product}</span>
                <svg class="check-icon w-4 h-4 text-orange-400 shrink-0 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Section title above recipes -->
    <div class="max-w-5xl mx-auto mb-6 px-1">
      <div class="title">
        <p>
          {currentLang === 'es' ? 'Recetas para subir de nivel' : 'Recipes to level up'}
        </p>
      </div>
    </div>

    {allRecipes.length === 0 ? (
      <p class="text-center text-gray-500">{noRecipesText}</p>
    ) : (
      <div id="recipesGrid" class="w-full mx-auto grid items-stretch grid-cols-2 xxs-only:grid-cols-1 lg:grid-cols-3 gap-4 md:gap-6 mt-12">
        {allRecipes.map((recipe: Recipe) => (
          <div
            class="recipe-card h-full"
            data-type={normalizeType(recipe)}
            data-product={Array.isArray((recipe as any).product)
              ? (recipe as any).product.map((p: string) => String(p).toLowerCase()).join('|')
              : ((recipe as any).product ? String((recipe as any).product).toLowerCase() : '')}
          >
            <RecipeCard
              image={getRecipeGridImage(recipe)}
              title={recipe.title}
              time={`${recipe.preparation_time} MIN`}
              id={recipe.id}
              textColor="text-white"
              iconColor="text-white"
              video={(recipe as any).video}
            />
          </div>
        ))}
      </div>

      <div class="w-full flex justify-center mt-10">
        <button
          id="recipesLoadMore"
          type="button"
          class="w-full max-w-xs border border-[#FF0048] rounded-[16px] bg-gradient-to-b from-[#FF0048] to-[#FF5255] shadow-[0_3px_0_0_rgba(88,0,29,0.9)] hover:shadow-[0_1px_0_0_rgba(88,0,29,0.9)] hover:translate-y-[2px] transition-all duration-150 text-white py-3 px-6 font-semibold"
        >
          {currentLang === 'es' ? 'Cargar más' : 'Load more'}
        </button>
      </div>
      <!-- No results message for filters -->
      <div id="noResults" class="hidden mt-6 items-center justify-center h-48 md:h-64">
        <span class="text-white text-lg md:text-xl font-semibold">{noFilterResultsText}</span>
      </div>
    )}
  </div>
</div>

<script>
  function initRecipesFilters() {
    const recipesGrid = document.getElementById('recipesGrid');
    if (!recipesGrid) return;
    
    // Prevent double initialization
    if ((recipesGrid as any)._filtersInit) return;
    (recipesGrid as any)._filtersInit = true;

    // Fallback image handling
    const images = document.querySelectorAll('img');
    images.forEach((img) => {
      if (!(img as any)._errorHandlerAdded) {
        (img as any)._errorHandlerAdded = true;
        img.addEventListener('error', function() {
          this.src = '/images/recipes/placeholder.jpg';
        });
      }
    });

    // Filters
    const categorySelect = document.getElementById('categoryFilter') as HTMLSelectElement | null;
    const productSelect = document.getElementById('productFilter') as HTMLSelectElement | null;
    const cards = Array.from(document.querySelectorAll('#recipesGrid .recipe-card')) as HTMLElement[];
    const noResultsEl = document.getElementById('noResults') as HTMLElement | null;
    const loadMoreBtn = document.getElementById('recipesLoadMore') as HTMLButtonElement | null;

    // Pagination settings
    const pageSize = 6;
    let currentCategory = categorySelect?.value || 'all';
    let currentProduct = productSelect?.value || 'all';
    let revealedCount = 0;

    // Hide all cards
    function hideAll() {
      cards.forEach((c) => (c.style.display = 'none'));
    }

    // Get cards matching current filters
    function getMatchingCards() {
      return cards.filter((card) => {
        const type = (card.dataset.type || 'other').toLowerCase();
        const productRaw = (card.dataset.product || '').toLowerCase();

        const matchesCategory = currentCategory === 'all' || type === currentCategory;

        // productRaw puede contener múltiples productos separados por '|'
        const productTokens = productRaw
          .split('|')
          .map((p) => p.trim())
          .filter((p) => p.length > 0);

        // Check if any product token matches the selected product (case insensitive)
        const selectedProductLower = currentProduct.toLowerCase();
        const matchesProduct =
          currentProduct === 'all' ||
          productTokens.some((token) => token === selectedProductLower);

        return matchesCategory && matchesProduct;
      });
    }

    // Reveal next page of matching cards
    function revealNextPage() {
      const matching = getMatchingCards();
      const nextBatch = matching.slice(revealedCount, revealedCount + pageSize);
      nextBatch.forEach((card) => (card.style.display = ''));
      revealedCount += nextBatch.length;

      // Toggle no-results
      const anyVisible = matching.length > 0;
      if (noResultsEl) {
        if (anyVisible) {
          noResultsEl.classList.add('hidden');
          noResultsEl.classList.remove('flex');
        } else {
          noResultsEl.classList.remove('hidden');
          noResultsEl.classList.add('flex');
        }
      }

      if (loadMoreBtn) {
        const canLoadMore = revealedCount < matching.length;
        if (anyVisible && canLoadMore) {
          loadMoreBtn.classList.remove('hidden');
        } else {
          loadMoreBtn.classList.add('hidden');
        }
      }
    }

    // Apply filters and reset pagination
    function applyFilters() {
      revealedCount = 0;
      hideAll();
      revealNextPage();
    }

    // Events for dropdowns
    if (categorySelect) {
      categorySelect.addEventListener('change', () => {
        currentCategory = (categorySelect.value || 'all').toLowerCase();
        applyFilters();
      });
    }

    if (productSelect) {
      productSelect.addEventListener('change', () => {
        const value = productSelect.value || 'all';
        currentProduct = value.toLowerCase();
        applyFilters();
      });
    }

    function initCustomDropdowns() {
      const containers = document.querySelectorAll('.custom-dropdown-container');

      function closeAllDropdowns() {
        containers.forEach((c) => {
          const menu = c.querySelector('.custom-dropdown-menu');
          const btn = c.querySelector('.custom-dropdown-btn');
          const icon = c.querySelector('.custom-dropdown-icon');
          if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('hidden');
            btn?.setAttribute('aria-expanded', 'false');
            icon?.classList.remove('rotate-180');
          }
        });
      }

      containers.forEach((container) => {
        const filterId = container.getAttribute('data-filter-id');
        const select = filterId ? (document.getElementById(filterId) as HTMLSelectElement | null) : null;
        const btn = container.querySelector('.custom-dropdown-btn') as HTMLButtonElement | null;
        const menu = container.querySelector('.custom-dropdown-menu') as HTMLElement | null;
        const labelEl = container.querySelector('.custom-dropdown-label') as HTMLElement | null;
        const icon = container.querySelector('.custom-dropdown-icon') as HTMLElement | null;
        const items = container.querySelectorAll('.custom-dropdown-item') as NodeListOf<HTMLButtonElement>;

        if (!btn || !menu) return;

        const newBtn = btn.cloneNode(true) as HTMLButtonElement;
        btn.parentNode?.replaceChild(newBtn, btn);

        newBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = !menu.classList.contains('hidden');
          closeAllDropdowns();
          if (!isOpen) {
            menu.classList.remove('hidden');
            newBtn.setAttribute('aria-expanded', 'true');
            icon?.classList.add('rotate-180');
          }
        });

        items.forEach((item) => {
          const newItem = item.cloneNode(true) as HTMLButtonElement;
          item.parentNode?.replaceChild(newItem, item);

          newItem.addEventListener('click', (e) => {
            e.stopPropagation();
            const val = newItem.getAttribute('data-value') || 'all';
            const text = newItem.querySelector('span')?.textContent || '';

            if (labelEl) labelEl.textContent = text;

            const allItems = container.querySelectorAll('.custom-dropdown-item') as NodeListOf<HTMLButtonElement>;
            allItems.forEach((it) => {
              const check = it.querySelector('.check-icon');
              const isMatch = it === newItem;
              it.setAttribute('aria-selected', isMatch ? 'true' : 'false');
              if (isMatch) {
                it.classList.add('text-white', 'bg-white/10');
                it.classList.remove('text-white/90');
                check?.classList.remove('hidden');
              } else {
                it.classList.remove('text-white', 'bg-white/10');
                it.classList.add('text-white/90');
                check?.classList.add('hidden');
              }
            });

            menu.classList.add('hidden');
            newBtn.setAttribute('aria-expanded', 'false');
            icon?.classList.remove('rotate-180');

            if (select) {
              select.value = val;
              select.dispatchEvent(new Event('change'));
            }
          });
        });
      });

      if (!(document as any)._dropdownOutsideClickAttached) {
        (document as any)._dropdownOutsideClickAttached = true;
        document.addEventListener('click', () => {
          const allOpenMenus = document.querySelectorAll('.custom-dropdown-menu:not(.hidden)');
          allOpenMenus.forEach((menu) => {
            menu.classList.add('hidden');
            const container = menu.closest('.custom-dropdown-container');
            container?.querySelector('.custom-dropdown-btn')?.setAttribute('aria-expanded', 'false');
            container?.querySelector('.custom-dropdown-icon')?.classList.remove('rotate-180');
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            const allOpenMenus = document.querySelectorAll('.custom-dropdown-menu:not(.hidden)');
            allOpenMenus.forEach((menu) => {
              menu.classList.add('hidden');
              const container = menu.closest('.custom-dropdown-container');
              container?.querySelector('.custom-dropdown-btn')?.setAttribute('aria-expanded', 'false');
              container?.querySelector('.custom-dropdown-icon')?.classList.remove('rotate-180');
            });
          }
        });
      }
    }

    initCustomDropdowns();

    // Initialize default state (ALL)
    applyFilters();

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const matching = getMatchingCards();
        if (revealedCount < matching.length) {
          revealNextPage();
        }
      });
    }
  }

  // Initialize on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecipesFilters);
  } else {
    initRecipesFilters();
  }

  // Re-initialize on Astro page navigation (View Transitions)
  document.addEventListener('astro:page-load', initRecipesFilters);
  document.addEventListener('astro:after-swap', () => {
    // Reset init flag on swap so it can re-init
    const recipesGrid = document.getElementById('recipesGrid');
    if (recipesGrid) {
      (recipesGrid as any)._filtersInit = false;
    }
    initRecipesFilters();
  });
</script>

<style>
  /* Active filter visual state (keeps tailwind classes consistent) */
  #recipeFilters .filter-btn.bg-brown {
    /* nothing else, class toggles handle colors */
  }

  .custom-dropdown-container label,
  .custom-dropdown-btn,
  .custom-dropdown-label,
  .custom-dropdown-item,
  .custom-dropdown-item span {
    font-family: var(--font-text), 'Rockeby regular', sans-serif !important;
  }
</style>
