  <!-- Carrusel de promos activas (solo español) - Full width -->
  {currentLang === 'es' && promosSlides.length > 0 && (
    <section class="w-full">
      <VideoCarousel 
        slides={promosSlides} 
        height="70vh" 
        mobileHeight="50vh" 
        showOverlay={false} 
      />
