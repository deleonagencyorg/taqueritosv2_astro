    background: transparent !important;
  }

  /* Ajustes menores de scroll-snap y padding */
  .games-carousel-track {
    scroll-padding-left: 0;
  }
</style>

<style>
  .games-carousel-wrapper {
    overflow: visible;
    background: transparent !important;
  }

  .games-carousel-track {
    overflow-y: visible;
    background: transparent !important;
    scroll-padding-left: 0;
  }

  .game-card {
    opacity: 1;
    transform: translateY(0) scale(1);
    box-shadow: none;
  }

  .game-card-active {
    opacity: 1;
    transform: translateY(-6px) scale(1.04);
    box-shadow: 0 0 30px rgba(255, 45, 45, 0.7);
  }

  .game-card-dim {
    opacity: 0.45;
  }
</style>

    <section class="mt-10 pt-6 pb-4 calendar-section" >
