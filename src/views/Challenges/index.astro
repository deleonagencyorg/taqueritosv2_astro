<script>
  // Script para el carrusel de juegos (mejorado: cálculo dinámico del desplazamiento y snap)
  function initGamesCarousel() {
    const track = document.querySelector('.games-carousel-track') as HTMLElement | null;
    const prevBtn = document.querySelector('.games-carousel-btn-prev') as HTMLButtonElement | null;
    const nextBtn = document.querySelector('.games-carousel-btn-next') as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const trackEl = track as HTMLElement;
    const prevBtnEl = prevBtn as HTMLButtonElement;
    const nextBtnEl = nextBtn as HTMLButtonElement;

    // Habilitar scroll snapping para alinear tarjetas exactamente
    trackEl.style.scrollSnapType = 'x mandatory';
    Array.from(trackEl.querySelectorAll('.game-card')).forEach((c: Element) => {
      (c as HTMLElement).style.scrollSnapAlign = 'start';
    });

    function getScrollAmount() {
      const first = trackEl.querySelector('.game-card') as HTMLElement | null;
      if (!first) return 220;
      const cardWidth = Math.round(first.getBoundingClientRect().width);
      // intentamos obtener el gap (soporte moderno para flex gap)
      const gapStyle = getComputedStyle(trackEl).columnGap || getComputedStyle(trackEl).gap || '0px';
      const gap = Math.round(parseFloat(gapStyle) || 0);
      return cardWidth + gap;
    }

    let scrollAmount = getScrollAmount();

    // Recalcular al redimensionar para mantener exactitud
    let resizeTimeout: any = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => { scrollAmount = getScrollAmount(); }, 120);
    });

    prevBtnEl.addEventListener('click', () => {
      trackEl.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    nextBtnEl.addEventListener('click', () => {
      trackEl.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  }

  // Inicializar al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGamesCarousel);
  } else {
    initGamesCarousel();
  }

  // Reinicializar en navegación de Astro
  document.addEventListener('astro:page-load', initGamesCarousel);

  // Hover: resaltar tarjeta activa con glow rojo y bajar opacidad del resto
  function initGamesHover() {
    const cards = Array.from(document.querySelectorAll('.game-card')) as HTMLElement[];
    if (!cards.length) return;

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        cards.forEach((c) => {
          c.classList.add('game-card-dim');
          c.classList.remove('game-card-active');
        });
        card.classList.remove('game-card-dim');
        card.classList.add('game-card-active');
      });

      card.addEventListener('mouseleave', () => {
        cards.forEach((c) => {
          c.classList.remove('game-card-dim', 'game-card-active');
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGamesHover);
  } else {
    initGamesHover();
  }

  document.addEventListener('astro:page-load', initGamesHover);
</script>

<script>
  function initCalendarCarousel() {
    const containers = document.querySelectorAll('[data-calendar-carousel]');
    containers.forEach((container) => {
      if ((container as any)._calendarInit) return;
      (container as any)._calendarInit = true;

      const track = container.querySelector('[data-calendar-track]') as HTMLElement | null;
      let prevBtn = container.querySelector('.calendar-carousel-btn-prev') as HTMLButtonElement | null;
      let nextBtn = container.querySelector('.calendar-carousel-btn-next') as HTMLButtonElement | null;
      if (!prevBtn || !nextBtn) {
        const sectionEl = container.closest('section') || container.parentElement;
        if (sectionEl) {
          prevBtn = sectionEl.querySelector('.calendar-carousel-btn-prev') as HTMLButtonElement | null;
          nextBtn = sectionEl.querySelector('.calendar-carousel-btn-next') as HTMLButtonElement | null;
        }
      }
      const slides = Array.from(container.querySelectorAll('.calendar-slide')) as HTMLElement[];
      if (!track || slides.length === 0) return;

      let currentIndex = 0;

      function getVisibleCount() {
        const w = window.innerWidth;
        if (w >= 1024) return 2; // desktop: 2 per view
        return 1; // mobile: 1
      }

      function getMaxIndex() {
        const visible = getVisibleCount();
        return Math.max(0, slides.length - visible);
      }

      function updateCarousel() {
        const visible = getVisibleCount();
        const slideWidth = 100 / visible;
        slides.forEach((s) => { s.style.width = `${slideWidth}%`; });
        const offset = currentIndex * slideWidth;
        track.style.transform = `translateX(-${offset}%)`;
      }

      function goNext() {
        const max = getMaxIndex();
        if (currentIndex < max) currentIndex++; else currentIndex = 0;
        updateCarousel();
      }
      function goPrev() {
        const max = getMaxIndex();
        if (currentIndex > 0) currentIndex--; else currentIndex = max;
        updateCarousel();
      }

      if (prevBtn) prevBtn.addEventListener('click', goPrev);
      if (nextBtn) nextBtn.addEventListener('click', goNext);

      let resizeTimeout: any = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          const max = getMaxIndex();
          if (currentIndex > max) currentIndex = max;
          updateCarousel();
        }, 120);
      });

      updateCarousel();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalendarCarousel);
  } else {
    initCalendarCarousel();
  }

  document.addEventListener('astro:page-load', initCalendarCarousel);
</script>

<style>
  .calendar-carousel-container { width: 100%; }
  .calendar-carousel-viewport { width: 100%; overflow-x: hidden; }
  .calendar-carousel-track { display:flex; will-change: transform; align-items: stretch; }
  .calendar-slide { flex-shrink:0; padding: 0 8px; box-sizing: border-box; display:flex; }
  .calendar-slide img, .calendar-slide picture, .calendar-slide .lazy-image { width:100%; height:100%; }
  @media (min-width: 768px) {
    .calendar-slide { padding: 0 10px; }
  }
  @media (max-width: 767px) {
    .calendar-nav-buttons {
      position: static;
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
      margin-top: 0.75rem;
      pointer-events: auto;
      z-index: 20;
    }

    .calendar-carousel-btn-prev,
    .calendar-carousel-btn-next {
      pointer-events: auto;
    }
  }

  /* Mobile tweaks: smaller arrow buttons and reduced vertical padding */
  @media (max-width: 767px) {
    .calendar-carousel-container {
      padding-top: 0.6rem !important;
      padding-bottom: 0.6rem !important;
    }

    .calendar-nav-buttons {
      margin-top: 0.25rem;
      gap: 0.5rem;
    }

    .calendar-carousel-btn-prev,
    .calendar-carousel-btn-next {
      width: 40px !important;
      height: 40px !important;
      min-width: 40px !important;
      min-height: 40px !important;
      padding: 0 !important;
    }

    .calendar-carousel-btn-prev svg,
    .calendar-carousel-btn-next svg {
      width: 12px;
      height: 12px;
    }
  }
</style>

<style>
  /* Banner: full-bleed on mobile (remove container gutters) and remove rounded corners */
  @media (max-width: 767px) {
    .banner-full-mobile {
      margin-left: -1rem;
