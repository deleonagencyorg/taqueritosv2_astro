---
import { type Locale, getLocale } from '../../../i18n/i18n';
import Breadcrumb from '../../../components/common/Breadcrumb/Breadcrumb.astro';
import LazyImage from '../../../components/common/LazyImage.astro';
import GamesCarousel from '../../../components/games/GamesCarousel.astro';

interface ChallengeUrl {
  title: string;
  url: string;
}

interface ChallengeItem {
  id?: string;
  slug?: string;
  title: string;
  title_down?: string;
  subtitle?: string;
  subtitle_down?: string;
  description?: string;
  image: string;
  gallery?: string[];
  preparation_time?: number;
  difficulty?: string;
  people?: string;
  address?: string;
  ingredients?: string[];
  instructions?: string[];
  ['start-date']?: string;
  ['end-date']?: string;
  url?: string;
  urls?: ChallengeUrl[];
  terminosycondiciones?: string;
}

interface Props {
  currentLang: Locale;
  challengeId: string;
}

const { currentLang, challengeId } = Astro.props;

// Importar todos los archivos de retos con glob estático y filtrar por idioma
const challengeModules = import.meta.glob<{ default: ChallengeItem }>("../../../locales/*/challenges/*.json");
const allChallenges: ChallengeItem[] = [];
for (const path in challengeModules) {
  const lang = path.split('/')[4];
  if (lang === currentLang) {
    const mod = await challengeModules[path]();
    allChallenges.push(mod.default);
  }
}

// Encontrar el reto actual
const challenge = allChallenges.find((item: ChallengeItem) => item.id === challengeId || item.slug === challengeId);

if (!challenge) {
  throw new Error(`Challenge with id or slug '${challengeId}' not found for lang ${currentLang}`);
}

const title = challenge.title;
const subtitle = challenge.subtitle_down || challenge.subtitle || '';
const durationLabel = currentLang === 'es' ? 'Duración' : 'Duration';
const difficultyLabel = currentLang === 'es' ? 'Dificultad' : 'Difficulty';
const peopleLabel = currentLang === 'es' ? 'Personas' : 'People';
const inventoryLabel = currentLang === 'es' ? 'Inventario' : 'Inventory';
const tutorialLabel = currentLang === 'es' ? 'Tutorial' : 'Tutorial';
const addressLabel = currentLang === 'es' ? 'Dirección' : 'Address';
const dateLabel = currentLang === 'es' ? 'Fecha' : 'Date';
const discoverTitle = currentLang === 'es' ? '¡Descubre y disfruta nuestros retos y torneos!' : 'Discover and enjoy our challenges and tournaments!';
const discoverText = currentLang === 'es'
  ? 'Somos jugadores, soñadores y apasionados que disfrutan competir y superar desafíos. Aquí encontrarás un espacio donde la diversión y la emoción se viven al máximo.'
  : 'We are players, dreamers and enthusiasts who love to compete and overcome challenges. Here you will find a space where fun and excitement are always at their peak.';
const discoverButton = currentLang === 'es' ? 'Descubre más retos' : 'Discover more challenges';
const gamesTitle = currentLang === 'es' ? 'Descubre la lista de juegos' : 'Discover the games list';

const preparationTime = typeof challenge.preparation_time === 'number' ? challenge.preparation_time : 0;
const difficulty = challenge.difficulty || '---';

const startDate = (challenge as any)['start-date'] as string | undefined;
const endDate = (challenge as any)['end-date'] as string | undefined;
const hasAddress = Boolean((challenge as any).address);
const hasDates = Boolean(startDate || endDate);

// Función para formatear fechas en español
function formatDateES(dateStr: string): string {
  const months = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 
                  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const date = new Date(dateStr + 'T00:00:00');
  const day = date.getDate();
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} de ${month} de ${year}`;
}

// Función para formatear fechas en inglés
function formatDateEN(dateStr: string): string {
  const months = ['January', 'February', 'March', 'April', 'May', 'June',
                  'July', 'August', 'September', 'October', 'November', 'December'];
  const date = new Date(dateStr + 'T00:00:00');
  const day = date.getDate();
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${month} ${day}, ${year}`;
}

const formattedStartDate = startDate ? (currentLang === 'es' ? formatDateES(startDate) : formatDateEN(startDate)) : '';
const formattedEndDate = endDate ? (currentLang === 'es' ? formatDateES(endDate) : formatDateEN(endDate)) : '';

interface GameItem {
  id: number;
  titulo: string;
  enlace: string;
  descripcion: string;
  imagen: string;
}

let games: GameItem[] = [];
try {
  const gamesModule = await import(`../../../locales/${currentLang}/games.json`);
  games = gamesModule.default.games || [];
} catch (e) {
  games = [];
}
---
<div style="background: linear-gradient(180deg, #1a0a0a 0%, #0d0404 100%);" class="pb-0 overflow-hidden min-h-screen">
  <div class="w-full max-w-6xl mx-auto px-4 pt-12 pb-16">
  
    <!-- Hero: imagen grande -->
    <section class="pt-8 md:pt-12 pb-6 mt-4">
      <div class="w-full overflow-hidden bg-black/50 max-h-[480px]">
        <LazyImage
          src={challenge.image}
          alt={challenge.title}
          class="w-full h-full max-h-[480px] object-cover"
          onerror="this.onerror=null;this.src='/images/recipes/placeholder.jpg';"
        />
      </div>
    </section>

    <!-- Título + descripción + datos -->
    <section class="pb-10">
      <h1 class="font-title md:text-5xl text-4xl font-bold text-white uppercase italic leading-tight mb-6">
        {title}
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-8 items-start">
        <!-- Columna izquierda: descripción -->
        <div class="text-white space-y-4">
          {subtitle && (
            <p class="text-lg text-white/80">
              {subtitle}
            </p>
          )}
          {challenge.description && (
            <p class="text-base md:text-lg text-white/80 leading-relaxed">
              {challenge.description}
            </p>
          )}

          <div class="pt-4 space-y-4">
            {challenge.urls && challenge.urls.length > 0 ? (
              <div class="flex flex-wrap gap-3">
                {challenge.urls.map((urlItem) => (
                  <a
                    href={urlItem.url}
                    class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-[#ff2d2d] to-[#ff6b6b] text-white font-bold uppercase tracking-wide text-sm hover:from-[#ff4b4e] hover:to-[#ff8080] transition-all duration-200 shadow-[0_8px_20px_rgba(0,0,0,0.6)]"
                  >
                    {urlItem.title}
                  </a>
                ))}
              </div>
            ) : challenge.url ? (
              <a
                href={challenge.url}
                class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-[#ff2d2d] to-[#ff6b6b] text-white font-bold uppercase tracking-wide text-sm hover:from-[#ff4b4e] hover:to-[#ff8080] transition-all duration-200 shadow-[0_8px_20px_rgba(0,0,0,0.6)]"
              >
                {currentLang === 'es' ? 'Ir al reto' : 'Go to challenge'}
              </a>
            ) : null}

            {challenge.terminosycondiciones && (
              <div>
                <a
                  href={challenge.terminosycondiciones}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-white/80 hover:text-white text-sm underline underline-offset-4 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  {currentLang === 'es' ? 'Términos y condiciones' : 'Terms and conditions'}
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Columna derecha: dirección, fechas, duración y dificultad -->
        {(hasAddress || hasDates) && (
          <div class="space-y-4 max-w-xs">
            {hasAddress && (
              <div class="flex flex-col items-center gap-3 border-2 border-[#ff2d2d] bg-[#1a0808] px-4 py-5 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-[#ff2d2d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c1.104 0 2-.896 2-2s-.896-2-2-2-2 .896-2 2 .896 2 2 2z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22s7-4.735 7-11a7 7 0 10-14 0c0 6.265 7 11 7 11z" />
                </svg>
                <span class="text-xs uppercase tracking-wider text-white font-bold">{addressLabel}</span>
                <p class="text-sm text-white/90">
                  {(challenge as any).address}
                </p>
              </div>
            )}

            {hasDates && (
              <div class="flex flex-col items-center gap-3 border-2 border-[#ff2d2d] bg-[#1a0808] px-4 py-5 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-[#ff2d2d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-xs uppercase tracking-wider text-white font-bold">{dateLabel}</span>
                <div class="text-sm text-white/90">
                  {formattedStartDate && formattedEndDate
                    ? (
                      <div class="space-y-1">
                        <p>{formattedStartDate}</p>
                        <p class="text-white/60 text-xs">{currentLang === 'es' ? 'al' : 'to'}</p>
                        <p>{formattedEndDate}</p>
                      </div>
                    )
                    : formattedStartDate || formattedEndDate}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- CTA de retos -->
    <section class="mb-10">
      <div class="w-full border-2 border-[#ff2d2d] bg-[#1a0808] px-6 md:px-10 py-8 flex flex-col md:flex-row items-start md:items-center gap-6 text-white">
        <div class="flex-1">
          <h2 class="font-title text-2xl md:text-3xl font-bold uppercase mb-2">
            {discoverTitle}
          </h2>
          <p class="text-sm md:text-base text-white/90">
            {discoverText}
          </p>
        </div>
        <a
          href={currentLang === 'es' ? '/es/retos-torneos' : '/en/challenges-tournaments'}
          class="inline-flex items-center justify-center px-8 py-3 bg-gradient-to-r from-[#ff2d2d] to-[#ff6b6b] text-white font-bold uppercase tracking-wide text-sm hover:from-[#ff4b4e] hover:to-[#ff8080] transition-all duration-200"
        >
          {discoverButton}
        </a>
      </div>
    </section>


    <!-- Carrusel de juegos -->
    {games.length > 0 && (
      <section class="w-full py-8">
        <div class="container mx-auto px-4">
          <GamesCarousel items={games}>
            <div slot="title" class="title">
              <p>{gamesTitle}</p>
            </div>
          </GamesCarousel>
        </div>
      </section>
    )}
  </div>
</div>

<style>
  .title {
    font-family: 'Avory I PE', sans-serif;
    font-size: 50px;
    font-weight: 800;
    letter-spacing: 2%;
    line-height: 45px;
    color: white;
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .title {
      font-size: 32px;
      line-height: 1.1;
    }
  }
</style>
