---
import Layout from '../../layouts/MainLayout.astro';
import { t } from '../../i18n/i18n';
import type { Locale } from '../../i18n/i18n';
import type { HeaderColorConfig } from '../../config/headerColors';
import Breadcrumb from '../../components/common/Breadcrumb/Breadcrumb.astro';
import { fade } from 'astro:transitions';
import VideoHero from '../../components/common/VideoHero/VideoHero.astro';
import LazyImage from '../../components/common/LazyImage.astro';
import InteractiveMap from '../../components/map/InteractiveMap.astro';

// Importar estilos separados
import './styles.css';

export interface Props {
  currentLang: Locale;
  headerColorConfig: HeaderColorConfig;
}

const { currentLang, headerColorConfig } = Astro.props;

// Get translations from common.json
const title = t('meta.about_us.title', { namespace: 'common', locale: currentLang });
const metaDescription = t('meta.about_us.description', { namespace: 'common', locale: currentLang });

// Importar contenido específico de aboutus.json
const aboutUsModule = await import(`../../locales/${currentLang}/aboutus.json`);
const aboutUsContent: any = aboutUsModule.default || aboutUsModule;
const historyTitle = aboutUsContent.title;
const historySubtitle = aboutUsContent.subtitle;
const historyIntro = aboutUsContent.intro;
const historyItems = aboutUsContent.items;
const historyConclusion = aboutUsContent.conclusion;
const aboutSectionTitle = aboutUsContent.about_section_title;
const aboutSectionParagraphs = aboutUsContent.about_section_paragraphs || [];
const presenceSectionTitle = aboutUsContent.presence_section_title;
const presenceSectionDescription = aboutUsContent.presence_section_description;
const experiencesSectionTitle = aboutUsContent.experiences_section_title;
const experiencesSectionDescription = aboutUsContent.experiences_section_description;
const experiencesCards = aboutUsContent.experiences_cards || [];

// Video and image URLs for hero section
const videoUrl = 'https://snack.yummiespromociones.com/taqueritos/Looptaqueritos.mp4';
const fallbackImageUrl = 'https://snack.yummiespromociones.com/taqueritos/loopvideo.png';
---

<Layout title={title} class="bg-brown" description={metaDescription}>
  <section class="hero-section">
    <VideoHero
      videoUrl={videoUrl}
      fallbackImageUrl={fallbackImageUrl}
      height="100%"
      overlayOpacity="0"
      textColor="text-white"
      showOverlay={false}
    />
  </section>

  <section class="bg-[#150404] py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row gap-10 md:gap-14 items-center">
      <!-- Columna texto -->
      <div class="w-full md:w-1/2 text-white">
        {aboutSectionTitle && (
          <h2 class="font-title text-3xl md:text-4xl font-extrabold uppercase mb-6">
            {aboutSectionTitle}
          </h2>
        )}
        <div class="space-y-4 text-sm md:text-base leading-relaxed text-white/90">
          {aboutSectionParagraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <!-- Columna imágenes -->
      <div class="w-full md:w-1/2 flex justify-center">
        <div class="about-cards relative w-full max-w-sm h-[260px] md:h-[320px]">
          <div class="about-card about-card-3">
            <img
              src="https://snack.yummiespromociones.com/taqueritos/taqueritos1.jpg"
              alt="Taqueritos comunidad 3"
              class="w-full h-full object-cover rounded-2xl shadow-[0_20px_40px_rgba(0,0,0,0.7)]"
            />
          </div>
          <div class="about-card about-card-2">
            <img
              src="https://snack.yummiespromociones.com/taqueritos/taqueritos2.jpg"
              alt="Taqueritos comunidad 2"
              class="w-full h-full object-cover rounded-2xl shadow-[0_20px_40px_rgba(0,0,0,0.7)]"
            />
          </div>
          <div class="about-card about-card-1">
            <img
              src="https://snack.yummiespromociones.com/taqueritos/taqueritos3.jpg"
              alt="Taqueritos comunidad 1"
              class="w-full h-full object-cover rounded-2xl shadow-[0_20px_40px_rgba(0,0,0,0.8)]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {presenceSectionTitle && (
    <section class="bg-[#150404] pb-20 pt-4 md:pt-8">
      <div class="max-w-6xl mx-auto px-4 text-center text-white">
        <h2 class="font-title text-3xl md:text-4xl font-extrabold uppercase mb-3">
          {presenceSectionTitle}
        </h2>
        {presenceSectionDescription && (
          <p class="text-sm md:text-base text-white/80 max-w-3xl mx-auto mb-8">
            {presenceSectionDescription}
          </p>
        )}
        <div class="mt-4">
          <InteractiveMap title={presenceSectionTitle} />
        </div>
      </div>
    </section>
  )}

  {experiencesSectionTitle && (
    <section class="bg-[#150404] pb-24 pt-10">
      <div class="max-w-6xl mx-auto px-4 flex flex-col lg:flex-row gap-10 lg:gap-12 items-stretch">
        <!-- Cards -->
        <div class="w-full lg:w-3/4 grid grid-cols-1 md:grid-cols-3 gap-6">
          {experiencesCards.map((card: any) => {
            let href = '#';
            if (card.id === 'products') {
               href = `/${currentLang}/#products`;
            } else if (card.id === 'challenges') {
              href = `/${currentLang}/${currentLang === 'es' ? 'retos-torneos' : 'challenges-tournaments'}`;
            } else if (card.id === 'community') {
              // Card de "Recetas" en lugar de comunidad
              href = `/${currentLang}/${currentLang === 'es' ? 'recetas' : 'recipes'}`;
            }

            const isRecipesCard = card.id === 'community';
            const recipesTitle = currentLang === 'es' ? 'Recetas gamer' : 'Gamer recipes';
            const recipesDescription = currentLang === 'es'
              ? 'Combina tus Taqueritos como un pro: recetas rápidas para subir de nivel cada snack y romper la rutina.'
              : 'Mix your Taqueritos like a pro: quick recipes to level up every snack and break the routine.';
            const recipesCta = currentLang === 'es' ? 'Ver recetas' : 'See recipes';

            return (
              <article class="experience-card flex flex-col bg-[#1c0505] border border-white/10 rounded-md overflow-hidden shadow-[0_18px_40px_rgba(0,0,0,0.7)] group">
                <div class="relative h-52 md:h-56 overflow-hidden">
                  <div class="experience-card-badge">
                    {card.id === 'products' && (
                      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 9H20L18.5 19H5.5L4 9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M9 5L8 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <path d="M15 5L16 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                      </svg>
                    )}
                    {card.id === 'challenges' && (
                      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 4H16L15 11L12 13L9 11L8 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M9 16H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                      </svg>
                    )}
                    {card.id === 'community' && (
                      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.6"/>
                        <circle cx="15" cy="9" r="2.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M5.5 18C6.2 15.8 7.9 14.5 9.9 14.5H14.1C16.1 14.5 17.8 15.8 18.5 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                      </svg>
                    )}
                  </div>
                  <LazyImage
                    src={card.id === 'products'
                      ? 'https://snack.yummiespromociones.com/taqueritos/nuestracomunidad.png'
                      : card.id === 'challenges'
                      ? 'https://snack.yummiespromociones.com/taqueritos/retosytorneos.jpg'
                      : 'https://snack.yummiespromociones.com/taqueritos/recetataqueritos.png'}
                    alt={card.title}
                    class="w-full h-full object-cover object-top transform group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="flex flex-col flex-1 px-5 py-6 text-white">
                  <h3 class="font-title text-lg md:text-xl font-extrabold uppercase mb-3 tracking-wide">
                    {isRecipesCard ? recipesTitle : card.title}
                  </h3>
                  <p class="text-sm md:text-[15px] text-white/85 leading-relaxed flex-1 mb-4">
                    {isRecipesCard ? recipesDescription : card.description}
                  </p>
                  <a
                    href={href}
                    class="inline-flex items-center text-xs md:text-sm font-semibold tracking-[0.15em] uppercase text-red group-hover:text-red transition-colors"
                  >
                    {isRecipesCard ? recipesCta : card.cta}
                    <span class="ml-2 inline-block transform group-hover:translate-x-1 transition-transform">
                      →
                    </span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Columna de texto lateral -->
        <aside class="w-full lg:w-1/4 text-white flex items-center">
          <div class="text-left lg:text-right w-full">
            <h2 class="font-title text-3xl md:text-4xl font-extrabold uppercase mb-4">
              {experiencesSectionTitle}
            </h2>
            {experiencesSectionDescription && (
              <p class="text-sm md:text-[15px] text-white/80 leading-relaxed">
                {experiencesSectionDescription}
              </p>
            )}
          </div>
        </aside>
      </div>
    </section>
  )}
</Layout>

<style>
  .hero-section {
    height: 400px;
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .hero-section {
      height: 600px;
    }
  }

  @media (min-width: 1025px) {
    .hero-section {
      height: 800px;
    }
  }

  .about-cards {
    perspective: 1200px;
  }

  .about-card {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-origin: center;
  }

  .about-card-1 {
    z-index: 30;
    animation: aboutCardIn1 650ms ease-out forwards 150ms;
  }

  .about-card-2 {
    z-index: 20;
    animation: aboutCardIn2 650ms ease-out forwards 320ms;
  }

  .about-card-3 {
    z-index: 10;
    animation: aboutCardIn3 650ms ease-out forwards 480ms;
  }

  /* Animaciones de entrada independientes para cada tarjeta */
  @keyframes aboutCardIn1 {
    0% {
      opacity: 0;
      transform: translate(40px, 40px) scale(0.9) rotateZ(4deg);
    }
    100% {
      opacity: 1;
      transform: translate(0px, 0px) scale(1) rotateZ(0deg);
    }
  }

  @keyframes aboutCardIn2 {
    0% {
      opacity: 0;
      transform: translate(70px, 60px) scale(0.9) rotateZ(2deg);
    }
    100% {
      opacity: 1;
      transform: translate(40px, 30px) scale(0.95) rotateZ(-6deg);
    }
  }

  @keyframes aboutCardIn3 {
    0% {
      opacity: 0;
      transform: translate(100px, 80px) scale(0.88) rotateZ(0deg);
    }
    100% {
      opacity: 1;
      transform: translate(80px, 52px) scale(0.9) rotateZ(-10deg);
    }
  }

  @media (max-width: 768px) {
    @keyframes aboutCardIn2 {
      0% {
        opacity: 0;
        transform: translate(40px, 40px) scale(0.9) rotateZ(2deg);
      }
      100% {
        opacity: 1;
        transform: translate(20px, 18px) scale(0.95) rotateZ(-6deg);
      }
    }

    @keyframes aboutCardIn3 {
      0% {
        opacity: 0;
        transform: translate(70px, 60px) scale(0.88) rotateZ(0deg);
      }
      100% {
        opacity: 1;
        transform: translate(32px, 30px) scale(0.9) rotateZ(-10deg);
      }
    }
  }

  /* Cards de experiencias */
  .experience-card {
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .experience-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 0 40px rgba(255, 45, 45, 0.7);
    border-color: red;
  }

  .experience-card-badge {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background-color: #ff2d2d; /* bg-primary plano */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.55);
  }
</style>
