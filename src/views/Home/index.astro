<!-- src/views/Home/index.astro -->
---
import LazyImage from '../../components/common/LazyImage.astro';
// Component Imports
import VideoCarousel from '../../components/common/VideoCarousel/index.astro';
import ChallengesCarousel from "../../components/challenges/ChallengesCarousel.astro";
import ProductsCarousel from '../../components/common/ProductsCarousel/index.astro';
import MasonryGallery from '../../components/gallery/MasonryGallery.astro';
import PixelGrid from '../../components/atoms/PixelGrid.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BrandsCarousel from '../../components/common/BrandsCarousel/index.astro';
import PlayersCarousel from '../../components/common/playersCarousel/index.astro';
import GamesCarousel from '../../components/games/GamesCarousel.astro';


// Style Imports
import './styles.css';

// i18n and Data Imports
import { t, getLocale } from '../../i18n/i18n';
import { InstagramEmbed } from 'react-social-media-embed';



// Props
export interface Props {
  loading?: boolean;
}
const { loading = false } = Astro.props;

// Language and Data Setup
const currentLang = getLocale();
const showChallengesSection = true;

interface GameItem {
  id: number;
  titulo: string;
  enlace: string;
  descripcion: string;
  imagen: string;
}

let games: GameItem[] = [];
try {
  const gamesModule = await import(`../../locales/${currentLang}/games.json`);
  games = gamesModule.default.games || [];
} catch (e) {
  games = [];
}

const gamesTitle = currentLang === 'es' ? 'Descubre la lista de juegos' : 'Discover the games list';

const homeAssets = t('home', { namespace: 'common', locale: currentLang }) || {};
const challengesAssets = t('', { namespace: 'challenges', locale: currentLang }) || {};
const galleryAssets = t('', { namespace: 'gallery', locale: currentLang }) || {};
const aboutAssets = t('', { namespace: 'aboutus', locale: currentLang }) || {};
const brandsAssets = t('', { namespace: 'brands', locale: currentLang }) || {};
const newsAssets =  t('', { namespace: 'news', locale: currentLang }) || {};
const products = t('items', { namespace: 'products', locale: currentLang }) || [];
const playersNews = t('players', { namespace: 'players', locale: currentLang }) || [];
const playersHome = t('home', { namespace: 'players', locale: currentLang }) || {};
const players = Array.isArray(playersNews) ? playersNews : [];
const brandsList = brandsAssets.brands || [];
// Where to buy: take stockist from products locales and adapt to BrandsCarousel shape
const stockistItems = t('stockist', { namespace: 'products', locale: currentLang }) || [];
const whereToBuyBrands = Array.isArray(stockistItems)
  ? stockistItems.map((s: any) => ({ id: String(s.id || ''), name: String(s.name || ''), logo: String(s.icon || ''), url: String(s.link || '') }))
  : [];
const taqueritosBrand = brandsList.find((brand: any) => brand.id === 'hugo');
const taqueritosProducts = taqueritosBrand?.products || [];

const commonAssets = t('assets.slider', { namespace: 'common', locale: currentLang }) || [];
const slides = Array.isArray(commonAssets)
  ? commonAssets
    .filter(asset => asset && typeof asset === 'object' && asset.desktop && asset.mobile)
    .map(asset => ({
      desktop: asset.desktop,
      mobile: asset.mobile,
      alt: asset.alt || "Taqueritos",
      title: asset.title || '',
      subtitle: asset.description || '',
      link: asset.url || asset.link || '',
      type: asset.type || undefined,
      color_theme: asset.color_theme || undefined,
      product_hero: asset.product_hero || undefined,
      product_left: asset.product_left || undefined,
      product_top: asset.product_top || undefined,
      product_right: asset.product_right || undefined,
      product_cta_label: asset.product_cta_label || undefined,
      product_cta_link: asset.product_cta_link || asset.link || asset.url || ''
    }))
  : [];

// Load latest blog posts by current language from markdown
const blogModules = import.meta.glob('../../locales/*/blog/*.md');
let latestBlogPosts: Array<{ id: string; slug: string; title: string; image?: string; published_date?: string; }>= [];
for (const path in blogModules) {
  const lang = path.split('/')[3];
  if (lang === currentLang) {
    const mod: any = await blogModules[path]();
    const fm = mod.frontmatter || {};
    if (fm && fm.id && fm.slug && fm.title) {
      latestBlogPosts.push({
        id: String(fm.id),
        slug: String(fm.slug),
        title: String(fm.title),
        image: fm.image ? String(fm.image) : '/images/blog/placeholder.jpg',
        published_date: fm.published_date ? String(fm.published_date) : ''
      });
    }
  }
}
function toDate(s?: string){
  if(!s) return 0; 
  if(/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(s)){ const [d,m,y]=s.split('/').map(Number); return new Date(y,(m||1)-1,d||1).getTime(); }
  const t=Date.parse(s); return isNaN(t)?0:t;
}
latestBlogPosts = latestBlogPosts.sort((a,b)=> toDate(b.published_date)-toDate(a.published_date)).slice(0,5);
const noNewsText = currentLang==='es' ? 'No se encuentra novedades aún para mostrar' : 'There are no updates to show yet';
const topNewsLabel = currentLang==='es' ? 'NOTICIAS MÁS IMPORTANTES' : 'TOP NEWS';
const featuredLabel = currentLang==='es' ? 'DESTACADOS' : 'FEATURED';

---

  <main class="w-full flex flex-col items-center justify-center mt-0">
    <!-- Slider Section con VideoCarousel -->
    <div class="relative w-full overflow-hidden">
      <VideoCarousel 
        slides={slides} 
        height="100vh" 
        mobileHeight="300px" 
        showOverlay={true} 
      />
    </div>

    {currentLang === 'es' && showChallengesSection && (
      <section id="challenges" class="w-full py-16 md:py-20 !bg-brown relative">
        <div class="container mx-auto px-4 relative">
          {challengesAssets.title && (
            <div class="title mb-12">
              <p>{challengesAssets.title}</p>
              {challengesAssets.subtitle && (
                <p>{challengesAssets.subtitle}</p>
              )}
            </div>
          )}

          {/* Calendario de torneos */}
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-title text-2xl md:text-3xl font-bold text-white uppercase m-0">
              {currentLang === 'es' ? 'CALENDARIO DE TORNEOS' : 'TOURNAMENT CALENDAR'}
            </h2>
            <div class="flex gap-3 calendar-nav-buttons">
              <button
                type="button"
                class="calendar-carousel-btn-prev w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
                aria-label="Anterior"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button
                type="button"
                class="calendar-carousel-btn-next w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
                aria-label="Siguiente"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.2002 7 15.2002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="calendar-carousel-container py-6" data-calendar-carousel>
            <div class="calendar-carousel-viewport overflow-x-hidden py-2">
              <div class="calendar-carousel-track flex transition-transform duration-300 ease-out" data-calendar-track>
                  <div class="calendar-slide flex-shrink-0 px-2 flex items-center justify-center">
                  <div class="rounded-sm overflow-hidden">
                    <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Calendario1.webp" alt="Calendario 1" class="w-full h-full object-cover" />
                  </div>
                </div>
                  <div class="calendar-slide flex-shrink-0 px-2 flex items-center justify-center">
                  <div class="rounded-sm overflow-hidden">
                    <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Calendario2.webp" alt="Calendario 2" class="w-full h-full object-cover" />
                  </div>
                </div>
                  <div class="calendar-slide flex-shrink-0 px-2 flex items-center justify-center">
                  <div class="rounded-sm overflow-hidden">
                    <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Calendario3.webp" alt="Calendario 3" class="w-full h-full object-cover" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <script>
            function initCalendarCarouselHome() {
              const containers = document.querySelectorAll('[data-calendar-carousel]');
              containers.forEach((container) => {
                if ((container as any)._calendarInit) return;
                (container as any)._calendarInit = true;
                const track = container.querySelector('[data-calendar-track]') as HTMLElement | null;
                let prevBtn = container.querySelector('.calendar-carousel-btn-prev') as HTMLButtonElement | null;
                let nextBtn = container.querySelector('.calendar-carousel-btn-next') as HTMLButtonElement | null;
                if (!prevBtn || !nextBtn) {
                  const sectionEl = container.closest('section') || container.parentElement;
                  if (sectionEl) {
                    prevBtn = sectionEl.querySelector('.calendar-carousel-btn-prev') as HTMLButtonElement | null;
                    nextBtn = sectionEl.querySelector('.calendar-carousel-btn-next') as HTMLButtonElement | null;
                  }
                }
                const slides = Array.from(container.querySelectorAll('.calendar-slide')) as HTMLElement[];
                if (!track || slides.length === 0) return;

                let currentIndex = 0;
                function getVisibleCount() {
                  const w = window.innerWidth;
                  if (w >= 1024) return 2;
                  return 1;
                }
                function getMaxIndex() {
                  const visible = getVisibleCount();
                  return Math.max(0, slides.length - visible);
                }
                function updateCarousel() {
                  const visible = getVisibleCount();
                  const slideWidth = 100 / visible;
                  slides.forEach((s) => { s.style.width = `${slideWidth}%`; });
                  const offset = currentIndex * slideWidth;
                  track.style.transform = `translateX(-${offset}%)`;
                }
                function goNext() {
                  const max = getMaxIndex();
                  if (currentIndex < max) currentIndex++; else currentIndex = 0;
                  updateCarousel();
                }
                function goPrev() {
                  const max = getMaxIndex();
                  if (currentIndex > 0) currentIndex--; else currentIndex = max;
                  updateCarousel();
                }
                if (prevBtn) prevBtn.addEventListener('click', goPrev);
                if (nextBtn) nextBtn.addEventListener('click', goNext);
                let resizeTimeout: any = null;
                window.addEventListener('resize', () => {
                  clearTimeout(resizeTimeout);
                  resizeTimeout = setTimeout(() => {
                    const max = getMaxIndex();
                    if (currentIndex > max) currentIndex = max;
                    updateCarousel();
                  }, 120);
                });
                updateCarousel();
              });
            }
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initCalendarCarouselHome);
            } else {
              initCalendarCarouselHome();
            }
            document.addEventListener('astro:page-load', initCalendarCarouselHome);
          </script>

          <style>
            .calendar-carousel-container { width: 100%; }
            .calendar-carousel-viewport { width: 100%; overflow-x: hidden; }
            .calendar-carousel-track { display:flex; will-change: transform; align-items: stretch; }
            .calendar-slide { flex-shrink:0; padding: 0 8px; box-sizing: border-box; display:flex; }
            .calendar-slide img, .calendar-slide picture, .calendar-slide .lazy-image { width:100%; height:100%; }
            @media (min-width: 768px) { .calendar-slide { padding: 0 10px; } }
            @media (max-width: 767px) {
              .calendar-nav-buttons { position: static; display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem; pointer-events: auto; z-index: 20; }
              .calendar-carousel-btn-prev, .calendar-carousel-btn-next { pointer-events: auto; }
              .calendar-carousel-container { padding-top: 0.6rem !important; padding-bottom: 0.6rem !important; }
              .calendar-nav-buttons { margin-top: 0.25rem; gap: 0.5rem; }
              .calendar-carousel-btn-prev, .calendar-carousel-btn-next { width: 40px !important; height: 40px !important; min-width: 40px !important; min-height: 40px !important; padding: 0 !important; }
              .calendar-carousel-btn-prev svg, .calendar-carousel-btn-next svg { width: 12px; height: 12px; }
            }
          </style>
        </div>
      </section>
    )}
    
    {/* Sección Carrusel de juegos*/}
    {currentLang === 'es' && games.length > 0 && (
      <section class="w-full py-8 bg-brown" id="games">
        <div class="container mx-auto px-4">
          <GamesCarousel items={games}>
            <div slot="title" class="title">
              <p>{gamesTitle}</p>
            </div>
          </GamesCarousel>
        </div>
      </section>
    )}

    <!-- Sección de Productos taqueritos -->
    {taqueritosProducts.length > 0 && (
      <section id="products" class="w-full py-4 pt-16 bg-brown">
        <div class="container mx-auto px-4 title">
          {brandsAssets.home?.title && (
          <div >
            <p >
              {brandsAssets.home?.title}
            </p>
            {brandsAssets.home?.subtitle && (
              <p >
                {brandsAssets.home?.subtitle}
              </p>
            )}
          </div>
        )}
          <ProductsCarousel 
            products={products}
            color={'white'}
            autoplay={true}
            speed={4000}
            slidesPerView={3}
            spaceBetween={30}
            loop={true}
            className="max-w-7xl mx-auto mb-8"
          />
        </div>
      </section>
    )}

    <section id="wherebuy" class="w-full">
      <BrandsCarousel 
        brands={whereToBuyBrands}
        autoplay={true}
        speed={1000}
        backgroundColor="#0a0405"
        duplicate={false}
        centered={true}
      />
    </section>

    <!-- {players.length > 0 && (
      <section id="players" class="w-full !bg-[#081806]">
        <PlayersCarousel 
          players={players} 
          playersHome={playersHome}
        />
      </section>
    )} -->
    
    <!-- Sección Gallery -->
    <section
      id="gallery"
      class="relative w-full overflow-hidden bg-dark-spotlight-blue py-8"
    >
        <div class="container mx-auto px-4 flex items-start justify-between mb-6">
          <div class="title">
            {galleryAssets.title && (
              <p>{galleryAssets.title}</p>
            )}
            {galleryAssets.subtitle && (
              <p>{galleryAssets.subtitle}</p>
            )}
          </div>
        </div>
        {Array.isArray(galleryAssets.images) && galleryAssets.images.length > 0 && (
          <MasonryGallery 
            items={galleryAssets.images}
          />
        )}
    </section>
    
  </main>

