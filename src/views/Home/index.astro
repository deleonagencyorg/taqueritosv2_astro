<!-- src/views/Home/index.astro -->
---
import LazyImage from '../../components/common/LazyImage.astro';
// Component Imports
import VideoCarousel from '../../components/common/VideoCarousel/index.astro';
import ChallengesCarousel from "../../components/challenges/ChallengesCarousel.astro";
import ProductsCarousel from '../../components/common/ProductsCarousel/index.astro';
import MasonryGallery from '../../components/gallery/MasonryGallery.astro';
import PixelGrid from '../../components/atoms/PixelGrid.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BrandsCarousel from '../../components/common/BrandsCarousel/index.astro';
import PlayersCarousel from '../../components/common/playersCarousel/index.astro';
import GamesCarousel from '../../components/games/GamesCarousel.astro';


// Style Imports
import './styles.css';

// i18n and Data Imports
import { t, getLocale } from '../../i18n/i18n';
import { InstagramEmbed } from 'react-social-media-embed';



// Props
export interface Props {
  loading?: boolean;
}
const { loading = false } = Astro.props;

// Language and Data Setup
const currentLang = getLocale();
const showChallengesSection = true;

interface GameItem {
  id: number;
  titulo: string;
  enlace: string;
  descripcion: string;
  imagen: string;
}

let games: GameItem[] = [];
try {
  const gamesModule = await import(`../../locales/${currentLang}/games.json`);
  games = gamesModule.default.games || [];
} catch (e) {
  games = [];
}

const gamesTitle = currentLang === 'es' ? 'Descubre la lista de juegos' : 'Discover the games list';

const homeAssets = t('home', { namespace: 'common', locale: currentLang }) || {};
const challengesAssets = t('', { namespace: 'challenges', locale: currentLang }) || {};
const galleryAssets = t('', { namespace: 'gallery', locale: currentLang }) || {};
const aboutAssets = t('', { namespace: 'aboutus', locale: currentLang }) || {};
const brandsAssets = t('', { namespace: 'brands', locale: currentLang }) || {};
const newsAssets =  t('', { namespace: 'news', locale: currentLang }) || {};
const products = t('items', { namespace: 'products', locale: currentLang }) || [];
const playersNews = t('players', { namespace: 'players', locale: currentLang }) || [];
const playersHome = t('home', { namespace: 'players', locale: currentLang }) || {};
const players = Array.isArray(playersNews) ? playersNews : [];
const brandsList = brandsAssets.brands || [];
// Where to buy: take stockist from products locales and adapt to BrandsCarousel shape
const stockistItems = t('stockist', { namespace: 'products', locale: currentLang }) || [];
const whereToBuyBrands = Array.isArray(stockistItems)
  ? stockistItems.map((s: any) => ({ id: String(s.id || ''), name: String(s.name || ''), logo: String(s.icon || ''), url: String(s.link || '') }))
  : [];
const taqueritosBrand = brandsList.find((brand: any) => brand.id === 'hugo');
const taqueritosProducts = taqueritosBrand?.products || [];

const commonAssets = t('assets.slider', { namespace: 'common', locale: currentLang }) || [];
const slides = Array.isArray(commonAssets)
  ? commonAssets
    .filter(asset => asset && typeof asset === 'object' && asset.desktop && asset.mobile)
    .map(asset => ({
      desktop: asset.desktop,
      mobile: asset.mobile,
      alt: asset.alt || "Taqueritos",
      title: asset.title || '',
      subtitle: asset.description || '',
      link: asset.url || asset.link || '',
      type: asset.type || undefined,
      color_theme: asset.color_theme || undefined,
      product_hero: asset.product_hero || undefined,
      product_left: asset.product_left || undefined,
      product_top: asset.product_top || undefined,
      product_right: asset.product_right || undefined,
      product_cta_label: asset.product_cta_label || undefined,
      product_cta_link: asset.product_cta_link || asset.link || asset.url || ''
    }))
  : [];

// Load latest blog posts by current language from markdown
const blogModules = import.meta.glob('../../locales/*/blog/*.md');
let latestBlogPosts: Array<{ id: string; slug: string; title: string; image?: string; published_date?: string; }>= [];
for (const path in blogModules) {
  const lang = path.split('/')[3];
  if (lang === currentLang) {
    const mod: any = await blogModules[path]();
    const fm = mod.frontmatter || {};
    if (fm && fm.id && fm.slug && fm.title) {
      latestBlogPosts.push({
        id: String(fm.id),
        slug: String(fm.slug),
        title: String(fm.title),
        image: fm.image ? String(fm.image) : '/images/blog/placeholder.jpg',
        published_date: fm.published_date ? String(fm.published_date) : ''
      });
    }
  }
}
function toDate(s?: string){
  if(!s) return 0; 
  if(/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(s)){ const [d,m,y]=s.split('/').map(Number); return new Date(y,(m||1)-1,d||1).getTime(); }
  const t=Date.parse(s); return isNaN(t)?0:t;
}
latestBlogPosts = latestBlogPosts.sort((a,b)=> toDate(b.published_date)-toDate(a.published_date)).slice(0,5);
const noNewsText = currentLang==='es' ? 'No se encuentra novedades aún para mostrar' : 'There are no updates to show yet';
const topNewsLabel = currentLang==='es' ? 'NOTICIAS MÁS IMPORTANTES' : 'TOP NEWS';
const featuredLabel = currentLang==='es' ? 'DESTACADOS' : 'FEATURED';

---

  <main class="w-full flex flex-col items-center justify-center mt-0">
    <!-- Slider Section con VideoCarousel -->
    <div class="relative w-full overflow-hidden">
      <VideoCarousel 
        slides={slides} 
        height="100vh" 
        mobileHeight="300px" 
        showOverlay={true} 
      />
    </div>

    {/* Sección Carrusel de juegos*/}
    {currentLang === 'es' && games.length > 0 && (
      <section class="w-full py-8 bg-brown" id="games">
        <div class="container mx-auto px-4">
          <GamesCarousel items={games}>
            <div slot="title" class="title">
              <p>{gamesTitle}</p>
            </div>
          </GamesCarousel>
        </div>
      </section>
    )}

    {currentLang === 'es' && showChallengesSection && (
      <section id="challenges" class="w-full py-6 md:py-12 !bg-brown relative">
        <div class="relative w-full overflow-hidden">
          <a href="https://www.challengermode.com/s/taqueritos" target="_blank" rel="noopener noreferrer" class="block w-full">
            <LazyImage
              src="https://snack.yummiespromociones.com/SnacksyummiesAssets/banner_arenas.webp"
              alt={currentLang === 'es' ? 'Calendario de Torneos - Taqueritos' : 'Tournament Calendar'}
              class="w-full h-auto object-cover"
              loading="lazy"
              style="width:100%; display:block;"
            />
          </a>
          <div class="absolute bottom-3 sm:bottom-5 md:bottom-8 lg:bottom-10 left-1/2 -translate-x-1/2 z-10">
            <a 
              href="https://www.challengermode.com/s/taqueritos" 
              target="_blank" 
              rel="noopener noreferrer"
              class="block transition-transform duration-300 hover:scale-105"
            >
              <LazyImage
                src="https://snack.yummiespromociones.com/SnacksyummiesAssets/boton_leveleate2.webp"
                alt="Leveleáte"
                class="h-8 sm:h-12 md:h-16 lg:h-20 w-auto object-contain"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Sección de Productos taqueritos -->
    {taqueritosProducts.length > 0 && (
      <section id="products" class="w-full py-4 pt-16 bg-brown">
        <div class="container mx-auto px-4 title">
          {brandsAssets.home?.title && (
          <div >
            <p >
              {brandsAssets.home?.title}
            </p>
            {brandsAssets.home?.subtitle && (
              <p >
                {brandsAssets.home?.subtitle}
              </p>
            )}
          </div>
        )}
          <ProductsCarousel 
            products={products}
            color={'white'}
            autoplay={true}
            speed={4000}
            slidesPerView={3}
            spaceBetween={30}
            loop={true}
            className="max-w-7xl mx-auto mb-8"
          />
        </div>
      </section>
    )}

    <section id="wherebuy" class="w-full">
      <BrandsCarousel 
        brands={whereToBuyBrands}
        autoplay={true}
        speed={1000}
        backgroundColor="#0a0405"
        duplicate={false}
        centered={true}
      />
    </section>

    <!-- {players.length > 0 && (
      <section id="players" class="w-full !bg-[#081806]">
        <PlayersCarousel 
          players={players} 
          playersHome={playersHome}
        />
      </section>
    )} -->
    
    <!-- Sección Gallery -->
    <section
      id="gallery"
      class="relative w-full overflow-hidden bg-dark-spotlight-blue py-8"
    >
        <div class="container mx-auto px-4 flex items-start justify-between mb-6">
          <div class="title">
            {galleryAssets.title && (
              <p>{galleryAssets.title}</p>
            )}
            {galleryAssets.subtitle && (
              <p>{galleryAssets.subtitle}</p>
            )}
          </div>
        </div>
        {Array.isArray(galleryAssets.images) && galleryAssets.images.length > 0 && (
          <MasonryGallery 
            items={galleryAssets.images}
          />
        )}
    </section>
    
  </main>

