<!-- src/views/Home/index.astro -->
---
import LazyImage from '../../components/common/LazyImage.astro';
// Component Imports
import VideoCarousel from '../../components/common/VideoCarousel/index.astro';
import ChallengesCarousel from "../../components/challenges/ChallengesCarousel.astro";
import ProductsCarousel from '../../components/common/ProductsCarousel/index.astro';
import MasonryGallery from '../../components/gallery/MasonryGallery.astro';
import PixelGrid from '../../components/atoms/PixelGrid.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BrandsCarousel from '../../components/common/BrandsCarousel/index.astro';
import PlayersCarousel from '../../components/common/playersCarousel/index.astro';
import GamesCarousel from '../../components/games/GamesCarousel.astro';


// Style Imports
import './styles.css';

// i18n and Data Imports
import { getLocale } from '../../i18n/i18n';
import { getSiteTexts, text } from '../../services/api/site-texts';
import { getAllProducts } from '../../services/api/products';
import { getGalleryImages } from '../../services/api/gallery';
import { getStockists } from '../../services/api/sections';
import { getHomePage, getPageBanners } from '../../services/api/pages';
import { InstagramEmbed } from 'react-social-media-embed';
import { getAllProducts } from '../../services/api/products';

// Props
export interface Props {
  loading?: boolean;
}
const { loading = false } = Astro.props;

// Language and Data Setup
const currentLang = getLocale();
const showChallengesSection = true;

interface GameItem {
  id: number;
  titulo: string;
  enlace: string;
  descripcion: string;
  imagen: string;
  isnew?: boolean | string;
}

let games: GameItem[] = [];
try {
  const gamesModule = await import(`../../locales/${currentLang}/games.json`);
  games = gamesModule.default.games || [];
} catch (e) {
  games = [];
}

const gamesTitle = currentLang === 'es' ? 'Descubre la lista de juegos' : 'Discover the games list';

const [siteTexts, products, galleryImages, stockists, homePage] = await Promise.all([
  getSiteTexts(currentLang),
  getAllProducts(currentLang),
  getGalleryImages(currentLang),
  getStockists(currentLang),
  getHomePage(currentLang),
]);

const galleryAssets = {
  title: text(siteTexts, 'home.gallery.title'),
  subtitle: text(siteTexts, 'home.gallery.subtitle'),
  images: galleryImages,
};
const brandsAssets = {
  home: {
    title: text(siteTexts, 'home.products.title'),
    subtitle: text(siteTexts, 'home.products.subtitle'),
  },
};
const whereToBuyBrands = stockists.map((stockist) => ({ id: stockist.id, name: stockist.name, logo: stockist.icon, url: stockist.link }));
const taqueritosProducts = products;

const slides = getPageBanners(homePage).map((banner) => ({
  desktop: banner.desktop,
  mobile: banner.mobile,
  alt: banner.alt || 'Taqueritos',
  title: banner.title,
  subtitle: banner.description || banner.subtitle,
  link: banner.link,
  type: banner.type,
  color_theme: banner.product?.colorTheme || undefined,
  product_hero: banner.product?.hero || undefined,
  product_left: banner.product?.leftText || undefined,
  product_top: banner.product?.topText || undefined,
  product_right: banner.product?.rightText || undefined,
  product_cta_label: banner.product?.buttonText || undefined,
  product_cta_link: banner.product?.buttonUrl || banner.link,
}));
const noNewsText = currentLang==='es' ? 'No se encuentra novedades aún para mostrar' : 'There are no updates to show yet';
const topNewsLabel = currentLang==='es' ? 'NOTICIAS MÁS IMPORTANTES' : 'TOP NEWS';
const featuredLabel = currentLang==='es' ? 'DESTACADOS' : 'FEATURED';

---

  <main class="w-full flex flex-col items-center justify-center mt-0">
    <!-- Slider Section con VideoCarousel -->
    <div class="relative w-full overflow-hidden">
      <VideoCarousel 
        slides={slides} 
        height="100vh" 
        mobileHeight="300px" 
        showOverlay={true} 
      />
    </div>

    {currentLang === 'es' && showChallengesSection && (
      <section id="challenges" class="w-full pt-6 md:pt-12 lg:pt-20 py-0 md:py-12 !bg-brown relative">
        <div class="relative w-full overflow-hidden">
          <div class="block w-full" role="img" aria-label={currentLang === 'es' ? 'Calendario de Torneos - Taqueritos' : 'Tournament Calendar'}>
            <LazyImage
              src="https://snack.yummiespromociones.com/SnacksyummiesAssets/banner_retos_torneos.webp"
              alt={currentLang === 'es' ? 'Calendario de Torneos - Taqueritos' : 'Tournament Calendar'}
              class="hidden md:block w-full h-auto object-cover"
              loading="lazy"
              style="width:100%;"
            />
            <LazyImage
              src="https://snack.yummiespromociones.com/SnacksyummiesAssets/banner_retos_mobile.webp"
              alt={currentLang === 'es' ? 'Calendario de Torneos - Taqueritos' : 'Tournament Calendar'}
              class="block md:hidden w-full h-auto aspect-square object-cover"
              loading="lazy"
              style="width:100%;"
            />
          </div>
          <div class="absolute bottom-3 sm:bottom-5 md:bottom-8 lg:bottom-10 left-1/2 -translate-x-1/2 z-10">
            <a 
              href="https://www.challengermode.com/s/taqueritos" 
              target="_blank" 
              rel="noopener noreferrer"
              class="block transition-transform duration-300 hover:scale-105"
            >
              <LazyImage
                src="https://snack.yummiespromociones.com/SnacksyummiesAssets/boton_leveleate2.webp"
                alt="Leveleáte"
                class="h-8 sm:h-12 md:h-16 lg:h-20 w-auto object-contain"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </section>
    )}

    {/* Sección Carrusel de juegos*/}
    {currentLang === 'es' && games.length > 0 && (
      <section class="w-full py-8 bg-brown" id="games">
        <div class="container mx-auto px-4">
          <GamesCarousel items={games}>
            <div slot="title" class="title">
              <p>{gamesTitle}</p>
            </div>
          </GamesCarousel>
        </div>
      </section>
    )}

    <!-- Sección de Productos taqueritos -->
    {products.length > 0 && (
      <section id="products" class="w-full py-4 pt-16 bg-brown">
        <div class="container mx-auto px-4 title">
          {brandsAssets.home?.title && (
          <div >
            <p >
              {brandsAssets.home?.title}
            </p>
            {brandsAssets.home?.subtitle && (
              <p >
                {brandsAssets.home?.subtitle}
              </p>
            )}
          </div>
        )}
          <ProductsCarousel 
            products={products}
            color={'white'}
            autoplay={true}
            speed={4000}
            slidesPerView={3}
            spaceBetween={30}
            loop={true}
            className="max-w-7xl mx-auto mb-8"
          />
        </div>
      </section>
    )}

    <section id="wherebuy" class="w-full">
      <BrandsCarousel 
        brands={whereToBuyBrands}
        autoplay={true}
        speed={1000}
        backgroundColor="#0a0405"
        duplicate={false}
        centered={true}
      />
    </section>

    <!-- {players.length > 0 && (
      <section id="players" class="w-full !bg-[#081806]">
        <PlayersCarousel 
          players={players} 
          playersHome={playersHome}
        />
      </section>
    )} -->
    
    <!-- Sección Gallery -->
    <section
      id="gallery"
      class="relative w-full overflow-hidden bg-dark-spotlight-blue py-8"
    >
        <div class="container mx-auto px-4 flex items-start justify-between mb-6">
          <div class="title">
            {galleryAssets.title && (
              <p>{galleryAssets.title}</p>
            )}
            {galleryAssets.subtitle && (
              <p>{galleryAssets.subtitle}</p>
            )}
          </div>
        </div>
        {Array.isArray(galleryAssets.images) && galleryAssets.images.length > 0 && (
          <MasonryGallery 
            items={galleryAssets.images}
          />
        )}
    </section>
    
  </main>

