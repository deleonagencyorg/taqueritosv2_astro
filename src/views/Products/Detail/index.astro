---
// src/views/Products/Detail/index.astro
import ChallengesCarousel from '../../../components/challenges/ChallengesCarousel.astro';
import { t } from '../../../i18n/i18n';
import type { Locale } from '../../../i18n/i18n';
import './styles.css';

// client-side helpers
import './scripts.js';

// Interfaces locales
interface ProductSize {
  value: string;
  image: string;
}

interface Stockist {
  id: string;
  name: string;
  icon: string;
  link: string;
}

interface NutritionInfo {
  description?: string;
  servingSize?: string;
  servingsPerContainer?: string;
  calories?: string;
  fatEnergy?: string;
  totalFat?: string;
  saturatedFat?: string;
  transFat?: string;
  cholesterol?: string;
  sodium?: string;
  totalCarbs?: string;
  dietaryFiber?: string;
  sugars?: string;
  protein?: string;
  calorieDiet?: string;
  caloriesPerServing?: string;
  vitaminD?: string;
  iron?: string;
  calcium?: string;
  potassium?: string;
}

interface Product {
  id: string;
  name: string;
  name_description: string;
  image: string;
  available?: string;
  background_image: string;
  background_color: string;
  text_color: string;
  header_text_color: string;
  color_button: string;
  sizes: ProductSize[];
  description?: string;
  short_description?: string;
  presentaciones?: Array<{
    value: string;
    icono: string;
  }>;
  relatedProducts?: string[];
  weight?: string[];
  nutrition?: NutritionInfo;
} 

const { currentLang, productId } = Astro.props;

// Obtener datos desde traducciones
const productsAssets = t('home', { namespace: 'products', locale: currentLang }) || {};
const products = t('items', { namespace: 'products', locale: currentLang as Locale }) || [];
const stockists = t('stockist', { namespace: 'products', locale: currentLang as Locale }) || [];
const product = products.find((item: Product) => item.id === productId);
const brandsAssets = t('', { namespace: 'brands', locale: currentLang }) || {};
const newsAssets =  t('', { namespace: 'news', locale: currentLang }) || {};
const brandsList = brandsAssets.brands || [];
const zibasBrand = brandsList.find((brand: any) => brand.id === 'zibas');
const taqueritosProducts = (zibasBrand?.products || []).filter((product: any) => product.id !== productId);
const challengesAssets = t('', { namespace: 'challenges', locale: currentLang }) || {};

// Si el producto no existe, lanzar error
if (!product || Object.keys(product).length === 0) {
  throw new Error(t('errors.product_not_found', { locale: currentLang }));
}

// Asegurar que todas las propiedades necesarias existan
const safeProduct: Product = {
  id: product.id || '',
  name: product.name || '',
  text_color: product.text_color || '#FFFFFF',
  name_description: product.name_description || product.name || '',
  image: product.image || '',
  background_image: product.background_color || '',
  background_color: product.background_color || '#150404',
  header_text_color: product.header_text_color || '#FFFFFF',
  color_button: product.color_button || '#520406',
  sizes: Array.isArray(product.sizes) ? product.sizes : [],
  available: product.available || '',
  description: product.description || (product.nutrition?.description) || '',
  weight: Array.isArray(product.weight) ? product.weight : [],
  nutrition: (product.nutrition || {}) as NutritionInfo,
};

// Obtener todos los productos como un array
const productsData = t('items', { locale: currentLang, namespace: 'products' }) || [];
const allProductsArray = Array.isArray(productsData) ? productsData : [];

// Filtrar productos relacionados
let relatedProducts: any[] = [];
if (allProductsArray.length > 1) {
  relatedProducts = allProductsArray.filter((p: any) => p.id !== productId);
}

const carouselProducts = [safeProduct, ...relatedProducts];

// Localized labels for collapsible sections
const sectionLabels = {
  description: currentLang === 'es' ? 'Descripción' : 'Description',
  nutrition: currentLang === 'es' ? 'Datos nutricionales' : 'Nutrition Facts',
};

// Labels for each nutrition field - Only fields that should be displayed
const nutritionLabels: Record<string, string> = {
  servingSize: currentLang === 'es' ? 'Tamaño de ración' : 'Serving Size',
  servingsPerContainer: currentLang === 'es' ? 'Raciones por envase' : 'Servings per container',
  calories: currentLang === 'es' ? 'Kcal de energía' : 'Calories',
  fatEnergy: currentLang === 'es' ? 'Energía de grasa' : 'Fat energy',
  totalFat: currentLang === 'es' ? 'Grasa total' : 'Total fat',
  saturatedFat: currentLang === 'es' ? 'Grasa saturada' : 'Saturated fat',
  transFat: currentLang === 'es' ? 'Grasa trans' : 'Trans fat',
  cholesterol: currentLang === 'es' ? 'Colesterol' : 'Cholesterol',
  sodium: currentLang === 'es' ? 'Sodio' : 'Sodium',
  totalCarbs: currentLang === 'es' ? 'Carbohidrato total' : 'Total carbohydrate',
  dietaryFiber: currentLang === 'es' ? 'Fibra dietética' : 'Dietary fiber',
  sugars: currentLang === 'es' ? 'Contiene menos de g de azúcar' : 'Contains less than g sugar',
  protein: currentLang === 'es' ? 'Proteínas' : 'Protein',
  calorieDiet: currentLang === 'es' ? 'Dieta de calorías' : 'Calorie diet',
  caloriesPerServing: currentLang === 'es' ? 'Una porción aporta g calorías' : 'One serving provides g calories',
  vitaminD: currentLang === 'es' ? 'Vitamina D' : 'Vitamin D',
  iron: currentLang === 'es' ? 'Hierro' : 'Iron',
  calcium: currentLang === 'es' ? 'Calcio' : 'Calcium',
  potassium: currentLang === 'es' ? 'Potasio' : 'Potassium',
};

const nutritionEntries = Object.entries(nutritionLabels)
  .filter(([key]) => safeProduct.nutrition && key in safeProduct.nutrition)
  .filter(([key]) => (safeProduct.nutrition as any)[key] !== '' && (safeProduct.nutrition as any)[key] !== null) as [string, string][];
---
<div>
  {safeProduct.background_color && (
    <article
      id="product-detail"
      class="product-detail relative overflow-hidden"
      style={{ backgroundColor: safeProduct.background_color || '#150404' }}
      transition:animate="slide"
    >
      <!-- Cambiar a grid en lugar de flex -->
      <div class="container mx-auto px-6 py-6 md:py-8 grid grid-cols-1 lg:grid-cols-2 gap-10 relative z-10">
        <!-- Contenido del lado izquierdo -->
        <div class="flex flex-col gap-12 relative z-20 lg:mt-[100px] mt-[100px]">
          <!-- Título principal -->
          <h1 
              id="product-title"
              class="text-[40px] md:text-[90px] font-black uppercase  md:leading-[110px]"
              style={{ color: safeProduct.text_color }}
            >
              {safeProduct.name}
          </h1>
    
          <div class="flex flex-col gap-12 max-w-[488px]">
            <!-- Description section (always visible) -->
            <div class="mt-0 md:mt-4">
              <h2 class="text-2xl font-semibold text-white mb-1 md:mb-2">{sectionLabels.description}</h2>
              <div id="product-description" class="text-2xl md:text-[26.6px] font-normal text-white text-justify">
                {safeProduct.description || ''}
              </div>
            </div>


            <!-- Botones de presentaciones -->
              <div id="product-weights" class="flex gap-1 mt-0 md:mt-8" style={(!safeProduct.weight || safeProduct.weight.length === 0) ? 'display:none' : ''}>
                {safeProduct.weight && safeProduct.weight.map((weight) => (
                  <button 
                    class="flex-1 md:h-[78px] h-[40px] rounded-[30px] border-[1.16px] border-[#4A4A4A] transition-all duration-300 cursor-default"
                    style={{
                      backgroundColor: 'transparent',
                      color: '#FFFFFF'
                    }}
                    type="button"
                  >
                    <span class="md:text-[30px] text-[18px] font-semibold">{weight}</span>
                  </button>
                ))}
              </div>
    
            <!-- Botón de comprar y navegación -->
            <div class="flex items-center gap-5 pb-20 md:pb-0">
              <button 
                id="open-modal-btn"
                class="w-full flex justify-center items-center border border-[#FF0048] rounded-[16px] bg-gradient-to-b from-[#FF0048] to-[#FF5255] shadow-[0_3px_0_0_rgba(88,0,29,0.9)] hover:shadow-[0_1px_0_0_rgba(88,0,29,0.9)] hover:translate-y-[2px] transition-all duration-150 text-white py-[10px] md:py-[16px] lg:py-[16px]"
                data-product-id={safeProduct.id}
              >
                <span class="text-[18px] md:text-[26.6px] lg:text-[26.6px] font-semibold">
                  {currentLang === 'es' ? '¿Donde comprar?' : 'Find it on Amazon'}
                </span>
              </button>
    
              <!-- Controles de navegación -->
              <div class="flex gap-5">
                <div class="carousel-navigation">
                  <button class="swiper-button-prev">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button class="swiper-button-next">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.0002 7 15.0002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <!-- Nutrition facts - collapsible for desktop only -->
            <div class="collapsible hidden md:block mb-24 lg:mb-24">
              <div class="collapsible-header flex justify-between items-center cursor-pointer w-full">
                <h2 class="text-2xl font-semibold text-white">{sectionLabels.nutrition}</h2>
                <span class="toggle-icon">+</span>
              </div>
              <div class="collapsible-content hidden mt-4">
                {safeProduct.nutrition && (
                  <div class="nutrition-table grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-white text-sm md:text-base font-normal">
                    {nutritionEntries.map(([key,label]) => (
                      <div class="flex justify-between items-center">
                        <span class="font-semibold">{label}</span>
                        <span class="text-right ml-4">{(safeProduct.nutrition as any)[key] || '-'}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
    
        <!-- Carousel de productos - SOLO lado derecho -->
        <div class="relative flex items-center justify-center overflow-visible lg:mt-[100px]">
          {relatedProducts.length > 0 && (
            <div class="swiper products-swiper w-full h-full">
              <div class="swiper-wrapper">
                <!-- Producto actual primero -->
                <div class="swiper-slide">
                  <div class="relative w-[300px] md:w-[600px] lg:w-[500px] h-[300px] md:h-[600px]">
                    <div class="absolute top-10 right-0 w-[80%] h-auto">
                      <img 
                        class="product-float w-[300px] md:w-[600px] lg:w-[500px] h-auto rotate-[18deg] transition-transform duration-500 hover:scale-105"
                        src={safeProduct.image} 
                        alt={safeProduct.name}
                        transition:name={`product-image-${safeProduct.id}`}
                      />
                    </div>
                  </div>
                </div>
                
                <!-- Productos relacionados -->
                {relatedProducts.map((relatedProduct: Product) => (
                  <div class="swiper-slide">
                    <div class="relative w-[300px] md:w-[600px] lg:w-[500px] h-[400px] md:h-[800px]">
                      <div class="absolute top-10 right-0 w-[80%] h-auto">
                        <img 
                          class="product-float w-[300px] md:w-[600px] lg:w-[500px] h-auto rotate-[18deg] transition-transform duration-500 hover:scale-105 cursor-pointer"
                          src={relatedProduct.image} 
                          alt={relatedProduct.name}
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>



      <!-- Nutrition facts for mobile: appears below carousel -->
      <div class="collapsible md:hidden w-full px-6 mb-24 mt-8">
        <div class="collapsible-header flex justify-between items-center cursor-pointer w-full">
          <h2 class="text-2xl font-semibold text-white">{sectionLabels.nutrition}</h2>
          <span class="toggle-icon">+</span>
        </div>
        <div class="collapsible-content hidden mt-4">
          {safeProduct.nutrition && (
            <div class="nutrition-table grid grid-cols-1 gap-x-6 gap-y-2 text-white text-sm md:text-base font-normal">
              {nutritionEntries.map(([key,label]) => (
                <div class="flex justify-between items-center">
                  <span class="font-semibold">{label}</span>
                  <span class="text-right ml-4">{(safeProduct.nutrition as any)[key] || '-'}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </article>
    )}

    <!-- collapsible functionality script -->
    <script>
      function initCollapsibles() {
        console.log('initCollapsibles triggered');
        document.querySelectorAll('.collapsible-header').forEach(header => {
          // avoid attaching twice
          if (header.dataset.collapsibleInit) return;
          header.dataset.collapsibleInit = 'true';
          header.style.cursor = 'pointer';
          header.addEventListener('click', () => {
            const content = header.nextElementSibling;
            const icon = header.querySelector('.toggle-icon');
            if (!content) return;
            if (content.classList.contains('hidden')) {
              content.classList.remove('hidden');
              if (icon) icon.textContent = '-';
            } else {
              content.classList.add('hidden');
              if (icon) icon.textContent = '+';
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initCollapsibles);
      document.addEventListener('astro:page-load', initCollapsibles);
      document.addEventListener('astro:after-swap', initCollapsibles);
    </script>
    
    {currentLang === 'es' && (
      <section id="challenges" class="w-full py-6 md:py-8 bg-brown relative -mt-12 md:-mt-16 lg:-mt-20" transition:animate="slide">
        <div class="container mx-auto px-4 relative">
          <div class="container mx-auto px-4 mb-12">
            <p class="text-white font-title text-4xl md:text-5xl lg:text-6xl font-bold uppercase">
              PARTICIPA
            </p>
            <p class="text-white font-title text-4xl md:text-5xl lg:text-6xl font-bold uppercase">
              EN NUESTROS RETOS
            </p>
          </div>
          <ChallengesCarousel 
            title="PARTICIPA"
            subtitle="EN NUESTROS RETOS"
            textButton={challengesAssets.home?.view_more || 'Ver Todos'}
          />
        </div>
      </section>
    )}
</div>


<style>
  .product-detail {
    position: relative;
    background: radial-gradient(ellipse at center, #1a0708 0%, #230405 50%, #0e0202 100%);
    overflow: hidden;
  }
  
  .product-detail::before,
  .product-detail::after {
    content: "";
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50vw;
    height: 38vw;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255,30,40,0.5) 0%, rgba(140,0,0,0) 70%);
    filter: blur(60px);
    z-index: 1;
  }
  
  .product-detail::before { 
    left: -30vw; 
  }
  
  .product-detail::after { 
    right: -30vw; 
  }
  
  /* Estilos del Swiper */
  .products-swiper {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .swiper-wrapper {
    display: flex;
    align-items: center;
  }

  .swiper-slide {
    width: 100%;
    flex-shrink: 0;
    opacity: 0; /* ✅ AGREGAR: Ocultar slides inactivos */
    transition: opacity 0.3s ease;
  }

  .swiper-slide-active {
    opacity: 1; /* ✅ AGREGAR: Mostrar solo el slide activo */
  }
  
  .carousel-navigation {
    right: 0;
    display: flex;
    gap: 12px;
  }

  /* Ocultar las flechas predeterminadas */
  .swiper-button-next::after,
  .swiper-button-prev::after {
    content: '' !important;
    display: none;
  }

  /* Botones cuadrados */
  .swiper-button-next,
  .swiper-button-prev {
    position: relative !important;
    width: 65px !important;
    height: 65px !important;
    margin: 0 !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;
    background: #FF2D3029 !important;
    border: 1px solid #ff2c2f !important;
    border-radius: 10px !important;
    backdrop-filter: blur(10px) !important;
    transition: all 0.3s ease !important;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .swiper-button-next svg,
  .swiper-button-prev svg {
    width: 26px !important;
    height: 26px !important;
  }

  .swiper-button-next:hover,
  .swiper-button-prev:hover {
    background: #150404 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 12px rgba(255, 68, 0, 0.4) !important;
  }

  .swiper-button-next:active,
  .swiper-button-prev:active {
    transform: translateY(0) !important;
  }

  .swiper-button-disabled {
    opacity: 0.4 !important;
    cursor: not-allowed !important;
  }

  @keyframes product-float {
    0% { translate: 0 0; }
    50% { translate: 0 -10px; }
    100% { translate: 0 0; }
  }

  .product-float {
    animation: product-float 3.5s ease-in-out infinite;
    will-change: transform;
  }

  /* collapsible styles */
  .collapsible-header {
    width: 100%;
    padding: 0.5rem 0;
  }
  .collapsible-header h2 {
    color: white;
  }
  .collapsible-header .toggle-icon {
    color: white;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .collapsible-content {
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .collapsible-header h2 {
      font-size: 1.25rem;
    }
    .collapsible-content table td {
      display: block;
      width: 100%;
    }
  }

  /* table row separator */
  .collapsible-content table tr {
    border-bottom: 1px solid rgba(255,255,255,0.2);
  }
  .collapsible-content table td {
    padding: 4px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-float {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .swiper-button-next,
    .swiper-button-prev {
      width: 50px !important;
      height: 50px !important;
    }

    .button-buy {
      width: 100% !important;
      height: 70px !important;
    }
  }
</style>

<script is:inline define:vars={{ carouselProducts }}>
  window.carouselProductsData = carouselProducts;
</script>

<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  let swiperInstance: Swiper | null = null;

  function initializeSwiper() {
    const swiperContainer = document.querySelector('.products-swiper');
    
    if (!swiperContainer) {
      return;
    }

    // Destruir instancia previa si existe
    if (swiperInstance && !swiperInstance.destroyed) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }

    // Obtener datos de productos
    const productsData = (window as any).carouselProductsData || [];

    // Función para actualizar el contenido
    function updateProductContent(index: number) {
      const product = productsData[index];
      if (!product) return;

      // Actualizar título usando siempre el campo "name"
      const titleEl = document.getElementById('product-title');
      if (titleEl) {
        titleEl.textContent = product.name || '';
        titleEl.style.color = product.text_color || '#FFFFFF';
      }

      // Actualizar descripción
      const descEl = document.getElementById('product-description');
      if (descEl) {
        // Usar description principal, o description de nutrition si está vacío
        const description = product.description || product.nutrition?.description || '';
        descEl.textContent = description;
        descEl.style.color = product.text_color || '#FFFFFF';
      }

      // Actualizar weights
      const weightsEl = document.getElementById('product-weights');
      if (weightsEl) {
        const weights: string[] = Array.isArray(product.weight) ? product.weight : [];
        if (weights.length > 0) {
          weightsEl.style.display = 'flex';
          weightsEl.innerHTML = weights.map((w: string) =>
            `<button class="flex-1 md:h-[78px] h-[40px] rounded-[30px] border-[1.16px] border-[#4A4A4A] transition-all duration-300 cursor-default" style="background-color:transparent;color:#FFFFFF" type="button"><span class="md:text-[30px] text-[18px] font-semibold">${w}</span></button>`
          ).join('');
        } else {
          weightsEl.style.display = 'none';
        }
      }

      // Actualizar tabla de nutrición
      const nutritionTableEl = document.querySelector('.nutrition-table');
      if (nutritionTableEl && product.nutrition) {
        const nutrition = product.nutrition;
        
        // Determinar idioma para las etiquetas
        const isSpanish = window.location.pathname.startsWith('/es');
        
        // Definir las etiquetas de nutrición
        const nutritionLabelsMap: Record<string, string> = {
          servingSize: isSpanish ? 'Tamaño de ración' : 'Serving Size',
          servingsPerContainer: isSpanish ? 'Raciones por envase' : 'Servings per container',
          calories: isSpanish ? 'Kcal de energía' : 'Calories',
          fatEnergy: isSpanish ? 'Energía de grasa' : 'Fat energy',
          totalFat: isSpanish ? 'Grasa total' : 'Total fat',
          saturatedFat: isSpanish ? 'Grasa saturada' : 'Saturated fat',
          transFat: isSpanish ? 'Grasa trans' : 'Trans fat',
          cholesterol: isSpanish ? 'Colesterol' : 'Cholesterol',
          sodium: isSpanish ? 'Sodio' : 'Sodium',
          totalCarbs: isSpanish ? 'Carbohidrato total' : 'Total carbohydrate',
          dietaryFiber: isSpanish ? 'Fibra dietética' : 'Dietary fiber',
          sugars: isSpanish ? 'Contiene menos de g de azúcar' : 'Contains less than g sugar',
          protein: isSpanish ? 'Proteínas' : 'Protein',
          calorieDiet: isSpanish ? 'Dieta de calorías' : 'Calorie diet',
          caloriesPerServing: isSpanish ? 'Una porción aporta g calorías' : 'One serving provides g calories',
          vitaminD: isSpanish ? 'Vitamina D' : 'Vitamin D',
          iron: isSpanish ? 'Hierro' : 'Iron',
          calcium: isSpanish ? 'Calcio' : 'Calcium',
          potassium: isSpanish ? 'Potasio' : 'Potassium'
        };

        // Filtrar entradas que existen y no están vacías
        const nutritionEntries = Object.entries(nutritionLabelsMap)
          .filter(([key]) => nutrition && key in nutrition)
          .filter(([key]) => nutrition[key] !== '' && nutrition[key] !== null);

        // Generar HTML de la tabla
        const nutritionHtml = nutritionEntries.map(([key, label]) => 
          `<div class="flex justify-between items-center">
            <span class="font-semibold">${label}</span>
            <span class="text-right ml-4">${nutrition[key] || '-'}</span>
          </div>`
        ).join('');

        nutritionTableEl.innerHTML = nutritionHtml;
      }

      // Actualizar data-product-id del botón del modal
      const modalBtn = document.getElementById('open-modal-btn');
      if (modalBtn) {
        modalBtn.setAttribute('data-product-id', product.id || '');
      }
    }

    // Inicializar Swiper
    swiperInstance = new Swiper('.products-swiper', {
      modules: [Navigation],
      slidesPerView: 1,
      spaceBetween: 0,
      loop: true,
      speed: 800,
      centeredSlides: true,
      allowTouchMove: false,
      simulateTouch: false,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      breakpoints: {
        640: {
          slidesPerView: 1,
        },
        768: {
          slidesPerView: 1,
        },
        1024: {
          slidesPerView: 1,
        },
      },
      on: {
        init: function (swiper) {
          updateProductContent(swiper.realIndex);
        },
        slideChange: function (swiper) {
          updateProductContent(swiper.realIndex);
        }
      }
    });
  }

  function cleanupSwiper() {
    if (swiperInstance && !swiperInstance.destroyed) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  }

  // Inicializar en carga inicial
  document.addEventListener('DOMContentLoaded', initializeSwiper);
  
  // Inicializar en navegación con View Transitions
  document.addEventListener('astro:page-load', initializeSwiper);
  document.addEventListener('astro:after-swap', initializeSwiper);
  
  // Limpiar antes de cambiar de página
  document.addEventListener('astro:before-swap', cleanupSwiper);
  document.addEventListener('astro:before-preparation', cleanupSwiper);
</script>

