---
import { t, getLocale } from '../../i18n/i18n';
import ProductsCarousel from '../../components/common/ProductsCarousel/index.astro';
import { getAllProducts } from '../../services/api/products';

const currentLang = getLocale();
const cmsProducts = await getAllProducts(currentLang);
const localProducts = t('items', { namespace: 'products', locale: currentLang }) || [];
const products = cmsProducts.length > 0 ? cmsProducts : localProducts;
const homeAssets = t('home', { namespace: 'products', locale: currentLang }) || {};
---

<section class="w-full min-h-screen bg-brown py-16">
  <div class="container mx-auto px-4">
    <div class="title mb-4 text-center mt-16">
      {homeAssets.title && <p>{homeAssets.title}</p>}
      {homeAssets.subtitle && <p>{homeAssets.subtitle}</p>}
    </div>

    <ProductsCarousel
      products={products}
      color="white"
      autoplay={true}
      speed={4000}
      slidesPerView={3}
      spaceBetween={30}
      loop={true}
      className="max-w-7xl mx-auto mb-8"
    />
  </div>
</section>

