---
import { getLocale } from '../../i18n/i18n';
import { getAllProducts } from '../../services/api/products';
import { getSiteTexts, text } from '../../services/api/site-texts';
import ProductsCarousel from '../../components/common/ProductsCarousel/index.astro';
import { getAllProducts } from '../../services/api/products';

const currentLang = getLocale();
const [products, siteTexts] = await Promise.all([getAllProducts(currentLang), getSiteTexts(currentLang)]);
const homeAssets = {
  title: text(siteTexts, 'home.products.title'),
  subtitle: text(siteTexts, 'home.products.subtitle'),
};
---

<section class="w-full min-h-screen bg-brown py-16">
  <div class="container mx-auto px-4">
    <div class="title mb-4 text-center mt-16">
      {homeAssets.title && <p>{homeAssets.title}</p>}
      {homeAssets.subtitle && <p>{homeAssets.subtitle}</p>}
    </div>

    <ProductsCarousel
      products={products}
      color="white"
      autoplay={true}
      speed={4000}
      slidesPerView={3}
      spaceBetween={30}
      loop={true}
      className="max-w-7xl mx-auto mb-8"
    />
  </div>
</section>

