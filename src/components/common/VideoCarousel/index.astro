---
import { Image } from 'astro:assets';
import { getLocale } from '../../../i18n/i18n';
import LazyImage from '../LazyImage.astro';

interface SlideItem {
  desktop: string;
  mobile: string;
  alt: string;
  title?: string;
  subtitle?: string;
  description?: string;
  link?: string;
  type?: 'product' | 'image' | 'video';

  // Campos opcionales para slides de producto, leídos desde el JSON
  color_theme?: string;
  product_hero?: string;
  product_left?: string;
  product_top?: string;
  product_right?: string;
  product_cta_label?: string;
  product_cta_link?: string;
}

interface Props {
  slides: SlideItem[];
  height?: string;
  mobileHeight?: string;
  overlayOpacity?: string;
  textColor?: string;
  showOverlay?: boolean;
}

const {
  slides = [],
  height = "100vh",
  mobileHeight = "300px",
  overlayOpacity = "50",
  textColor = "text-white",
  showOverlay = true
} = Astro.props;

const currentLang = getLocale();

// Identificar el primer slide para precargar
const firstSlide = slides[0] || {};
const isFirstSlideVideo = firstSlide.desktop?.toLowerCase().endsWith('.mp4') || 
                         firstSlide.desktop?.toLowerCase().endsWith('.webm');
---

{slides.length === 0 ? (
  <div class="w-full h-[60vh] flex items-center justify-center bg-brown text-white text-2xl font-bold">
    No hay contenido disponible
  </div>
) : (
  <div class="video-carousel-container relative overflow-hidden">
    <div class="swiper-container video-carousel">
      <div class="swiper-wrapper">
        {slides.map((slide, index) => {
          const hasVideoExtension =
            slide.desktop?.toLowerCase().endsWith('.mp4') ||
            slide.desktop?.toLowerCase().endsWith('.webm');
        
          const slideType = slide.type || (hasVideoExtension ? 'video' : 'product');
          const isVideo = slideType === 'video';
          const isProduct = slideType === 'product';
          const isSimpleImage = slideType === 'image';
          const slideId = `slide-${index}`;
          const dataTheme = slide.color_theme || 'red';
          const dataSize = (slide.product_hero || '').toLowerCase().includes('dragon') ? 'purple' : undefined;

        return (
          <div class="swiper-slide" id={slideId} data-slide-type={slideType}>
            {isVideo || isSimpleImage ? (
              /* ========== SLIDES DE IMAGEN/VIDEO (FULLSCREEN) ========== */
              <div class="media-slide-wrapper">
                {isVideo ? (
                  <div class="media-container">
                    <video
                      autoplay
                      muted
                      loop
                      playsinline
                      class="media-element"
                      data-slide-id={slideId}
                      preload={index === 0 ? "auto" : "metadata"}
                    >
                      <source src={slide.desktop} type={slide.desktop.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4'}>
                    </video>
                  </div>
                ) : (
                  <div class="media-container">
                    {slide.link ? (
                      <a href={slide.link} class="media-link" aria-label={slide.alt || "Slide link"}>
                        <LazyImage
                          src={slide.desktop}
                          alt={slide.alt || "Slide background"}
                          class="media-element media-desktop"
                          loading={index === 0 ? "eager" : "lazy"}
                        />
                        <LazyImage
                          src={slide.mobile}
                          alt={slide.alt || "Slide background"}
                          class="media-element media-mobile"
                          loading={index === 0 ? "eager" : "lazy"}
                        />
                      </a>
                    ) : (
                      <>
                        <LazyImage
                          src={slide.desktop}
                          alt={slide.alt || "Slide background"}
                          class="media-element media-desktop"
                          loading={index === 0 ? "eager" : "lazy"}
                        />
                        <LazyImage
                          src={slide.mobile}
                          alt={slide.alt || "Slide background"}
                          class="media-element media-mobile"
                          loading={index === 0 ? "eager" : "lazy"}
                        />
                      </>
                    )}
                  </div>
                )}
              </div>
            ) : (
              /* ========== SLIDE DE PRODUCTO ========== */
              <div class="product-slide-wrapper" data-theme={dataTheme} data-size={dataSize}>
                <div class="slide-content" style={`height: ${height};`}>
                  <div class="image-container relative w-full h-[680px] md:w-full md:h-full flex md:items-center md:justify-center">
                  <!-- Imagen principal (desktop) -->
                  <LazyImage
                    src={slide.desktop}
                    alt={slide.alt || "Taqueritos Fuego"}
                    class="slide-image desktop-image h-auto z-10 bg-transparent w-[1200px]"
                    loading={index === 0 ? "eager" : "lazy"}
                  />

                  <LazyImage
                    src={slide.mobile}
                    alt={slide.alt || "Taqueritos Fuego"}
                    class="slide-image mobile-image h-auto z-10 bg-transparent w-[1200px]"
                    loading={index === 0 ? "eager" : "lazy"}
                  />

                  <h1 class="dragon-text font-bold uppercase leading-[90%] tracking-[0] select-none">
                    {slide.product_hero || (currentLang === 'es' ? 'DRAGON FUEGO' : 'DRAGON FIRE')}
                  </h1>
                 
                </div>

                <!-- Bloque de texto lateral izquierdo -->
              <div class="left-text mt-18">
                {slide.product_left ? (
                  <p>
                    {slide.product_left.split('\n').map((line: string, i: number) =>
                      i === 0 ? <>{line}<br/></> : <span> <b>{line}</b></span>
                    )}
                  </p>
                ) : (
                  <p>
                    {currentLang === 'es' ? 'Sabor intenso,' : 'Intense flavor,'}<br/>
                    <span><b>{currentLang === 'es' ? 'Diversión Máxima.' : 'Maximum Fun.'}</b></span>
                  </p>
                )}
              </div>

              <!-- Bloque de texto lateral derecho -->
              <div class="right-text-top-div">
                  <div class="right-text-top">
                      <p class="text-extra">
                        {slide.product_top ? (
                          slide.product_top.split('\n').map((line: string, i: number) =>
                            i === 0 ? <>{line}<br /></> : <>{line}</>
                          )
                        ) : (
                          <>{currentLang === 'es' ? 'Extra picante que' : 'Extra spicy that'}<br />{currentLang === 'es' ? 'enamora' : 'you will love'}</>
                        )}
                      </p>
                  
                  </div>
                  <svg width="255" height="32" viewBox="0 0 255 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 31C0 31 151 31 159.5 31C168 31 182.5 1 191 1C199.5 1 254.5 1 254.5 1" stroke={slide.color_theme === 'purple' ? '#9333ea' : '#FF2D30'}/>
                  </svg>
              </div>
             

              <div class="right-text">
                <p class="text-leveleate">
                  {slide.product_right ? (
                    slide.product_right.split('\n').map((line: string, i: number) =>
                      i === 0 ? <>{line}<br/></> : <>{line}</>
                    )
                  ) : (
                    <>{currentLang === 'es' ? 'Levéleate al máximo con Taqueritos.' : 'Level up to the max with Taqueritos.'}<br/>{currentLang === 'es' ? 'Dragón de Fuego ¿Listo para el reto?' : 'Dragon Fire. Ready for the challenge?'}</>
                  )}
                </p>
                <div class="flex flex-row items-center">
                  <div class="cta">
                    <a href={slide.product_cta_link || `/${currentLang}/#products`} class="cta-button">
                      {slide.product_cta_label || (currentLang === 'es' ? 'Descubre más' : 'Discover more')}
                    </a>
                  </div>
                  <a href={`/${currentLang}/#products`} class="button-play ml-[35px]" aria-label={currentLang === 'es' ? 'Ir a productos' : 'Go to products'}>
                    <div class="button-inner">
                      <svg
                        width="12"
                        height="14"
                        viewBox="0 0 12 14"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M11.1438 5.88712C12.0187 6.40766 12.0187 7.70904 11.1438 8.22959L2.28522 13.5001C1.4103 14.0207 0.31665 13.37 0.31665 12.3289L0.316651 1.78779C0.316651 0.746695 1.4103 0.0960091 2.28522 0.616558L11.1438 5.88712Z"
                          fill="white"
                        />
                      </svg>
                    </div>
                  </a>
                </div>

                  </div>

                  <!-- Overlay with text (conditional) -->
                  {showOverlay && (slide.title || slide.subtitle) && (
                    <div class={`overlay bg-black bg-opacity-${overlayOpacity}`}>
                      <div class="text-content">
                        {slide.title && <h1 class={`slide-title ${textColor}`}>{slide.title}</h1>}
                        {slide.subtitle && <p class={`slide-subtitle ${textColor}`}>{slide.subtitle}</p>}
                        {slide.link && (
                          <a href={slide.link} class="slide-link">
                            <span>{currentLang === 'es' ? 'Ver más' : 'View more'}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="5" y1="12" x2="19" y2="12"></line>
                              <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        );
        })}
      </div>

      <!-- Navigation controls -->
      {slides.length > 1 && (
        <>
          <div class="swiper-button-prev vc-nav-btn vc-nav-prev" aria-label="Slide anterior">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="swiper-button-next vc-nav-btn vc-nav-next" aria-label="Slide siguiente">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="swiper-pagination pills"></div>
        </>
      )}


    </div>
  </div>
)}


<style>
  .video-carousel-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #2c0b0b 0%, #150404 80%);
  }

  /* Swiper debe ocupar todo el alto del contenedor */
  .video-carousel-container .swiper-container,
  .video-carousel-container .swiper-wrapper,
  .video-carousel-container .swiper-slide {
    width: 100%;
    height: 100%;
  }

  /* Asegura que cada slide y su wrapper interno rellenen la altura del carrusel */
  .video-carousel .swiper-slide { display: flex; }
  .video-carousel .swiper-slide > .media-slide-wrapper,
  .video-carousel .swiper-slide > .product-slide-wrapper { flex: 1 1 auto; height: 100%; width: 100%; }
  .product-slide-wrapper .slide-content { height: 100%; }
  
  /* ========== SLIDES DE IMAGEN/VIDEO (FULLSCREEN) ========== */
  .media-slide-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    background: transparent;
  }
  
  .media-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .media-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  
  .media-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }
  
  .media-desktop {
    display: none;
  }
  
  .media-mobile {
    display: block;
  }
  
  @media (min-width: 768px) {
    .media-desktop {
      display: block;
    }
    
    .media-mobile {
      display: none;
    }
  }
  
  /* ========== SLIDES DE PRODUCTO ========== */
  .product-slide-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .product-slide-wrapper .slide-content {
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse at center, #230405 0%, #230405 50%, #230405 100%);
  }
  
  /* Pseudo-elementos (círculos rojos) solo para slides de producto */
  .product-slide-wrapper .slide-content::before,
  .product-slide-wrapper .slide-content::after {
    content:"";
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:50vw;
    height:38vw;
    border-radius:50%;
    background: radial-gradient(ellipse at center, rgba(255,30,40,0.5) 0%, rgba(140,0,0,0) 70%);
    filter: blur(60px);
    z-index:1;
  }
  .product-slide-wrapper .slide-content::before { left:-30vw; }
  .product-slide-wrapper .slide-content::after { right:-30vw; }
  
  /* ======= LÍNEAS CURVAS ROJAS ======= */
  .slide-image {
    width: 920;
    height: 680;
    object-fit: cover;
    object-position: center;
  }



  /* Animación flotante SOLO para imágenes de producto */
  .product-slide-wrapper .image-container .slide-image {
    animation: floatUpDown 2s ease-in-out infinite;
    transition: transform 1s ease-in-out;
  }

  .line.left {
    left: 3%;
    top: -10%;
    height: 140%;
    border-radius: 50%;
    transform: rotate(15deg);
    box-shadow: 0 0 20px rgba(255,60,0,0.7);
  }

  .text-extra {
    font-size: 16px;
    font-weight: 400;
    font-family: var(--font-text);
    color: white;
    line-height: 20px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* Alinea el bloque a la izquierda */
    text-align: left;        /* Alinea el texto dentro del bloque */
  }

  .text-leveleate {
    font-size: 16px;
    font-weight: 400;
    font-family: var(--font-text);
    color: white;
    line-height: 100%;
    text-transform: uppercase;
    display: flex;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

   .right-text-top {
    position: absolute;
    bottom: 70%;
    display: flex;
    flex-direction: row;
    color: white;
    font-family: var(--font-text);
  }

  .right-text-top-div {
    position: absolute;
    right: 8%;
    bottom: 70%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    color: white;
    font-family: var(--font-text);
  }


  .fallback-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 920;
    height: 680;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fallback-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }
  
  .line.right {
    right: 3%;
    top: -10%;
    height: 140%;
    border-radius: 50%;
    transform: rotate(-15deg);
    box-shadow: 0 0 20px rgba(255,60,0,0.7);
  }

  .button-play {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: rgba(255, 0, 4, 0.25); /* círculo externo */
    display: none !important; /* ocultar visualmente */
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

/* Círculo interior */
  .button-inner {
    width: 34px;
    height: 36px;
    background-color: rgba(255, 0, 4, 0.25); /* rojo sólido */
    border-radius: 50%;
    border-color: rgba(255, 45, 48, 1);
    border-width: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 25px rgba(255, 45, 48, 0.6);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Animación hover */
  .button-play:hover {
    transform: scale(1.08);
  }
  .button-play:hover .button-inner {
    box-shadow: 0 0 35px rgba(255, 45, 48, 0.8);
    transform: scale(1.05);
  }

  /* SVG blanco centrado */
  .button-play svg {
    width: 12px;
    height: 16px;
    fill: white;
  }

  /* ======= TEXTO CENTRAL ======= */
  .dragon-text {
    color: rgba(158, 74, 75, 0.5);
    z-index: 2;
    animation: colorCycle 5s ease-in-out infinite;
    text-align: center;
    position: absolute;
    font-size: 190px !important;
  }

  @keyframes colorCycle {
    0% { color: #9a2d2e; }
    25% { color: #ae5157; }
    50% { color: #904d50; }
    75% { color: #9c3235; }
    100% { color: #9a2d2e; }
  }
  
  /* ======= TEXTO IZQUIERDO ======= */
  .left-text {
    position: absolute;
    left: 6%;
    bottom: 20%;
    color: white;
    font-size: 1.5rem;
    line-height: 1.4;
    font-family: var(--font-title);
    z-index: 10;
    font-size: 40px;
    font-weight: 400;
    line-height: 120%;
  }
  .left-text span { color: #ff7b7b; }
  
  /* ======= TEXTO DERECHO ======= */
  .right-text {
    position: absolute;
    right: 8%;
    bottom: 20%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    color: white;
    font-family: var(--font-title);
    z-index: 10;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .cta-button {
    width: 247px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: linear-gradient(90deg, #ff0033, #ff4d6d);
    color: white;
    font-weight: bold;
    text-transform: uppercase;
    border-radius: 6px;
    padding: 0.8rem 1.8rem;
    font-size: 1rem;
    box-shadow: 0 0 25px rgba(255,0,0,0.4);
    transition: all 0.3s ease;
  }
  .cta-button:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 0 40px rgba(255,0,0,0.6);
  }
  .cta-button span {
    font-size: 1.2rem;
    margin-left: 4px;
  }
  
  /* ======= IMAGEN ======= */

  @keyframes floatUpDown {
    0% { transform: translateY(0); }
    50% { transform: translateY(60px); }
    100% { transform: translateY(0); }
  }

  /* Animación flotante SOLO para imágenes de producto */
  .product-slide-wrapper .image-container .slide-image {
    animation: floatUpDown 2s ease-in-out infinite;
    transition: transform 1s ease-in-out;
  }

  .desktop-image {
    display: none;
    width: 920;
    height: 680;
  }

  .mobile-image {
    display: block;
    width: 920;
    height: 680;
  }


  /* ======= Pildoras ======= */

/* Contenedor y posición */
/* Posición del contenedor de paginación */
  :global(.swiper-pagination.pills) {
    position: absolute;
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    z-index: 40;
  }

  /* Bullet base: forma de píldora */
  :global(.swiper-pagination.pills .swiper-pagination-bullet) {
    width: 40px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(255,255,255,0.18);
    opacity: 1;                /* Swiper pone 0.2 por defecto */
    transition: width .25s ease, background .25s ease, transform .25s ease, box-shadow .25s ease;
    margin: 0 !important;      /* Swiper añade márgenes, los quitamos */
  }

  /* Activo: más ancho y rosa/rojo brillante */
  :global(.swiper-pagination.pills .swiper-pagination-bullet-active) {
    width: 30px;
    height: 8px;
    background: #ff3a58;
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(255,58,88,0.45);
  }

  /* Hover (opcional) */
  :global(.swiper-pagination.pills .swiper-pagination-bullet:hover) {
    transform: translateY(-1px);
  }

  .video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .slide-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes floatBag {
    0% { transform: rotate(-12deg) translateY(0); }
    50% { transform: rotate(-12deg) translateY(-14px); }
    100% { transform: rotate(-12deg) translateY(0); }
  }
  
  @media (min-width: 768px) and (max-width: 1024px) {
    .desktop-image { 
      display: block !important; 
    }
    .mobile-image { 
      display: none !important; 
    }
    .right-text {
      bottom: 8%;
    }

    .left-text {
      bottom: 8%;
    }

    .right-text-top-div {
      bottom: 80%;
    }
  }

  @media (max-width: 767px){
    .video-carousel-container { height: 500px; }
    .slide-content{ height: 500px !important; padding: 0 20px; }
    .dragon-text{ 
      font-size: 72px !important;
      margin-top: 98px !important;
      transform: translateY(18px);
      padding-right: 0 !important;
      white-space: normal !important;
      word-break: keep-all;
      overflow-wrap: normal;
      line-height: 0.92;
      text-align: left;
      width: 100%;
      max-width: 340px;
    }
    .right-text-top-div { display: none !important;}
    .left-text {display: none !important;}

    .swiper-pagination.pills {
      position: absolute;
      bottom: 20px;
      top: auto;
      left: 50%;
      transform: translateX(-50%);
      z-index: 40;
    }

    .right-text {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 78px;
      margin: 0;
      padding: 0;
      gap: 12px;
      z-index: 30;
    }

    .text-leveleate {
      font-size: 15px !important;
      line-height: 1.4 !important;
      margin-bottom: 12px;
    }

    .cta-button {
      width: auto;
      min-width: 190px;
      padding: 0.8rem 1.4rem;
      font-size: 0.9rem;
    }

    .button-play {
      margin-left: 14px !important;
    }

    /* Reducir altura de la imagen principal en mobile */
    .product-slide-wrapper .image-container {
      height: 320px !important;
      align-items: center;
      justify-content: center;
    }
    .mobile-image {
      height: 100% !important;
      width: auto;
      object-fit: contain;
      /* Ajuste exclusivo para mobile: posicionar la imagen hacia arriba y mantener ligero scale */
      object-position: 50% 10%;
      transform: translateY(-10px) scale(1.08);
      transform-origin: center;
    }

    /* Mejorar envoltura de títulos en overlay */
    .text-content .slide-title { white-space: normal; word-break: normal; overflow-wrap: normal; }

    /* Corregir posición vertical imagen Lava en mobile (aplica también a slides marcados data-size="purple") */
    .product-slide-wrapper[data-theme="purple"] .image-container .slide-image,
    .product-slide-wrapper[data-size="purple"] .image-container .slide-image {
      transform: translateY(-150px) rotate(0deg) scale(0.65);
      animation: floatUpDownPurpleMobile 2s ease-in-out infinite !important;
    }

  }

  /* TEMA MORADO (Taqueritos Lava) */
  .product-slide-wrapper[data-theme="purple"] .slide-content {
    background: radial-gradient(ellipse at center, #160820 0%, #160820 50%, #160820 100%);
  }

  .product-slide-wrapper[data-theme="purple"] .slide-content::before,
  .product-slide-wrapper[data-theme="purple"] .slide-content::after {
    background: radial-gradient(ellipse at center, rgba(130, 0, 210, 0.55) 0%, rgba(70, 0, 140, 0) 70%);
  }

  .product-slide-wrapper[data-theme="purple"] .dragon-text {
    animation: colorCyclePurple 5s ease-in-out infinite;
  }

  /* IAnimacion de la imagen Lava*/
  .product-slide-wrapper[data-theme="purple"] .image-container .slide-image,
  .product-slide-wrapper[data-size="purple"] .image-container .slide-image {
    transform: translateY(-60px) rotate(0deg) scale(0.60);
    animation: floatUpDownPurple 2s ease-in-out infinite;
    transform-origin: center center;
  }

  @keyframes floatUpDownPurple {
    0%   { transform: translateY(-60px) rotate(0deg) scale(0.60); }
    50%  { transform: translateY(calc(-60px + 60px)) rotate(0deg) scale(0.60); }
    100% { transform: translateY(-60px) rotate(0deg) scale(0.60); }
  }

  /* Keyframe para mobile */
  @keyframes floatUpDownPurpleMobile {
    0%   { transform: translateY(-20px) rotate(0deg) scale(0.65); }
    50%  { transform: translateY(35px) rotate(0deg) scale(0.65); }
    100% { transform: translateY(-20px) rotate(0deg) scale(0.65); }
  }

  @keyframes colorCyclePurple {
    0%   { color: rgba(90, 30, 130, 0.5); }
    25%  { color: rgba(120, 50, 160, 0.55); }
    50%  { color: rgba(80, 20, 120, 0.5); }
    75%  { color: rgba(100, 35, 145, 0.52); }
    100% { color: rgba(90, 30, 130, 0.5); }
  }

  .product-slide-wrapper[data-theme="purple"] .left-text span {
    color: #c084fc;
  }

  .product-slide-wrapper[data-theme="purple"] .cta-button {
    background: linear-gradient(90deg, #7e22ce, #a855f7);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.45);
  }

  .product-slide-wrapper[data-theme="purple"] .cta-button:hover {
    box-shadow: 0 0 40px rgba(168, 85, 247, 0.7);
  }

  .product-slide-wrapper[data-theme="purple"] .button-play {
    background-color: rgba(168, 85, 247, 0.25);
  }

  .product-slide-wrapper[data-theme="purple"] .button-inner {
    background-color: rgba(168, 85, 247, 0.25);
    border-color: rgba(168, 85, 247, 1);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.6);
  }

  .product-slide-wrapper[data-theme="purple"] .button-play:hover .button-inner {
    box-shadow: 0 0 35px rgba(168, 85, 247, 0.85);
  }

  /* Flechas de navegación de los banners del home */
  :global(.swiper-button-next.vc-nav-btn),
  :global(.swiper-button-prev.vc-nav-btn) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  :global(.swiper-button-next.vc-nav-btn)::after,
  :global(.swiper-button-prev.vc-nav-btn)::after {
    display: none; /* Ocultar el contenido por defecto de Swiper */
  }

  :global(.swiper-button-prev.vc-nav-prev) {
    left: clamp(40px, 4vw, 80px);
  }

  :global(.swiper-button-next.vc-nav-next) {
    right: clamp(40px, 4vw, 80px);
  }

  :global(.swiper-button-next.vc-nav-btn:hover),
  :global(.swiper-button-prev.vc-nav-btn:hover) {
    background: rgba(255, 45, 48, 0.35);
    border-color: rgba(255, 45, 48, 0.6);
    box-shadow: 0 0 20px rgba(255, 45, 48, 0.4);
    transform: translateY(-50%) scale(1.08);
  }

  @media (max-width: 767px) {
    :global(.swiper-button-prev.vc-nav-prev) { left: 16px; }
    :global(.swiper-button-next.vc-nav-next) { right: 16px; }
    :global(.swiper-button-next.vc-nav-btn),
    :global(.swiper-button-prev.vc-nav-btn) {
      width: 36px;
      height: 36px;
    }
  }

  </style>
  

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  const swiperMap = new WeakMap<Element, Swiper>();

  function initVideoCarousel() {
    document.querySelectorAll('.video-carousel').forEach((el) => {
      const slidesCount = el.querySelectorAll('.swiper-slide').length;
      const paginationEl = el.querySelector('.swiper-pagination') as HTMLElement | null;

      if (slidesCount <= 1) {
        if (paginationEl) paginationEl.style.display = 'none';
        const existing = swiperMap.get(el);
        if (existing && !existing.destroyed) {
          try { existing.destroy(true, true); } catch {}
        }
        swiperMap.delete(el);
        return;
      }

      if (paginationEl) paginationEl.style.display = '';

      const existing = swiperMap.get(el);
      if (existing && !existing.destroyed) {
        try { existing.update(); } catch {}
        return;
      }

      const swiper = new Swiper(el as any, {
        modules: [Navigation, Pagination, Autoplay],
        slidesPerView: 1,
        spaceBetween: 0,
        loop: true,
        autoplay: {
          delay: 5000,
          disableOnInteraction: false,
        },
        navigation: {
          nextEl: el.querySelector('.swiper-button-next') as HTMLElement | null,
          prevEl: el.querySelector('.swiper-button-prev') as HTMLElement | null,
        },
        pagination: {
          el: paginationEl || '.swiper-pagination',
          clickable: true,
        },
      });

      swiperMap.set(el, swiper);

      const videos = el.querySelectorAll('video[data-slide-id]') as NodeListOf<HTMLVideoElement>;

      function playVideo(video: HTMLVideoElement) {
        if (!video) return;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {});
        }
      }

      function pauseAllVideos() {
        videos.forEach((video) => {
          try { video.pause(); } catch {}
        });
      }

      swiper.on('slideChange', () => {
        pauseAllVideos();
        const activeSlide = swiper.slides[swiper.activeIndex] as HTMLElement | undefined;
        const activeVideo = activeSlide?.querySelector('video[data-slide-id]') as HTMLVideoElement | null;
        if (activeVideo) {
          setTimeout(() => playVideo(activeVideo), 250);
        }
      });

      const initialVideo = swiper.slides[swiper.activeIndex]?.querySelector('video[data-slide-id]') as HTMLVideoElement | null;
      if (initialVideo) {
        playVideo(initialVideo);
      }
    });
  }

  function destroyVideoCarousel() {
    document.querySelectorAll('.video-carousel').forEach((el) => {
      const existing = swiperMap.get(el);
      if (existing && !existing.destroyed) {
        try { existing.destroy(true, true); } catch {}
      }
      swiperMap.delete(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoCarousel);
  } else {
    initVideoCarousel();
  }
  document.addEventListener('astro:page-load', initVideoCarousel);
  document.addEventListener('astro:after-swap', initVideoCarousel);
  document.addEventListener('astro:before-swap', destroyVideoCarousel);
</script>
