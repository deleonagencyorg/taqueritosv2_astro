                </div>
                
                <!-- Honduras -->
                <div class="flex items-center justify-start space-x-2">
                  <svg width="27" height="19" viewBox="0 0 27 19" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
                    <g clip-path="url(#clip0_2132_1935)">
