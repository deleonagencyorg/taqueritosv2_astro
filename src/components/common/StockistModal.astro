---
interface Product {
  id: string;
  name: string;
  name_description: string;
  image: string;
  weight?: string[];
}

interface Stockist {
  id: string;
  name: string;
  link: string;
  icon: string;
}

interface Props {
  products: Product[];
  stockists: Stockist[];
  initialProduct?: Product;
  locale?: string;
}

const { products = [], stockists = [], initialProduct, locale = 'es' } = Astro.props;

const texts = {
  es: {
    product: 'Producto',
    weight: 'Gramaje',
    whereToFind: '¿DÓNDE ENCONTRARNOS?',
    buy: 'COMPRAR',
    contact: 'CONTÁCTANOS'
  },
  en: {
    product: 'Product',
    weight: 'Weight',
    whereToFind: 'WHERE TO FIND US?',
    buy: 'BUY',
    contact: 'CONTACT US'
  }
};

const t = texts[locale as keyof typeof texts] || texts.es;
---

<div id="stockist-modal" class="stockist-modal modal-hidden">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close" aria-label="Cerrar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="modal-body">
      <!-- Sección superior: Imagen + Selectores -->
      <div class="modal-top-section">
        <!-- Imagen del producto -->
        <div class="product-image-section">
          <img 
            id="modal-product-image" 
            src={initialProduct?.image || products[0]?.image || ''} 
            alt={initialProduct?.name || products[0]?.name || ''}
            class="product-image"
          />
        </div>

        <!-- Contenido del modal -->
        <div class="modal-info">
          <h2 id="modal-product-title" class="product-title">
            {initialProduct?.name || products[0]?.name || ''}
          </h2>

          <!-- Selector de Producto -->
          <div class="form-group">
            <label id="product-select-label">{t.product}</label>
            <div class="custom-select-container" id="custom-select-container">
              <button
                class="custom-select-trigger"
                id="custom-select-trigger"
                type="button"
                role="combobox"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="product-select-label"
                data-initial-id={initialProduct?.id || products[0]?.id || ''}
              >
                <span class="custom-select-text" id="custom-select-text">
                  {initialProduct?.name || products[0]?.name || ''}
                </span>
                <img
                  src="https://snack.yummiespromociones.com/SnacksyummiesAssets/arrow-down-circle.png"
                  alt="arrow down"
                  class="select-arrow-img"
                  id="custom-select-arrow"
                />
              </button>
            </div>
          </div>

          <!-- Selector de Gramaje -->
          <div class="form-group">
            <label for="weight-select">{t.weight}</label>
            <div id="weight-buttons" class="weight-buttons">
              {(initialProduct?.weight || products[0]?.weight || []).map((weight) => (
                <div 
                  class="weight-btn"
                  data-weight={weight}
                >
                  {weight}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Sección inferior: Stockists centrados -->
      <div class="stockists-section">
        <h3 class="section-title">{t.whereToFind}</h3>

        <!-- Lista de Stockists -->
        <div class="stockists-list">
          {stockists.map((stockist) => (
            <div class="stockist-item">
              <div class="stockist-info">
                <img src={stockist.icon} alt={stockist.name} class="stockist-logo" />
              </div>
              <a 
                href={stockist.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="stockist-button"
              >
                {stockist.id === 'walmart' ? t.contact : t.buy}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- JSON data for products -->
  <script type="application/json" id="stockist-products-json" set:html={JSON.stringify(products)}></script>
</div>

<style>
  .stockist-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 100px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .stockist-modal.modal-hidden {
    display: none !important;
  }

  .stockist-modal.show {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    background: #000;
    border-radius: 20px;
    max-width: 900px;
    width: 90%;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    z-index: 1;
    margin-top: 0;
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: white;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 40px;
  }

  .modal-top-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
  }

  .product-image-section {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-image {
    width: 100%;
    max-width: 160px;
    height: auto;
    object-fit: contain;
  }

  .modal-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .stockists-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .product-title {
    font-size: 28px;
    font-weight: 800;
    color: white;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
  }

  .custom-select-container {
    position: relative;
    width: 100%;
  }

  .custom-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    padding: 12px 16px;
    color: white;
    font-size: 16px;
    cursor: pointer;
    transition: border-color 0.3s ease, background 0.3s ease;
    text-align: left;
    gap: 12px;
    font-family: inherit;
  }

  .custom-select-trigger:hover,
  .custom-select-trigger:focus {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.5);
    outline: none;
  }

  .custom-select-trigger[aria-expanded="true"] {
    border-color: rgba(255, 255, 255, 0.6);
  }

  .custom-select-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .select-arrow-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .weight-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .weight-btn {
    background: transparent !important;
    border: 1.5px solid #FFFFFF !important;
    border-radius: 30px;
    padding: 10px 24px;
    color: #FFFFFF !important;
    font-size: 16px;
    font-family: 'Avory I PE', sans-serif;
    font-weight: 600;
    display: inline-block;
  }

  .section-title {

    font-size: 24px;
    font-weight: 800;
    color: white;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    text-align: center;
  }

  .stockists-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    max-width: 600px;
    align-items: center;
  }

  .stockist-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 20px 32px;
    background: #000;
    border-radius: 12px;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 500px;
  }

  .stockist-item:hover {
    background: #1a1a1a;
  }

  .stockist-info {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 150px;
  }

  .stockist-logo {
    width: 120px;
    height: auto;
    object-fit: contain;
  }

  .stockist-button {
    background: #FF4400;
    color: white;
    padding: 12px 32px;
    border-radius: 8px;
    font-family: 'Avory I PE', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .stockist-button:hover {
    background: #FF6622;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 68, 0, 0.4);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .stockist-modal {
      align-items: flex-start;
      padding-top: 80px;
    }

    .modal-content {
      margin-top: 20px;
      max-height: calc(100vh - 100px);
    }
  }

  @media (max-width: 768px) {
    .stockist-modal {
      align-items: flex-start;
      padding-top: 60px;
      padding-bottom: 20px;
    }

    .modal-content {
      margin-top: 10px;
      margin-bottom: 20px;
      max-height: calc(100vh - 140px);
      border-radius: 20px;
    }

    .modal-body {
      gap: 24px;
      padding: 32px;
    }

    .modal-top-section {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-image-section {
      padding: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-image {
      max-width: 140px;
    }

    .product-title {
      font-size: 22px;
    }

    .section-title {
      font-size: 20px;
    }

    .stockists-list {
      max-width: 100%;
    }

    .stockist-item {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }

    .stockist-logo {
      width: 100px;
    }

    .stockist-button {
      width: 100%;
    }

    /* ocultar flecha en donde comprar mobile */
    .select-arrow-img {
      display: none !important;
    }

    /* mobile, gramajes en vertical y centrados */
    .weight-buttons {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 12px !important;
      width: 100% !important;
    }

    .weight-btn {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      width: calc(100% - 64px) !important;
      max-width: 360px !important;
      padding: 12px 24px !important;
      margin: 6px 0 !important;
    }
  }

  /* Dropdown */
  :global(#stockist-dropdown-portal) {
    position: fixed;
    z-index: 999999;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.85);
  }

  :global(.stockist-dropdown-list) {
    list-style: none;
    margin: 0;
    padding: 6px 0;
    max-height: 220px;
    overflow-y: auto;
  }

  :global(.stockist-dropdown-option) {
    padding: 10px 16px;
    cursor: pointer;
    color: white;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s ease;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.stockist-dropdown-option:hover),
  :global(.stockist-dropdown-option:active) {
    background: rgba(255, 255, 255, 0.12);
  }

  :global(.stockist-dropdown-option.selected) {
    background: rgba(255, 255, 255, 0.1);
    font-weight: 600;
  }

  :global(.stockist-dropdown-check) {
    display: inline-block;
    width: 16px;
    text-align: center;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.9);
  }
</style>

<script>
  function initStockistModal() {
    const modal = document.getElementById('stockist-modal');
    if (!modal) return;

    const overlay = modal.querySelector('.modal-overlay');
    const closeBtn = modal.querySelector('.modal-close');
    const weightButtonsEl = document.getElementById('weight-buttons') as HTMLElement | null;
    const productImage = document.getElementById('modal-product-image') as HTMLImageElement | null;
    const productTitle = document.getElementById('modal-product-title') as HTMLElement | null;
    const customSelectTrigger = document.getElementById('custom-select-trigger') as HTMLButtonElement | null;
    const customSelectText = document.getElementById('custom-select-text') as HTMLElement | null;
    const selectArrowImg = document.getElementById('custom-select-arrow') as HTMLImageElement | null;

    // Load products from embedded JSON
    const productsJsonEl = document.getElementById('stockist-products-json');
    const productsData: any[] = productsJsonEl
      ? (JSON.parse(productsJsonEl.textContent || '[]') as any[])
      : [];

    // Initial selected product from data attribute
    const initialId = customSelectTrigger?.getAttribute('data-initial-id') || productsData[0]?.id || '';
    let selectedProductId: string = initialId;

    // Portal dropdown state
    let dropdownPortal: HTMLElement | null = null;
    let isDropdownOpen = false;

    //Custom Portal Dropdown

    function buildPortal() {
      const existing = document.getElementById('stockist-dropdown-portal');
      if (existing) existing.remove();

      const portal = document.createElement('div');
      portal.id = 'stockist-dropdown-portal';
      portal.setAttribute('role', 'presentation');

      const ul = document.createElement('ul');
      ul.className = 'stockist-dropdown-list';
      ul.setAttribute('role', 'listbox');

      productsData.forEach((product: any) => {
        const isSelected = product.id === selectedProductId;
        const li = document.createElement('li');
        li.className = 'stockist-dropdown-option' + (isSelected ? ' selected' : '');
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        li.setAttribute('data-value', product.id);

        const check = document.createElement('span');
        check.className = 'stockist-dropdown-check';
        check.textContent = isSelected ? '✓' : '';
        li.appendChild(check);
        li.appendChild(document.createTextNode(product.name));

        // mousedown fires before blur, preventing close-before-select race
        li.addEventListener('mousedown', (e: MouseEvent) => {
          e.preventDefault();
          selectProduct(product.id);
          closeDropdown();
        });

        // Touch support (touchend avoids 300ms delay)
        let touchMoved = false;
        li.addEventListener('touchstart', () => { touchMoved = false; }, { passive: true });
        li.addEventListener('touchmove', () => { touchMoved = true; }, { passive: true });
        li.addEventListener('touchend', (e: TouchEvent) => {
          if (!touchMoved) {
            e.preventDefault();
            selectProduct(product.id);
            closeDropdown();
          }
        }, { passive: false });

        ul.appendChild(li);
      });

      portal.appendChild(ul);
      document.body.appendChild(portal);
      dropdownPortal = portal;
    }

    function positionPortal() {
      if (!dropdownPortal || !customSelectTrigger) return;
      const rect = customSelectTrigger.getBoundingClientRect();
      const estimatedHeight = Math.min(232, productsData.length * 42 + 12);
      const spaceBelow = window.innerHeight - rect.bottom - 8;
      const spaceAbove = rect.top - 8;

      dropdownPortal.style.left = rect.left + 'px';
      dropdownPortal.style.width = rect.width + 'px';

      if (spaceBelow >= estimatedHeight || spaceBelow >= spaceAbove) {
        // Open downward
        dropdownPortal.style.top = (rect.bottom + 4) + 'px';
        dropdownPortal.style.maxHeight = Math.max(spaceBelow, 100) + 'px';
      } else {
        // Open upward
        const avail = Math.min(estimatedHeight, spaceAbove);
        dropdownPortal.style.top = (rect.top - avail - 4) + 'px';
        dropdownPortal.style.maxHeight = avail + 'px';
      }
    }

    function openDropdown() {
      buildPortal();
      positionPortal();
      if (dropdownPortal) dropdownPortal.style.display = 'block';
      isDropdownOpen = true;
      if (customSelectTrigger) customSelectTrigger.setAttribute('aria-expanded', 'true');
      if (selectArrowImg) selectArrowImg.style.transform = 'rotate(180deg)';
    }

    function closeDropdown() {
      if (dropdownPortal) dropdownPortal.style.display = 'none';
      isDropdownOpen = false;
      if (customSelectTrigger) customSelectTrigger.setAttribute('aria-expanded', 'false');
      if (selectArrowImg) selectArrowImg.style.transform = 'rotate(0deg)';
    }

    function selectProduct(productId: string) {
      selectedProductId = productId;
      const product = productsData.find((p: any) => p.id === productId);
      if (!product) return;
      if (customSelectText) customSelectText.textContent = product.name;
      updateProductInfo(productId);
    }

    //Product Info Update

    function updateProductInfo(productId?: string) {
      const id = productId || selectedProductId;
      const product = productsData.find((p: any) => p.id === id);
      if (!product) return;

      if (productTitle) productTitle.textContent = product.name;
      if (productImage) {
        productImage.src = product.image;
        productImage.alt = product.name;
      }

      if (weightButtonsEl) {
        weightButtonsEl.innerHTML = '';
        const weights: string[] = product.weight || [];
        weights.forEach((weight: string) => {
          const weightDiv = document.createElement('div');
          weightDiv.className = 'weight-btn';
          weightDiv.dataset.weight = weight;
          weightDiv.textContent = weight;
          weightDiv.style.cssText =
            'background:transparent;border:1.5px solid #FFFFFF;border-radius:30px;' +
            'padding:10px 24px;color:#FFFFFF;font-size:16px;font-weight:600;display:inline-block;';
          weightButtonsEl.appendChild(weightDiv);
        });
      }
    }

    //Modal Open / Close

    function openModal(productId?: string) {
      if (!modal) return;
      if (productId) {
        selectedProductId = productId;
        const product = productsData.find((p: any) => p.id === productId);
        if (product && customSelectText) customSelectText.textContent = product.name;
        updateProductInfo(productId);
      }
      modal.classList.remove('modal-hidden');
      setTimeout(() => { if (modal) modal.classList.add('show'); }, 10);
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      closeDropdown();
      modal.classList.remove('show');
      setTimeout(() => {
        if (modal) modal.classList.add('modal-hidden');
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
      }, 300);
    }

    //Event Listeners

    if (customSelectTrigger) {
      customSelectTrigger.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        if (isDropdownOpen) closeDropdown();
        else openDropdown();
      });
    }

    // Close when clicking outside
    document.addEventListener('click', (e: MouseEvent) => {
      if (!isDropdownOpen) return;
      const target = e.target as Node;
      const insideTrigger = customSelectTrigger?.contains(target) ?? false;
      const insidePortal = dropdownPortal?.contains(target) ?? false;
      if (!insideTrigger && !insidePortal) closeDropdown();
    });

    // Reposition on scroll / resize
    const repositionHandler = () => { if (isDropdownOpen) positionPortal(); };
    window.addEventListener('scroll', repositionHandler, true);
    window.addEventListener('resize', repositionHandler);

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        if (isDropdownOpen) closeDropdown();
        else if (modal.classList.contains('show')) closeModal();
      }
    });

    // Clean up portal on Astro page transitions
    document.addEventListener('astro:before-swap', () => {
      const portal = document.getElementById('stockist-dropdown-portal');
      if (portal) portal.remove();
    }, { once: true });

    // Expose global opener
    (window as any).openStockistModal = openModal;

  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStockistModal);
  } else {
    initStockistModal();
  }
  document.addEventListener('astro:page-load', initStockistModal);
  document.addEventListener('astro:after-swap', initStockistModal);
</script>
