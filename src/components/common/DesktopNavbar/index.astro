---
import LanguageSwitcher from '../../i18n/LanguageSwitcher.astro';
import { t, type Locale } from '../../../i18n/i18n';
import { logos } from '../../../config/assets';
import type { HeaderColorConfig } from '../../../config/headerColors';
import SocialMediaIcons from '../SocialMediaIcons/index.astro';

export interface Props {
  currentLang: Locale;
  headerColorConfig: HeaderColorConfig;
}

const { currentLang, headerColorConfig } = Astro.props;

// Get current path to determine active menu item
const { pathname } = Astro.url;
const currentPath = pathname;

// Obtener los datos de social media y menú desde las traducciones
const socialMedia = t('social_media', { namespace: 'common', locale: currentLang }) as any;
const rawMenuItems = t('menu_items', { namespace: 'common', locale: currentLang }) as any[];
// Quitar el botón de comunidad
const menuItems = rawMenuItems.filter((item) => item.id !== 'community');

const contactHref = `/${currentLang}/${currentLang === 'es' ? 'contacto' : 'contact'}`;
const contactMenuItem = {
  id: 'contact',
  text: t('contact_us', { namespace: 'common', locale: currentLang }),
  href: contactHref,
};

const menuItemsWithContact = [...menuItems, contactMenuItem];

// Obtener productos para el menú desplegable
const products = t('items', { namespace: 'products', locale: currentLang }) as any[];
---

<!-- Desktop Navigation -->
<nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50 
         bg-[rgba(11,2,2,0.2)] backdrop-blur-sm 
         border border-white/20 rounded-[200px] 
         w-[95%] max-w-[1400px] shadow-lg transition-all duration-300"
  data-current-lang={currentLang}>
  <div class="hidden md:flex items-center justify-center w-full py-3 px-6 ">
    <!-- Logo -->
    <div class="flex-shrink-0 pr-20">
      <a href={`/${currentLang}/`} class="block">
        <img src={logos.principal.url} alt={logos.principal.alt} class="h-14 w-auto" />
      </a>
    </div>

    <!-- Navigation Items - Center -->
    <!-- <div class="flex items-center justify-center flex-1 px-4 mx-auto">
    
    </div> -->

    <!-- Right Side - Language Switcher and Yummies One -->
    <div class="flex items-center space-x-5">
      <div class="flex space-x-4" id="desktop-menu-items">
        {menuItemsWithContact && menuItemsWithContact.map((item: any) => (
          <div class="relative group">
            <a 
              href={item.href}
              data-open-stockist={item.id === 'where-buy' ? 'true' : undefined}
              class={`${headerColorConfig.textColor} font-title text-[16px] uppercase font-medium transition-colors py-2 px-3 rounded-md flex items-center ${!item.href.startsWith('#') && currentPath === item.href ? 'bg-primary text-white' : ''}`}
              style={`color: ${!item.href.startsWith('#') && currentPath === item.href ? '#FFFFFF' : headerColorConfig.textColor};`}
            >
              {item.text}
              {item.submenu && (
                <svg class="w-4 h-4 ml-1 fill-current" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" /></svg>
              )}
            </a>
            
            {/* Submenu de productos */}
            {item.id === 'products' ? (
              <div class="products-dropdown absolute left-0 top-full mt-2 w-64 
                          bg-[rgba(11,2,2,0.85)] backdrop-blur-md 
                          border border-red-500/80 rounded-xl shadow-lg 
                          opacity-0 invisible group-hover:opacity-100 group-hover:visible 
                          transition-all duration-300 pointer-events-none group-hover:pointer-events-auto z-[100]">
                <div class="py-2">
                  {products && products.map((product: any) => (
                    <a
                      href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}/${product.id}`}
                      class="block px-4 py-2 text-white hover:bg-white/10 transition-colors text-sm"
                    >
                      {product.name}
                    </a>
                  ))}
                </div>
              </div>
            ) : null}
          </div>
        ))}
      </div>
      <!-- Language Switcher -->
      <LanguageSwitcher activeLocale={currentLang} headerColorConfig={headerColorConfig} />

      <!-- <div class="hidden md:flex">
        <SocialMediaIcons 
          currentLang={currentLang} 
          iconColor={headerColorConfig.isSpecialBackground ? 'black' : headerColorConfig.textColor.replace('text-', '')}
          centered={false} 
        />
      </div> -->
      
      <!-- Yummies One -->
      <!-- <a href="/yummies-one" class="flex items-center text-white hover:text-gray-300 uppercase text-sm font-medium">
        <span>Yummies One</span>
      </a> -->
    </div>

    <div class="pl-20 flex gap-3">
      {currentLang === 'es' && (
        <a
          href="https://gamer.yummiespromociones.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-[20px] py-[17px] bg-primary text-white rounded-[5px] w-[190px] h-[47px] flex items-center justify-center text-sm uppercase font-title"
        >
          Taqueritos Gaming
        </a>
      )}
    </div>
  </div>
</nav>