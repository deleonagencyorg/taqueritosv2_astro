---
import LanguageSwitcher from '../../i18n/LanguageSwitcher.astro';
import { t, type Locale } from '../../../i18n/i18n';
import { logos } from '../../../config/assets';
import type { HeaderColorConfig } from '../../../config/headerColors';
import SocialMediaIcons from '../SocialMediaIcons/index.astro';

export interface Props {
  currentLang: Locale;
  headerColorConfig: HeaderColorConfig;
}

const { currentLang, headerColorConfig } = Astro.props;

// Get current path to determine active menu item
const { pathname } = Astro.url;
const currentPath = pathname;

// Obtener los datos de social media y menú desde las traducciones
const socialMedia = t('social_media', { namespace: 'common', locale: currentLang }) as any;
const rawMenuItems = t('menu_items', { namespace: 'common', locale: currentLang }) as any[];
// Quitar el botón de comunidad
const menuItems = rawMenuItems.filter((item) => item.id !== 'community');
// Filtrar juegos solo para español
const menuItemsFiltered = menuItems.filter((item) => item.id !== 'games' || currentLang === 'es');

const contactHref = `/${currentLang}/${currentLang === 'es' ? 'contacto' : 'contact'}`;
const contactMenuItem = {
  id: 'contact',
  text: t('contact_us', { namespace: 'common', locale: currentLang }),
  href: contactHref,
};

const menuItemsWithContact = [...menuItemsFiltered, contactMenuItem];

// Obtener productos para el menú desplegable
const products = t('items', { namespace: 'products', locale: currentLang }) as any[];
// Obtener juegos para el menú desplegable
const games = t('games', { namespace: 'common', locale: currentLang }) as any[];
---

<!-- Desktop Navigation -->
<nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50 
         bg-[rgba(11,2,2,0.2)] backdrop-blur-sm 
         border border-white/20 rounded-[200px] 
         w-[95%] max-w-[1400px] shadow-lg transition-all duration-300"
  data-current-lang={currentLang}>
  <div class="hidden md:flex items-center justify-center w-full py-2 md:py-2.5 lg:py-3 px-3 lg:px-6">
    <!-- Logo -->
    <div class="flex-shrink-0 pr-2 lg:pr-12 xl:pr-20 flex items-center">
      <a href={`/${currentLang}/`} class="flex items-center">
        <img src={logos.principal.url} alt={logos.principal.alt} class="h-8 lg:h-12 xl:h-14 w-auto" />
      </a>
    </div>

    <!-- Navigation Items - Center -->
    <!-- <div class="flex items-center justify-center flex-1 px-4 mx-auto">
    
    </div> -->

    <!-- Right Side - Language Switcher and Yummies One -->
    <div class="flex items-center space-x-0.5 md:space-x-1 lg:space-x-3 xl:space-x-5">
      <div class="flex items-center space-x-0 md:space-x-0.5 lg:space-x-2 xl:space-x-4" id="desktop-menu-items">
        {menuItemsWithContact && menuItemsWithContact.map((item: any) => (
          <div class="relative group flex items-center">
            <a 
              href={item.href}
              data-open-stockist={item.id === 'where-buy' ? 'true' : undefined}
              class={`${headerColorConfig.textColor} font-title text-[10px] lg:text-[14px] xl:text-[16px] uppercase font-medium transition-colors py-1.5 md:py-2 px-1 md:px-1.5 lg:px-2.5 xl:px-3 rounded-md flex items-center justify-center whitespace-nowrap ${!item.href.startsWith('#') && currentPath === item.href ? 'bg-primary text-white' : ''}`}
              style={`color: ${!item.href.startsWith('#') && currentPath === item.href ? '#FFFFFF' : headerColorConfig.textColor};`}
              onclick={(item.submenu || item.id === 'games') ? "toggleSubmenu(this)" : undefined}
            >
              <span class="flex items-center justify-center text-center leading-tight">{item.text}</span>
              {(item.submenu || item.id === 'games') && (
                <svg class="w-2.5 h-2.5 lg:w-4 lg:h-4 ml-0.5 lg:ml-1 fill-current" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" /></svg>
              )}
            </a>
            
            {/* Submenu de productos */}
            {item.id === 'products' ? (
              <div class="submenu absolute left-0 top-full mt-0 w-64 
                          bg-[rgba(11,2,2,0.85)] backdrop-blur-md 
                          border border-red-500/80 rounded-xl shadow-lg 
                          opacity-0 invisible group-hover:opacity-100 group-hover:visible 
                          transition-all duration-300 pointer-events-none group-hover:pointer-events-auto open:opacity-100 open:visible open:pointer-events-auto z-[100]">
                <div class="py-2">
                  {products && products.map((product: any) => (
                    <a
                      href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}/${product.id}`}
                      class="block px-4 py-2 text-white hover:bg-white/10 transition-colors text-sm"
                      data-no-swipe="true"
                      data-no-animation="true"
                    >
                      {product.name}
                    </a>
                  ))}
                </div>
              </div>
            ) : null}
            
            {/* Submenu de juegos */}
            {item.id === 'games' ? (
              <div class="submenu absolute left-0 top-full mt-0 w-64 
                          bg-[rgba(11,2,2,0.85)] backdrop-blur-md 
                          border border-red-500/80 rounded-xl shadow-lg 
                          opacity-0 invisible group-hover:opacity-100 group-hover:visible 
                          transition-all duration-300 pointer-events-none group-hover:pointer-events-auto open:opacity-100 open:visible open:pointer-events-auto z-[100]">
                <div class="py-2">
                  {games && games.map((game: any) => (
                    <a
                      href={game.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block px-4 py-2 text-white hover:bg-white/10 transition-colors text-sm"
                    >
                      {game.name}
                    </a>
                  ))}
                </div>
              </div>
            ) : null}
          </div>
        ))}
      </div>
      <!-- Language Switcher -->
      <LanguageSwitcher activeLocale={currentLang} headerColorConfig={headerColorConfig} />

      <!-- <div class="hidden md:flex">
        <SocialMediaIcons 
          currentLang={currentLang} 
          iconColor={headerColorConfig.isSpecialBackground ? 'black' : headerColorConfig.textColor.replace('text-', '')}
          centered={false} 
        />
      </div> -->
      
      <!-- Yummies One -->
      <!-- <a href="/yummies-one" class="flex items-center text-white hover:text-gray-300 uppercase text-sm font-medium">
        <span>Yummies One</span>
      </a> -->
    </div>

    <div class="pl-2 lg:pl-12 xl:pl-20 flex items-center gap-3">
      {currentLang === 'es' && (
        <a
          href="https://gamer.yummiespromociones.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-[5px] bg-primary text-white rounded-[5px] h-[32px] md:h-[36px] lg:h-[42px] xl:h-[47px] flex items-center justify-center text-[9px] md:text-[10px] lg:text-[11px] xl:text-sm uppercase font-title leading-none"
        >
          <span class="flex items-center justify-center text-center whitespace-nowrap">Taqueritos Gaming</span>
        </a>
      )}
    </div>
  </div>
</nav>

<script>
function toggleSubmenu(el) {
  // Cerrar otros submenus abiertos
  const allSubmenus = document.querySelectorAll('.submenu.open');
  allSubmenus.forEach(sub => sub.classList.remove('open'));
  
  const submenu = el.parentElement.querySelector('.submenu');
  submenu.classList.toggle('open');
}

// Cerrar submenus al hacer clic fuera
document.addEventListener('click', (e) => {
  if (!e.target.closest('.group')) {
    document.querySelectorAll('.submenu.open').forEach(el => el.classList.remove('open'));
  }
});
</script>

<style>
.submenu.open {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
}
</style>