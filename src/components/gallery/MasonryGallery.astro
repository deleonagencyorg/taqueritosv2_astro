---
import LazyImage from '../common/LazyImage.astro';

export interface GalleryItem { url: string; alt?: string; }

export interface Props {
  items: GalleryItem[];
  columns?: number;
  title?: string;
  subtitle?: string;
  className?: string;
}

const { items = [], columns = 3, title = '', subtitle = '', className = '' } = Astro.props as Props;
---

<section class={className}>
  <div class="gallery-viewport relative">
    
    <!-- Botones de Navegación (título se renderiza en Home) -->
    <div class="container mx-auto px-4 flex justify-end mb-4">
      <div class="carousel-navigation-masonry">
        <button class="swiper-button-prev" aria-label="Anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        
        <button class="swiper-button-next" aria-label="Siguiente">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.0002 7 15.0002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Swiper -->
    <div class="swiper-container" data-count={items.length} data-gallery-swiper>
      <div class="swiper-wrapper">
        {items.map((item, idx) => (
          <div class="swiper-slide" data-slide-index={idx}>
            <div class="taqueritos-card">
              
              <!-- Imagen -->
              <div class="image-container">
                <button class="image-button" 
                        data-index={idx} 
                        aria-label={item.alt || 'Abrir imagen'}>
                  <LazyImage 
                    src={item.url} 
                    alt={item.alt || ''} 
                    class="card-image" 
                  />
                </button>
              </div>

              <!-- Barra de Acciones -->
              <div class="actions-bar">
                <div class="flex items-center gap-4">
                  <button class="action-btn" aria-label="Me gusta" data-action="like">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                  </button>
                  <button class="action-btn" aria-label="Comentar" data-action="comment">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                  </button>
                  <button class="action-btn" aria-label="Compartir" data-action="share">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                  </button>
                </div>

                <button class="action-btn" aria-label="Guardar" data-action="bookmark">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                  </svg>
                </button>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .gallery-viewport { 
    position: relative; 
    width: 100%; 
    background: transparent; /* Usa el mismo fondo que la sección padre */
    overflow: hidden;
  }

  
  .title {
    font-family: 'Avory I PE', sans-serif;
    font-size: 50px;
    font-weight: 800;
    letter-spacing: 2%;
    line-height: 45px;
    color: white;
    text-transform: uppercase;
    position: relative;
    z-index: 10;
  }

  /* Se desactivan los blobs azules para que el fondo se vea uniforme */
  .gallery-viewport::before,
  .gallery-viewport::after {
    content: none;
  }

  /* ✅ CLAVE: Padding reducido para que quepan 4 cards */
  .swiper-container {
    padding: 60px 50px 100px 50px;
    position: relative;
    z-index: 1;
    width: 100%;
    overflow: visible;
  }

  .action-btn {
    color: white;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    color: #2DA0FF;
    transform: scale(1.1);
  }

  .carousel-navigation-masonry {
    position: absolute;
    right: 50px;
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .swiper-button-next::after,
  .swiper-button-prev::after {
    content: '' !important;
    display: none !important;
  }

  .swiper-button-next,
  .swiper-button-prev {
    position: relative !important;
    width: 56px !important;
    height: 56px !important;
    margin: 0 !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;
    background: rgba(45, 160, 255, 0.16) !important;
    border: 2px solid #2DA0FF !important;
    border-radius: 10px !important;
    backdrop-filter: blur(10px) !important;
    transition: all 0.3s ease !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    padding: 0 !important;
    pointer-events: auto !important;
  }

  .swiper-button-next svg,
  .swiper-button-prev svg {
    width: 24px !important;
    height: 24px !important;
    pointer-events: none;
  }

  .swiper-button-next:hover,
  .swiper-button-prev:hover {
    background: rgba(45, 160, 255, 0.3) !important;
    border-color: #4DB5FF !important;
    /* transform: translateY(-2px) !important; */
    box-shadow: 0 8px 20px rgba(45, 160, 255, 0.4) !important;
  }

  .swiper-button-next:active,
  .swiper-button-prev:active {
    transform: translateY(0) !important;
  }

  .taqueritos-card {
    position: relative;
    width: 100%;
    background: rgba(45, 160, 255, 0.16);
    border: 1px solid #2DA0FF;
    border-radius: 5px;
    box-shadow: 0px 23px 43px -48px rgba(0, 132, 255, 0.33);
    padding: 17px 19px 20px 19px;
    transition: all 0.3s ease;
  }

  .taqueritos-card:hover {
    transform: translateY(-4px);
    box-shadow: 0px 30px 60px -40px rgba(0, 132, 255, 0.5);
    border-color: #4DB5FF;
  }

  .image-container {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 10px;
    background: #000;
    margin-bottom: 14px;
  }

  .image-button {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    display: block;
    outline: none;
    transition: opacity 0.2s ease;
  }

  .image-button:hover { opacity: 0.9; }

  .image-button:focus {
    outline: 2px solid #2DA0FF;
    outline-offset: 2px;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .action-icon {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    color: white;
    width: 25px;
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  /* Efecto alternado */
  .swiper-slide:nth-child(even) .taqueritos-card {
    transform: translateY(40px);
  }
  
  .swiper-slide:nth-child(odd) .taqueritos-card {
    transform: translateY(-40px);
  }

  .swiper-slide:nth-child(even) .taqueritos-card:hover {
    transform: translateY(36px);
  }
  
  .swiper-slide:nth-child(odd) .taqueritos-card:hover {
    transform: translateY(-44px);
  }

  .action-icon:hover {
    color: #2DA0FF;
    transform: scale(1.15);
  }

  .action-icon:active {
    transform: scale(0.95);
  }

  .action-icon.liked { color: #FF4757; }
  .action-icon.liked svg { fill: #FF4757; }
  .action-icon.bookmarked { color: #2DA0FF; }
  .action-icon.bookmarked svg { fill: #2DA0FF; }

  @media (max-width: 767px) {

    .title {
      font-size: 32px;
      line-height: 1.1;
      margin-bottom: 8px;
    }

    /* En mobile el header se vuelve columna y los botones se colocan debajo del texto */
    .carousel-navigation-masonry {
      position: relative;
      right: auto;
      margin-top: 8px;
      display: flex;
      gap: 12px;
      justify-content: flex-start;
    }

    .swiper-button-next,
    .swiper-button-prev {
      width: 48px !important;
      height: 48px !important;
    }

    .taqueritos-card { padding: 12px 14px 14px 14px; }
    .action-icon { width: 22px; height: 22px; }

    .swiper-container {
      padding: 40px 16px 48px 16px;
      position: relative;
      z-index: 1;
      width: 100%;
      overflow: visible;
    }

    /* Hacer las tarjetas un poco más pequeñas y alinear verticalmente */
    .image-container { aspect-ratio: 4 / 4; }
    .swiper-slide:nth-child(even) .taqueritos-card,
    .swiper-slide:nth-child(odd) .taqueritos-card { transform: none; }
    .swiper-slide:nth-child(even) .taqueritos-card:hover,
    .swiper-slide:nth-child(odd) .taqueritos-card:hover { transform: none; }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  const selector = '[data-gallery-swiper]';
  const swiperMap = new WeakMap();

  function initSwiper() {
    const el = document.querySelector(selector);
    if (!el) return;
    if (el.classList.contains('swiper-initialized')) return;
    if (swiperMap.has(el)) { try { const s = swiperMap.get(el); s && s.update && s.update(); } catch {} return; }
    
    // Get the number of slides
    const slideCount = parseInt(el.getAttribute('data-count') || '0', 10);
    
    // Only enable loop if we have enough slides (at least 8 for desktop with 4 slides per view)
    const enableLoop = slideCount >= 8;
    
    const s = new Swiper(selector, {
      modules: [Navigation, Autoplay],
      slidesPerView: 5,
      spaceBetween: 20,
      loop: enableLoop,
      speed: 600,
      navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
      breakpoints: {
        320:  { slidesPerView: 1, spaceBetween: 16 },
        640:  { slidesPerView: 2, spaceBetween: 18 },
        1024: { slidesPerView: 3, spaceBetween: 20 },
        1440: { slidesPerView: 4, spaceBetween: 20 },
        1600: { slidesPerView: 4, spaceBetween: 22 },
        1920: { slidesPerView: 4, spaceBetween: 24 },
      },
    });
    swiperMap.set(el, s);
  }

  function destroySwiper() {
    const el = document.querySelector(selector);
    if (!el) return;
    const s = swiperMap.get(el);
    if (s && s.destroy) { try { s.destroy(true, true); } catch {} }
    swiperMap.delete(el);
  }

  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initSwiper); } else { initSwiper(); }
  document.addEventListener('astro:page-load', initSwiper);
  document.addEventListener('astro:after-swap', initSwiper);
  document.addEventListener('astro:before-swap', destroySwiper);

  document.addEventListener('click', (e) => {
    const target = e.target;
    const btn = target && target.closest ? target.closest('.action-btn') : null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    if (action === 'like') btn.classList.toggle('liked');
    if (action === 'bookmark') btn.classList.toggle('bookmarked');
  });
</script>


