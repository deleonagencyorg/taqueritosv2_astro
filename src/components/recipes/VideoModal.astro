---
interface Props {
  videoId: string;
  isOpen: boolean;
}

const { isOpen } = Astro.props;
---

<div
  id="video-modal"
  class={`fixed inset-0 z-[9999] flex items-center justify-center transition-opacity duration-300 ${isOpen ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}
  aria-hidden={!isOpen}
  role="dialog"
  aria-modal="true"
>
  <div
    class="absolute inset-0 bg-black/90 backdrop-blur-sm"
    id="video-modal-backdrop"
  ></div>

  <div class="relative z-10 flex items-center justify-center w-full h-full p-4 md:p-8">
    <div id="video-modal-wrapper" class="relative w-full max-w-[min(90vw,1280px)]">
      <div
        id="video-container"
        class="relative w-full bg-black rounded-lg overflow-hidden shadow-2xl"
      >
        <iframe
          id="video-iframe"
          class="absolute inset-0 z-0 w-full h-full hidden"
          src=""
          title="Video de receta"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
          allowfullscreen
        ></iframe>

        <video
          id="video-player"
          class="absolute inset-0 z-0 w-full h-full object-contain hidden"
          controls
          playsinline
          preload="metadata"
        ></video>

        <button
          id="video-modal-close"
          type="button"
          class="absolute top-2 right-2 z-30 w-9 h-9 flex items-center justify-center rounded-full bg-black/60 hover:bg-black/80 border border-white/30 transition-colors duration-200 pointer-events-auto"
          aria-label="Cerrar video"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 text-white pointer-events-none"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #video-modal-wrapper {
    max-height: 90vh;
  }

  #video-container {
    max-height: 90vh;
  }

  #video-container.is-vertical {
    width: auto;
    max-width: min(90vw, 480px);
    margin-inline: auto;
  }

  #video-container.is-horizontal {
    width: 100%;
  }
</style>

<script>
  function isYouTube(url: string): boolean {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  function extractYouTubeId(url: string): string | null {
    if (!url) return null;

    const patterns = [
      /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/,
      /youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]{11})/,
      /youtu\.be\/([a-zA-Z0-9_-]{11})/,
      /youtube\.com\/shorts\/([a-zA-Z0-9_-]{11})/,
      /^([a-zA-Z0-9_-]{11})$/
    ];

    for (const pattern of patterns) {
      const match = url.match(pattern);
      if (match) return match[1];
    }

    return null;
  }

  function applyAspectRatio(width: number, height: number) {
    const container = document.getElementById('video-container');
    const wrapper = document.getElementById('video-modal-wrapper');
    if (!container || !wrapper || width <= 0 || height <= 0) return;

    const ratio = width / height;
    const isVertical = ratio < 1;

    container.style.aspectRatio = `${width} / ${height}`;
    container.classList.toggle('is-vertical', isVertical);
    container.classList.toggle('is-horizontal', !isVertical);

    if (isVertical) {
      const maxHeight = Math.min(window.innerHeight * 0.9, 900);
      const computedWidth = Math.min(maxHeight * ratio, window.innerWidth * 0.9);
      wrapper.style.width = `${computedWidth}px`;
      wrapper.style.maxWidth = '90vw';
    } else {
      wrapper.style.width = '';
      wrapper.style.maxWidth = 'min(90vw, 1280px)';
    }
  }

  function resetContainerSizing() {
    const container = document.getElementById('video-container');
    const wrapper = document.getElementById('video-modal-wrapper');
    if (!container || !wrapper) return;

    container.style.aspectRatio = '';
    container.classList.remove('is-vertical', 'is-horizontal');
    wrapper.style.width = '';
    wrapper.style.maxWidth = '';
  }

  function hideAllPlayers() {
    const iframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;
    const videoPlayer = document.getElementById('video-player') as HTMLVideoElement | null;

    if (iframe) {
      iframe.src = '';
      iframe.classList.add('hidden');
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.removeAttribute('src');
      videoPlayer.load();
      videoPlayer.classList.add('hidden');
    }
  }

  function openVideoModal(videoUrl: string) {
    const modal = document.getElementById('video-modal');
    const iframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;
    const videoPlayer = document.getElementById('video-player') as HTMLVideoElement | null;

    if (!modal) return;

    hideAllPlayers();
    resetContainerSizing();

    if (isYouTube(videoUrl)) {
      const videoId = extractYouTubeId(videoUrl);
      if (!videoId || !iframe) return;

      const isShort = /\/shorts\//.test(videoUrl);
      applyAspectRatio(isShort ? 9 : 16, isShort ? 16 : 9);

      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.classList.remove('hidden');
    } else {
      if (!videoPlayer) return;

      applyAspectRatio(16, 9);

      const onMetadata = () => {
        const width = videoPlayer.videoWidth;
        const height = videoPlayer.videoHeight;
        if (width > 0 && height > 0) {
          applyAspectRatio(width, height);
        }
        videoPlayer.removeEventListener('loadedmetadata', onMetadata);
      };

      videoPlayer.addEventListener('loadedmetadata', onMetadata);
      videoPlayer.src = videoUrl;
      videoPlayer.classList.remove('hidden');
      videoPlayer.play().catch((err) => {
        console.warn('Autoplay prevented by browser:', err);
      });
    }

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeVideoModal() {
    const modal = document.getElementById('video-modal');
    if (!modal) return;

    hideAllPlayers();
    resetContainerSizing();

    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  let globalEventsBound = false;

  function setupModalEvents() {
    if (globalEventsBound) return;
    globalEventsBound = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest('#video-modal-close')) {
        e.preventDefault();
        e.stopPropagation();
        closeVideoModal();
        return;
      }

      if (target.id === 'video-modal-backdrop') {
        closeVideoModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const modal = document.getElementById('video-modal');
      if (modal?.getAttribute('aria-hidden') === 'false') {
        closeVideoModal();
      }
    });

    document.addEventListener('open-video-modal', ((e: CustomEvent) => {
      if (e.detail?.videoUrl) {
        openVideoModal(e.detail.videoUrl);
      }
    }) as EventListener);
  }

  setupModalEvents();

  document.addEventListener('astro:page-load', () => {
    setupModalEvents();
    (window as any).openVideoModal = openVideoModal;
    (window as any).closeVideoModal = closeVideoModal;
  });

  (window as any).openVideoModal = openVideoModal;
  (window as any).closeVideoModal = closeVideoModal;
</script>
