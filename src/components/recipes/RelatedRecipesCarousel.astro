---
import { getLocale } from '../../i18n/i18n';
import RecipeCard from './RecipeCard.astro';

interface RecipeItem {
  id: string;
  title: string;
  image?: string;
  preparation_time: number;
  difficulty?: string;
  servings?: number;
  rating?: number;
  video?: string;
}

export interface Props {
  items: RecipeItem[];
  prevBtnId?: string;
  nextBtnId?: string;
}

const { items = [], prevBtnId, nextBtnId } = Astro.props as { items: RecipeItem[]; prevBtnId?: string; nextBtnId?: string };
const currentLang = getLocale();
---

{items.length === 0 ? (
  <div class="w-full text-center text-gray-500 py-8">
    {currentLang === 'es' ? 'No hay recetas relacionadas.' : 'No related recipes.'}
  </div>
) : (
  <div
    class="w-full related-carousel-wrapper"
    data-related-recipes-carousel
    data-prev-btn-id={prevBtnId}
    data-next-btn-id={nextBtnId}
  >
    <!-- Unified responsive carousel -->
    <div class="related-carousel-viewport overflow-x-hidden overflow-y-visible py-2">
      <div class="related-carousel-track flex transition-transform duration-300 ease-out" data-related-track>
        {items.map((recipe) => (
          <div class="related-slide flex-shrink-0 px-2">
            <RecipeCard
              image={recipe.image || '/images/recipes/placeholder.jpg'}
              title={recipe.title}
              time={`${recipe.preparation_time} MIN`}
              id={recipe.id}
              textColor="text-white"
              iconColor="text-white"
              video={recipe.video}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  function initRelatedCarousel(root: any) {
    if (!root || root._relInit) return;
    root._relInit = true;

    const prevBtnId = root.dataset.prevBtnId;
    const nextBtnId = root.dataset.nextBtnId;
    const prevBtn = prevBtnId ? document.getElementById(prevBtnId) : null;
    const nextBtn = nextBtnId ? document.getElementById(nextBtnId) : null;
    const track = root.querySelector('[data-related-track]') as HTMLElement;
    const slides = Array.from(root.querySelectorAll('.related-slide')) as HTMLElement[];

    if (!track || slides.length === 0) return;

    let currentIndex = 0;

    function getVisibleCount(): number {
      const width = window.innerWidth;
      if (width >= 1024) return 3; // Desktop: 3 cards
      if (width >= 768) return 2;  // Tablet: 2 cards
      return 1;                     // Mobile: 1 card
    }

    function getMaxIndex(): number {
      const visible = getVisibleCount();
      return Math.max(0, slides.length - visible);
    }

    function updateCarousel() {
      const visible = getVisibleCount();
      const slideWidth = 100 / visible;
      
      slides.forEach((slide) => {
        slide.style.width = `${slideWidth}%`;
      });

      const offset = currentIndex * slideWidth;
      track.style.transform = `translateX(-${offset}%)`;
    }

    function goNext() {
      const maxIndex = getMaxIndex();
      if (currentIndex < maxIndex) {
        currentIndex++;
      } else {
        currentIndex = 0;
      }
      updateCarousel();
    }

    function goPrev() {
      if (currentIndex > 0) {
        currentIndex--;
      } else {
        currentIndex = getMaxIndex();
      }
      updateCarousel();
    }

    if (prevBtn) prevBtn.addEventListener('click', goPrev);
    if (nextBtn) nextBtn.addEventListener('click', goNext);

    let resizeTimeout: any = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        const maxIndex = getMaxIndex();
        if (currentIndex > maxIndex) currentIndex = maxIndex;
        updateCarousel();
      }, 100);
    });

    updateCarousel();
  }

  function initAll() {
    document.querySelectorAll('[data-related-recipes-carousel]').forEach((el) => initRelatedCarousel(el as any));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:after-swap', initAll);
</script>

<style>
  .related-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .related-carousel-viewport {
    width: 100%;
    overflow-x: hidden;
    overflow-y: visible;
  }

  .related-carousel-track {
    display: flex;
    will-change: transform;
    align-items: stretch;
  }

  .related-slide {
    flex-shrink: 0;
    padding: 0 8px;
    box-sizing: border-box;
    display: flex;
  }

  .related-slide > :global(*) {
    width: 100%;
    height: 100%;
  }

  .related-slide :global(.block.h-full) {
    display: flex;
    flex-direction: column;
  }

  .related-slide :global(.p-5) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
