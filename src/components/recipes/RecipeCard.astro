---
import LazyImage from '../common/LazyImage.astro';
import { getLocale } from '../../i18n/i18n';
import { Image } from 'astro:assets';
import { fade } from 'astro:transitions';

interface Props {
  image: string;
  title: string;
  time?: string;
  id: string;
  textColor?: string;
  iconColor?: string;
  hoverImage?: string;
  difficulty?: string;
  servings?: number;
  rating?: number;
  video?: string;
}

const { 
  image, 
  title, 
  time = "---", 
  id,
  textColor = 'text-blue-900',
  iconColor = 'text-blue-900',
  hoverImage = image,
  difficulty = "---",
  servings = 0,
  rating = 0,
  video
} = Astro.props;

const currentLocale = getLocale();
const recipeLink = `/${currentLocale}/${currentLocale === 'es' ? 'recetas' : 'recipes'}/${id}`;
---

<div class="recipe-card-wrapper block h-full group overflow-hidden rounded-2xl border border-[#FF6A2A] bg-[#1A0505] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(255,106,42,0.9)] hover:border-[#FF2C2F]" data-has-video={video ? 'true' : 'false'}>
  <!-- Imagen superior -->
  <div 
    class="recipe-card-image relative w-full overflow-hidden cursor-pointer" 
    data-video-trigger={video ? 'true' : 'false'} 
    data-video-url={video || ''}
  >
    <LazyImage
      src={image}
      alt={title}
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
      transition:name={`recipe-image-${id}`}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />

    {video ? (
      <!-- Icono de play si tiene video -->
      <div
        class="video-play-overlay absolute inset-0 flex items-center justify-center"
        data-has-video-indicator
      >
        <div class="w-14 h-14 rounded-full flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[rgba(255,45,48,0.25)] transition-colors duration-200">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 text-white ml-0.5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    ) : (
      <!-- si no tiene video que reridija a detalles -->
      <a href={recipeLink} class="absolute inset-0 z-10" aria-label={title}></a>
    )}
  </div>

  <!-- Contenido inferior - Click para ir al detalle -->
  <a
    href={recipeLink}
    class="recipe-card-content p-4 md:p-5 flex flex-col flex-1"
    transition:animate="fade"
  >
    <h3 class="font-title text-base md:text-lg font-bold text-white leading-snug line-clamp-2">
      {title}
    </h3>

    <div class="flex items-center justify-between text-sm text-white/80 mt-auto pt-3">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{time}</span>
      </div>

      {difficulty !== '---' && (
        <span class="px-2 py-0.5 rounded-full border border-white/20 text-[11px] uppercase tracking-wide text-white/70">
          {difficulty}
        </span>
      )}
    </div>

    <!-- Botón de más detalles -->
    <div class="mt-3 pt-3 border-t border-white/10">
      <span class="text-xs font-semibold text-white uppercase tracking-wide group-hover:text-white/80 transition-colors duration-200">
        {currentLocale === 'es' ? 'Más detalles →' : 'More details →'}
      </span>
    </div>
  </a>
</div>

<script>
  // Manejar clic en la imagen para abrir el modal de video
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.recipe-card-image[data-video-trigger="true"]').forEach((img) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const videoUrl = img.getAttribute('data-video-url');
        if (videoUrl) {
          if ((window as any).openVideoModal) {
            (window as any).openVideoModal(videoUrl);
          } else {
            document.dispatchEvent(new CustomEvent('open-video-modal', {
              detail: { videoUrl }
            }));
          }
        }
      });
    });
  });

  // También para Astro page transitions
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.recipe-card-image[data-video-trigger="true"]').forEach((img) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const videoUrl = img.getAttribute('data-video-url');
        if (videoUrl) {
          if ((window as any).openVideoModal) {
            (window as any).openVideoModal(videoUrl);
          } else {
            document.dispatchEvent(new CustomEvent('open-video-modal', {
              detail: { videoUrl }
            }));
          }
        }
      });
    });
  });
</script>

<style>
  .recipe-card-wrapper {
    display: flex;
    flex-direction: column;
  }

  .recipe-card-wrapper > a {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .recipe-card-image {
    height: 160px;
    flex-shrink: 0;
    position: relative;
  }

  @media (min-width: 768px) {
    .recipe-card-image {
      height: 180px;
    }
  }

  .recipe-card-content {
    flex: 1;
    min-height: 100px;
  }

  .video-play-overlay {
    pointer-events: auto;
  }
</style>
