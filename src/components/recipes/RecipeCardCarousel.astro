---
import LazyImage from '../common/LazyImage.astro';
import { getLocale } from '../../i18n/i18n';

interface Props {
  image: string;
  title: string;
  title_down?: string;
  subtitle_down?: string;
  subtitle?: string;
  time?: string;
  id: string;
  textColor?: string;
  iconColor?: string;
  hoverImage?: string;
  difficulty?: string;
  servings?: number;
  rating?: number;
  isMainCard?: boolean;
  video?: string;
}

const { 
  image, 
  title, 
  subtitle,
  title_down,
  subtitle_down,
  time = "---", 
  id,
  textColor = 'text-blue-900',
  iconColor = 'text-blue-900',
  hoverImage = image,
  difficulty = "---",
  servings = 0,
  rating = 0,
  isMainCard = false,
  video
} = Astro.props;

const currentLocale = getLocale();
const recipeLink = `/${currentLocale}/${currentLocale === 'es' ? 'recetas' : 'recipes'}/${id}`;
---

<div
  class="recipe-card-wrapper block group relative transition-all duration-500 ease-in-out w-full"
  data-has-video={video ? 'true' : 'false'}
>
  <!-- Container principal -->
  <div class="recipe-card-container relative overflow-hidden w-full rounded-[2px] shadow-[0_0_30px_rgba(239,68,68,0.5)]"
       style="border: 2px solid; border-image-source: linear-gradient(237.56deg, #FF2D2D 1.39%, #FF9E9B 47.74%, #FF2D2D 100%); border-image-slice: 1;">

    <!-- Imagen de fondo -->
    <div 
      class="absolute inset-0 cursor-pointer recipe-carousel-image" 
      data-video-trigger={video ? 'true' : 'false'} 
      data-video-url={video || ''}
    >
      <LazyImage
        src={image}
        alt={title}
        class="w-full h-full object-cover"
        transition:name={`recipe-image-${id}`}
      />
      <!-- Overlay oscuro con gradiente -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>

      {video ? (
        <!-- Icono de play si tiene video -->
        <div
          class="video-play-overlay absolute inset-0 flex items-center justify-center z-10"
          data-has-video-indicator
        >
          <div class="w-16 h-16 rounded-full flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[rgba(255,45,48,0.25)] transition-colors duration-200">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-white ml-0.5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>
      ) : (
        <!-- imagen si no tiene video -->
        <a href={recipeLink} class="absolute inset-0 z-10" aria-label={title}></a>
      )}
    </div>

    <!-- Contenido de texto -->
    <div class="absolute inset-0 flex flex-col justify-end p-4 md:p-6 lg:p-8 pointer-events-none">
      <!-- Título principal -->
      <h3 class="font-title font-black text-white uppercase text-lg sm:text-xl md:text-2xl lg:text-[28px] leading-tight tracking-wider line-clamp-2"
          style="text-shadow: 2px 2px 8px rgba(0,0,0,0.8);">
        {title}
        {title_down && <><br/>{title_down}</>}
      </h3>

      <!-- Subtítulo/descripción -->
      {(subtitle || subtitle_down) && (
        <p class="text-white text-sm md:text-lg lg:text-xl font-light leading-relaxed mt-1 line-clamp-2"
           style="text-shadow: 1px 1px 4px rgba(0,0,0,0.8);">
          {subtitle}
          {subtitle_down && <><br/>{subtitle_down}</>}
        </p>
      )}

      <!-- Botón de más detalles - pointer-events-auto para que sea clickable -->
      <div class="mt-3 pointer-events-auto">
        <a
          href={recipeLink}
          class="inline-flex items-center gap-2 px-4 py-2 bg-[rgba(255,45,48,0.2)] border border-[#ff2c2f] rounded-full text-white text-sm font-semibold uppercase tracking-wide hover:bg-[rgba(255,45,48,0.35)] transition-all duration-200 backdrop-blur-sm"
          transition:animate="fade"
        >
          {currentLocale === 'es' ? 'Ver receta' : 'View recipe'}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Efecto de brillo rojo en hover -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
         style="box-shadow: inset 0 0 50px rgba(239, 68, 68, 0.3);"></div>
  </div>
</div>

<script>
  // Manejar clic en la imagen del carousel para abrir el modal de video
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.recipe-carousel-image[data-video-trigger="true"]').forEach((img) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const videoUrl = img.getAttribute('data-video-url');
        if (videoUrl) {
          if ((window as any).openVideoModal) {
            (window as any).openVideoModal(videoUrl);
          } else {
            document.dispatchEvent(new CustomEvent('open-video-modal', {
              detail: { videoUrl }
            }));
          }
        }
      });
    });
  });

  // También para Astro page transitions
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.recipe-carousel-image[data-video-trigger="true"]').forEach((img) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const videoUrl = img.getAttribute('data-video-url');
        if (videoUrl) {
          if ((window as any).openVideoModal) {
            (window as any).openVideoModal(videoUrl);
          } else {
            document.dispatchEvent(new CustomEvent('open-video-modal', {
              detail: { videoUrl }
            }));
          }
        }
      });
    });
  });
</script>

<style>
  .recipe-card-wrapper {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .recipe-card-wrapper:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 40px rgba(255, 45, 45, 0.7);
  }

  .recipe-card-container {
    aspect-ratio: 16/9;
  }

  @media (min-width: 768px) {
    .recipe-card-container {
      aspect-ratio: 2.8/1;
    }
  }

  .video-play-overlay {
    pointer-events: auto;
    z-index: 10;
  }
</style>