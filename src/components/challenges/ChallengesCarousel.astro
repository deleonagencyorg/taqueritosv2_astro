---
import ChallengeCardCarousel from './ChallengeCardCarousel.astro';
import { getLocale } from '../../i18n/i18n';

const currentLang = getLocale();

interface Challenge {
  id: string;
  slug?: string;
  title: string;
  subtitle?: string;
  title_down?: string;
  subtitle_down?: string;
  image: string;
  hover_image?: string;
  preparation_time: number;
  "start-date"?: string;
  "end-date"?: string;
  category?: string;
  category_en?: string;
  categories?: string[];
  categories_en?: string[];
  difficulty?: string;
  servings?: number;
  rating?: number;
  url?: string;
  openInNewTab?: boolean;
}

export interface Props {
  title?: string;
  subtitle?: string;
  title_down?: string;
  subtitle_down?: string;
  textButton?: string;
  items?: any[];
  includeRuta?: boolean;
}

const {
  textButton = currentLang === 'es' ? 'Ver Todas' : 'View All',
  items,
  includeRuta = true
} = Astro.props;

let challengeItems: Challenge[] = Array.isArray(items) ? (items as unknown as Challenge[]) : [];
if (!challengeItems.length) {
  const challengeModules = import.meta.glob<{ default: Challenge }>("../../locales/*/challenges/*.json");
  for (const path in challengeModules) {
    const lang = path.split('/')[3];
    if (lang === currentLang) {
      const mod = await challengeModules[path]();
      challengeItems.push(mod.default);
    }
  }
}

// Filtrar solo retos activos por fecha (start-date <= hoy <= end-date)
function parseDateSafe(s?: string): number {
  if (!s) return NaN;
  // Soporta formatos ISO (YYYY-MM-DD) y otros parseables por Date.parse
  const t = Date.parse(s);
  return isNaN(t) ? NaN : t;
}

const now = Date.now();
challengeItems = challengeItems.filter((c) => {
  const start = parseDateSafe(c["start-date"]);
  const end = parseDateSafe(c["end-date"]);
  // Si hay ambas fechas, validar el rango. Si falta alguna, considerar activa por seguridad sólo si no contradice.
  const afterStart = isNaN(start) ? true : now >= start;
  const beforeEnd = isNaN(end) ? true : now <= end;
  return afterStart && beforeEnd;
});

// Ordenar por fecha de inicio: más reciente primero
challengeItems.sort((a, b) => {
  const aStart = parseDateSafe(a["start-date"]);
  const bStart = parseDateSafe(b["start-date"]);
  const aVal = isNaN(aStart) ? 0 : aStart;
  const bVal = isNaN(bStart) ? 0 : bStart;
  return bVal - aVal;
});

// Agregar tarjeta personalizada de La Ruta
const rutaTruckCard: Challenge = {
  id: 'ruta-truck',
  title: currentLang === 'es' ? 'La Ruta' : 'The Route',
  image: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/Bannergaming.webp?w=1024&q=80',
  hover_image: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/Bannergaming.webp?w=1024&q=80',
  preparation_time: 0,
  "start-date": '2026-01-01',
  "end-date": '2026-12-31',
  url: 'https://www.challengermode.com/s/taqueritos/pages/laruta',
  category: 'other',
  category_en: 'other',
  openInNewTab: true
};
 // Insertar la tarjeta sólo si la prop `includeRuta` está activada
 if (includeRuta !== false) challengeItems.unshift(rutaTruckCard);

function getCategoryKey(challenge: any): string {
  const raw = (
    challenge?.category_en ||
    challenge?.category ||
    challenge?.category?.name ||
    (Array.isArray(challenge?.categories_en) ? challenge.categories_en[0] : undefined) ||
    (Array.isArray(challenge?.categories) ? challenge.categories[0] : undefined) ||
    ''
  );
  const key = String(raw || '').trim().toLowerCase();
  if (['breakfast', 'desayuno'].includes(key)) return 'breakfast';
  if (['brunch'].includes(key)) return 'brunch';
  if (['lunch', 'almuerzo'].includes(key)) return 'lunch';
  return key || 'other';
}
---

{challengeItems.length === 0 ? (
  <div class="w-full py-10 flex items-center justify-center">
    <p class="text-white text-center text-lg md:text-xl font-semibold">
      {currentLang === 'es' ? 'No hay retos disponibles' : 'No challenges available'}
    </p>
  </div>
) : (
  <div class="w-full challenges-carousel-wrapper" data-challenges-carousel>
    <div class="w-full px-4">
    
    <!-- Carousel MOBILE -->
    <div class="challenges-carousel-mobile relative md:hidden">
      {challengeItems.length > 1 && (
        <div class="carousel-navigation">
          <button class="carousel-btn-prev" type="button" aria-label="Anterior" id="prevBtnMobile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          
          <button class="carousel-btn-next" type="button" aria-label="Siguiente" id="nextBtnMobile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.0002 7 15.0002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      )}

      <div class="challenges-carousel-container overflow-hidden w-full">
        <div class="challenges-carousel-track flex items-start w-full gap-4 transition-transform duration-300" id="challengesTrackMobile">
          {challengeItems.map((challenge, index) => (
            <div class="challenge-slide-mobile flex-shrink-0 w-full mt-[48px]" data-category={getCategoryKey(challenge)}>
              <ChallengeCardCarousel
                image={challenge.image}
                hoverImage={challenge.hover_image || challenge.image}
                title={challenge.title}
                fecha_inicio={challenge['start-date']}
                fecha_fin={challenge['end-date']}
                time={`${challenge.preparation_time}MIN`}
                id={challenge.id}
                difficulty={challenge.difficulty || '---'}
                servings={challenge.servings || 0}
                rating={challenge.rating || 0}
                isMainCard={false}
                url={challenge.url}
                openInNewTab={challenge.openInNewTab}
              />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Carousel DESKTOP -->
    <div class="challenges-carousel-desktop relative hidden md:block">
      <div class="carousel-container-desktop overflow-hidden">
        <div class="carousel-track-desktop flex gap-6" id="challengesTrackDesktop">
          {challengeItems.map((challenge, index) => (
            <div class="carousel-slide-desktop flex-shrink-0" data-index={index} data-category={getCategoryKey(challenge)}>
              <ChallengeCardCarousel
                image={challenge.image}
                hoverImage={challenge.hover_image || challenge.image}
                title={challenge.title}
                fecha_inicio={challenge['start-date']}
                fecha_fin={challenge['end-date']}
                time={`${challenge.preparation_time}MIN`}
                id={challenge.id}
                difficulty={challenge.difficulty || '---'}
                servings={challenge.servings || 0}
                rating={challenge.rating || 0}
                isMainCard={false}
                url={challenge.url}
                openInNewTab={challenge.openInNewTab}
              />
            </div>
          ))}
        </div>
      </div>
      {challengeItems.length > 1 && (
        <div class="carousel-navigation">
          <button class="carousel-btn-prev" type="button" aria-label="Anterior">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="carousel-btn-next" type="button" aria-label="Siguiente">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.0002 7 15.0002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      )}
    </div>
    
    </div>
  </div>
)}

<style>
  /* ===== MOBILE CAROUSEL ===== */
  .challenges-carousel-mobile {
    position: relative;
    width: 100%;
  }

  .challenges-carousel-container {
    overflow: hidden;
    width: 100%;
  }

  .challenges-carousel-track {
    display: flex;
    transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
    gap: 1rem;
    width: 100%;
  }

  .challenge-slide-mobile {
    flex-shrink: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 0.5rem;
  }

  /* ===== DESKTOP CAROUSEL ===== */
  .challenges-carousel-desktop {
    position: relative;
    width: 100%;
    padding-top: 20px;
  }

  .carousel-container-desktop {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .carousel-track-desktop {
    display: flex;
    gap: 2rem;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .carousel-slide-desktop {
    flex-shrink: 0;
    width: 710px;
    min-width: 710px;
    position: relative;
  }

  /* ===== NAVIGATION BUTTONS ===== */
  .carousel-navigation {
    position: absolute;
    top: -80px;
    right: 20px;
    display: flex;
    gap: 12px;
    z-index: 100;
  }

  .challenges-carousel-wrapper {
    position: relative;
  }

  .carousel-btn-prev,
  .carousel-btn-next {
    position: relative;
    width: 56px;
    height: 56px;
    background: rgba(255, 45, 48, 0.16);
    border: 2px solid #ff2c2f;
    border-radius: 12px;
    backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .carousel-btn-prev:disabled,
  .carousel-btn-next:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .carousel-btn-prev:not(:disabled):hover,
  .carousel-btn-next:not(:disabled):hover {
    background: #150404;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 68, 0, 0.4);
  }

  .carousel-btn-prev svg,
  .carousel-btn-next svg {
    width: 26px !important;
    height: 26px !important;
  }

  /* ===== RESPONSIVE ===== */
  @media (min-width: 768px) {
    .challenges-carousel-mobile {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .challenges-carousel-desktop {
      display: none;
    }

    .carousel-navigation {
      position: relative;
      top: 0;
      right: auto;
      left: 0;
      transform: none;
      width: 100%;
      margin-top: 16px;
      justify-content: flex-end;
      padding-right: 0.5rem;
    }

    .carousel-btn-prev,
    .carousel-btn-next {
      width: 50px;
      height: 50px;
    }

    .carousel-btn-prev svg,
    .carousel-btn-next svg {
      width: 22px !important;
      height: 22px !important;
    }
  }

  @media (max-width: 480px) {
    .carousel-btn-prev,
    .carousel-btn-next {
      width: 44px;
      height: 44px;
    }

    .carousel-btn-prev svg,
    .carousel-btn-next svg {
      width: 20px !important;
      height: 20px !important;
    }
  }

  /* ===== TABLET & SMALL DESKTOP ===== */
  @media (min-width: 768px) and (max-width: 1200px) {
    .carousel-slide-desktop {
      width: 600px;
      min-width: 600px;
    }
  }

  @media (min-width: 1201px) and (max-width: 1400px) {
    .carousel-slide-desktop {
      width: 650px;
      min-width: 650px;
    }
  }
</style>

<script>
  function initChallengesCarousel(root: Element) {
    if (!root || (root as any).dataset.rcInitialized === 'true') return;
    (root as any).dataset.rcInitialized = 'true';

    // ===== MOBILE CAROUSEL =====
    const trackMobile = root.querySelector('#challengesTrackMobile') as HTMLElement;
    const prevBtnMobile = root.querySelector('#prevBtnMobile') as HTMLButtonElement;
    const nextBtnMobile = root.querySelector('#nextBtnMobile') as HTMLButtonElement;

    if (trackMobile && prevBtnMobile && nextBtnMobile) {
      const slidesMobile = Array.from(trackMobile.querySelectorAll('.challenge-slide-mobile')) as HTMLElement[];
      let currentIndexMobile = 0;

      function updateMobile() {
        const containerWidth = trackMobile.parentElement?.offsetWidth || 0;
        const offset = currentIndexMobile * containerWidth;
        trackMobile.style.transform = `translateX(-${offset}px)`;
        
        // Update button states
        prevBtnMobile.disabled = currentIndexMobile === 0;
        nextBtnMobile.disabled = currentIndexMobile === slidesMobile.length - 1;
      }

      prevBtnMobile.addEventListener('click', () => {
        if (currentIndexMobile > 0) {
          currentIndexMobile--;
          updateMobile();
        }
      });

      nextBtnMobile.addEventListener('click', () => {
        if (currentIndexMobile < slidesMobile.length - 1) {
          currentIndexMobile++;
          updateMobile();
        }
      });

      // Recalcular en resize con debounce
      let resizeTimeout: number;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(updateMobile, 150) as unknown as number;
      });

      // Touch/Swipe support
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      trackMobile.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        isDragging = true;
        trackMobile.style.transition = 'none';
      });

      trackMobile.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        const diff = currentX - startX;
        const containerWidth = trackMobile.parentElement?.offsetWidth || 0;
        const currentOffset = currentIndexMobile * containerWidth;
        trackMobile.style.transform = `translateX(-${currentOffset - diff}px)`;
      });

      trackMobile.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        trackMobile.style.transition = 'transform 500ms cubic-bezier(0.4, 0, 0.2, 1)';
        
        const diff = currentX - startX;
        const threshold = 50;
        
        if (diff > threshold && currentIndexMobile > 0) {
          currentIndexMobile--;
        } else if (diff < -threshold && currentIndexMobile < slidesMobile.length - 1) {
          currentIndexMobile++;
        }
        
        updateMobile();
      });

      updateMobile();
    }

    // ===== DESKTOP CAROUSEL =====
    const trackDesktop = root.querySelector('#challengesTrackDesktop') as HTMLElement;
    const containerDesktop = root.querySelector('.carousel-container-desktop') as HTMLElement;
    const prevBtnDesktop = root.querySelector('.challenges-carousel-desktop .carousel-btn-prev') as HTMLButtonElement;
    const nextBtnDesktop = root.querySelector('.challenges-carousel-desktop .carousel-btn-next') as HTMLButtonElement;

    if (trackDesktop && prevBtnDesktop && nextBtnDesktop && containerDesktop) {
      let currentIndexDesktop = 0;
      let isAnimating = false;

      function getVisibleSlides(): number {
        const containerWidth = containerDesktop.offsetWidth;
        const slideWidth = 710; // Width of each slide
        const gap = 32; // 2rem gap
        return Math.floor((containerWidth + gap) / (slideWidth + gap));
      }

      function updateDesktop(animated = true) {
        if (!animated) {
          trackDesktop.style.transition = 'none';
        }
        
        const slideWidth = 710;
        const gap = 32;
        const offset = currentIndexDesktop * (slideWidth + gap);
        trackDesktop.style.transform = `translateX(-${offset}px)`;
        
        if (!animated) {
          void trackDesktop.offsetWidth; // Force reflow
          trackDesktop.style.transition = 'transform 600ms cubic-bezier(0.4, 0, 0.2, 1)';
        }

        // Update button states
        const slides = Array.from(trackDesktop.children);
        const visibleSlides = getVisibleSlides();
        prevBtnDesktop.disabled = currentIndexDesktop === 0;
        nextBtnDesktop.disabled = currentIndexDesktop >= slides.length - visibleSlides;
      }

      nextBtnDesktop.addEventListener('click', () => {
        if (isAnimating) return;
        
        const slides = Array.from(trackDesktop.children);
        const visibleSlides = getVisibleSlides();
        
        if (currentIndexDesktop < slides.length - visibleSlides) {
          isAnimating = true;
          currentIndexDesktop++;
          updateDesktop();
          
          setTimeout(() => {
            isAnimating = false;
          }, 600);
        }
      });

      prevBtnDesktop.addEventListener('click', () => {
        if (isAnimating) return;
        
        if (currentIndexDesktop > 0) {
          isAnimating = true;
          currentIndexDesktop--;
          updateDesktop();
          
          setTimeout(() => {
            isAnimating = false;
          }, 600);
        }
      });

      // Recalcular en resize con debounce
      let resizeTimeoutDesktop: number;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeoutDesktop);
        resizeTimeoutDesktop = setTimeout(() => {
          // Reset to first slide if current position is invalid
          const slides = Array.from(trackDesktop.children);
          const visibleSlides = getVisibleSlides();
          if (currentIndexDesktop >= slides.length - visibleSlides) {
            currentIndexDesktop = Math.max(0, slides.length - visibleSlides);
          }
          updateDesktop(false);
        }, 150) as unknown as number;
      });

      updateDesktop(false);
    }
  }

  function initAll() {
    document.querySelectorAll('[data-challenges-carousel]').forEach((el) => {
      initChallengesCarousel(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  
  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:after-swap', initAll);
</script>