---
import LazyImage from '../common/LazyImage.astro';
import { getLocale } from '../../i18n/i18n';

interface Props {
  image: string;
  hoverImage?: string;
  title: string;
  subtitle?: string;
  subtitle_down?: string;
  time?: string;
  id: string;
  difficulty?: string;
  servings?: number;
  rating?: number;
  isMainCard?: boolean;
  fecha_inicio?: string;
  fecha_fin?: string;
  url?: string;
  textColor?: string;
  iconColor?: string;
  openInNewTab?: boolean;
}

const { 
  image, 
  title, 
  subtitle,
  subtitle_down,
  time = "---", 
  id,
  fecha_inicio = '',
  fecha_fin = '',
  textColor = 'text-blue-900',
  iconColor = 'text-blue-900',
  hoverImage = image,
  difficulty = "---",
  servings = 0,
  rating = 0,
  isMainCard = false,
  url,
  openInNewTab = false,
} = Astro.props;

const currentLocale = getLocale();
// Usar la url del JSON si está disponible, sino construir con las nuevas rutas correctas
const challengeLink = url || `/${currentLocale}/${currentLocale === 'es' ? 'retos-torneos' : 'challenges-tournaments'}/${id}`;
---

<a 
  href={challengeLink} 
  class="recipe-card block group relative transition-all duration-500 ease-in-out"
  target={openInNewTab ? "_blank" : undefined}
  rel={openInNewTab ? "noopener noreferrer" : undefined}
>
  <!-- Container principal -->
  <div class="card-container relative overflow-hidden rounded-[2px] shadow-[0_0_30px_rgba(239,68,68,0.5)]"
       style="border: 2px solid; border-image-source: linear-gradient(237.56deg, #FF2D2D 1.39%, #FF9E9B 47.74%, #FF2D2D 100%); border-image-slice: 1;">
    
    <!-- Imagen de fondo -->
    <div class="absolute inset-0">
      <LazyImage
        src={image}
        alt={title}
        class="w-full h-full object-cover"
      />
      <!-- Overlay oscuro con gradiente -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
    </div>
    
    <!-- Contenido de texto -->
    <div class="absolute inset-0 flex flex-col justify-end p-4 sm:p-6 md:p-8">
      <!-- Título principal -->
      <h3 class="font-title font-black text-white uppercase text-xl sm:text-2xl md:text-[28px] lg:text-[30px] leading-tight tracking-wider" 
          style="text-shadow: 2px 2px 8px rgba(0,0,0,0.8);">
        {title}
      </h3>
      
      <!-- Fechas: inicio / fin -->
      <div class="text-white text-sm sm:text-base md:text-[18px] font-medium mt-2"
           style="text-shadow: 1px 1px 4px rgba(0,0,0,0.8);">
        <span>Inicio: {fecha_inicio || time}</span>
        <br/>
        <span>Fin: {fecha_fin || '---'}</span>
      </div>
    </div>

    <!-- Efecto de brillo rojo en hover -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
         style="box-shadow: inset 0 0 50px rgba(239, 68, 68, 0.3);"></div>
  </div>
</a>

<style>
  .recipe-card {
    width: 100%;
    height: auto;
  }
  
  .card-container {
    width: 100%;
    height: 255px;
    transition: box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .recipe-card:hover .card-container {
    box-shadow: 0 0 40px rgba(255, 45, 45, 0.7);
  }

  /* Desktop específico */
  @media (min-width: 768px) {
    .recipe-card {
      width: 710px;
      height: 255px;
    }
    
    .card-container {
      width: 710px;
      height: 255px;
    }
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1200px) {
    .recipe-card {
      width: 600px;
      height: 220px;
    }
    
    .card-container {
      width: 600px;
      height: 220px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .recipe-card {
      width: 100%;
      max-width: 500px;
      height: auto;
      margin: 0 auto;
    }

    .card-container {
      width: 100%;
      height: auto;
      min-height: 200px;
      aspect-ratio: 16/9;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .card-container {
      min-height: 180px;
    }
  }
</style>