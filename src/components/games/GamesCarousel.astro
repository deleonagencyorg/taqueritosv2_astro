---
import LazyImage from '../common/LazyImage.astro';
import { getLocale } from '../../i18n/i18n';

const currentLang = getLocale();

interface Game {
  id: number;
  titulo: string;
  enlace: string;
  descripcion: string;
  imagen: string;
}

export interface Props {
  title?: string;
  items?: Game[];
}

const { title, items } = Astro.props;

let gameItems: Game[] = Array.isArray(items) ? items : [];
if (!gameItems.length) {
  try {
    const gamesModule = await import(`../../locales/${currentLang}/games.json`);
    gameItems = gamesModule.default.games || [];
  } catch (e) {
    gameItems = [];
  }
}

const defaultTitle = currentLang === 'es' ? 'Descubre la lista de juegos' : 'Discover the games list';
const displayTitle = title || defaultTitle;
---

{gameItems.length === 0 ? (
  <div class="w-full py-18 flex items-center justify-center">
    <p class="text-white text-center text-lg md:text-xl font-semibold">
      {currentLang === 'es' ? 'No hay juegos disponibles' : 'No games available'}
    </p>
  </div>
) : (
  <div class="games-carousel-container py-12" data-games-carousel>
    <div class="flex items-center justify-between mb-6">
      <slot name="title" />
      {gameItems.length > 1 && (
        <div class="flex gap-3">
          <button
            type="button"
            class="games-carousel-btn-prev w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
            aria-label="Anterior"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="games-carousel-btn-next w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
            aria-label="Siguiente"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.2002 7 15.2002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Carousel con overflow hidden y translateX -->
    <div class="games-carousel-viewport overflow-hidden">
      <div class="games-carousel-track flex transition-transform duration-300 ease-out" data-games-track>
        {gameItems.map((game) => (
          <div class="game-slide flex-shrink-0 px-2">
            <a
              href={game.enlace}
              target="_blank"
              rel="noopener noreferrer"
              class="game-card flex flex-col w-full h-full bg-[#1a0808] border-2 border-[#ff2d2d] transition-all duration-300 rounded-sm"
            >
              <div class="game-card-image w-full flex-shrink-0 overflow-hidden bg-black/50">
                <LazyImage
                  src={game.imagen}
                  alt={game.titulo}
                  class="w-full h-full object-cover object-center"
                  loading="lazy"
                />
              </div>
              <div class="game-card-content flex flex-col flex-grow p-4 md:p-5">
                <h3 class="font-title text-sm md:text-base font-bold text-white uppercase mb-2 leading-tight line-clamp-2">
                  {game.titulo}
                </h3>
                <p class="text-xs md:text-sm text-white/80 leading-relaxed line-clamp-3">
                  {game.descripcion}
                </p>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  function initGamesCarousel() {
    const containers = document.querySelectorAll('[data-games-carousel]');
    
    containers.forEach((container) => {
      if ((container as any)._gamesCarouselInit) return;
      (container as any)._gamesCarouselInit = true;

      const track = container.querySelector('[data-games-track]') as HTMLElement;
      const prevBtn = container.querySelector('.games-carousel-btn-prev') as HTMLButtonElement;
      const nextBtn = container.querySelector('.games-carousel-btn-next') as HTMLButtonElement;
      const slides = Array.from(container.querySelectorAll('.game-slide')) as HTMLElement[];

      if (!track || slides.length === 0) return;

      let currentIndex = 0;

      function getVisibleCount(): number {
        const width = window.innerWidth;
        if (width >= 1024) return 4; // Desktop: 4 cards
        if (width >= 768) return 2;  // Tablet: 2 cards
        return 1;                     // Mobile: 1 card
      }

      function getMaxIndex(): number {
        const visible = getVisibleCount();
        return Math.max(0, slides.length - visible);
      }

      function updateCarousel() {
        const visible = getVisibleCount();
        const slideWidth = 100 / visible;
        
        slides.forEach((slide) => {
          slide.style.width = `${slideWidth}%`;
        });

        const offset = currentIndex * slideWidth;
        track.style.transform = `translateX(-${offset}%)`;
      }

      function goNext() {
        const maxIndex = getMaxIndex();
        if (currentIndex < maxIndex) {
          currentIndex++;
        } else {
          currentIndex = 0;
        }
        updateCarousel();
      }

      function goPrev() {
        if (currentIndex > 0) {
          currentIndex--;
        } else {
          currentIndex = getMaxIndex();
        }
        updateCarousel();
      }

      if (prevBtn) prevBtn.addEventListener('click', goPrev);
      if (nextBtn) nextBtn.addEventListener('click', goNext);

      let resizeTimeout: any = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          const maxIndex = getMaxIndex();
          if (currentIndex > maxIndex) currentIndex = maxIndex;
          updateCarousel();
        }, 100);
      });

      updateCarousel();
    });
  }

  function initGamesHover() {
    const cards = Array.from(document.querySelectorAll('.game-card')) as HTMLElement[];
    if (!cards.length) return;

    cards.forEach((card) => {
      if ((card as any)._hoverInit) return;
      (card as any)._hoverInit = true;

      card.addEventListener('mouseenter', () => {
        cards.forEach((c) => {
          c.classList.add('game-card-dim');
          c.classList.remove('game-card-active');
        });
        card.classList.remove('game-card-dim');
        card.classList.add('game-card-active');
      });

      card.addEventListener('mouseleave', () => {
        cards.forEach((c) => {
          c.classList.remove('game-card-dim', 'game-card-active');
        });
      });
    });
  }

  function initAll() {
    initGamesCarousel();
    initGamesHover();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:after-swap', initAll);
</script>

<style>
  .games-carousel-container {
    width: 100%;
  }

  .games-carousel-viewport {
    width: 100%;
    overflow: hidden;
  }

  .games-carousel-track {
    display: flex;
    will-change: transform;
    align-items: stretch;
  }

  .game-slide {
    flex-shrink: 0;
    padding: 0 8px;
    box-sizing: border-box;
    display: flex;
  }

  .game-card-image {
    height: 140px;
  }

  @media (min-width: 768px) {
    .game-card-image {
      height: 160px;
    }
  }

  @media (min-width: 1024px) {
    .game-card-image {
      height: 180px;
    }
  }

  .game-card-content {
    min-height: 100px;
  }

  @media (min-width: 768px) {
    .game-card-content {
      min-height: 110px;
    }
  }

  .game-card {
    opacity: 1;
    transform: translateY(0) scale(1);
    box-shadow: none;
  }

  .game-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 25px rgba(255, 45, 45, 0.5);
  }

  .game-card-active {
    opacity: 1;
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 0 30px rgba(255, 45, 45, 0.7);
  }

  .game-card-dim {
    opacity: 0.5;
  }
</style>