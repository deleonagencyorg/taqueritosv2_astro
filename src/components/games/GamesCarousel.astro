---
import LazyImage from '../common/LazyImage.astro';
import { getLocale } from '../../i18n/i18n';

const currentLang = getLocale();

interface Game {
  id: number;
  titulo: string;
  enlace: string;
  descripcion: string;
  imagen: string;
}

export interface Props {
  title?: string;
  items?: Game[];
}

const { title, items } = Astro.props;

let gameItems: Game[] = Array.isArray(items) ? items : [];
if (!gameItems.length) {
  try {
    const gamesModule = await import(`../../locales/${currentLang}/games.json`);
    gameItems = gamesModule.default.games || [];
  } catch (e) {
    gameItems = [];
  }
}

const defaultTitle = currentLang === 'es' ? 'Descubre la lista de juegos' : 'Discover the games list';
const displayTitle = title || defaultTitle;
---

{gameItems.length === 0 ? (
  <div class="w-full py-10 flex items-center justify-center">
    <p class="text-white text-center text-lg md:text-xl font-semibold">
      {currentLang === 'es' ? 'No hay juegos disponibles' : 'No games available'}
    </p>
  </div>
) : (
  <div class="games-carousel-container">
    <div class="flex items-center justify-between mb-6">
      <slot name="title" />
      {gameItems.length > 1 && (
        <div class="flex gap-3">
          <button
            type="button"
            class="games-carousel-btn-prev w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
            aria-label="Anterior"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.99976 11.9998H19.9997" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8.99973 17C8.99973 17 3.99978 13.3176 3.99976 12C3.99975 10.6824 8.99976 7 8.99976 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="games-carousel-btn-next w-14 h-14 flex items-center justify-center bg-[rgba(255,45,48,0.16)] border-2 border-[#ff2c2f] backdrop-blur-sm hover:bg-[#150404] transition-all duration-300 rounded-[12px]"
            aria-label="Siguiente"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.0002 11.9998H4.00026" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0003 10.6824 15.2002 7 15.2002 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      )}
    </div>
    <div class="relative games-carousel-wrapper">
      <div class="flex gap-4 overflow-x-auto pb-8 pt-3 games-carousel-track">
        {gameItems.map((game) => (
          <a
            href={game.enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="game-card min-w-[260px] w-[260px] sm:min-w-[280px] sm:w-[280px] bg-[#1a0808] border-2 border-[#ff2d2d] flex-shrink-0 transition-all duration-300"
          >
            <div class="h-52 md:h-72 w-full overflow-hidden bg-black/50">
              <LazyImage
                src={game.imagen}
                alt={game.titulo}
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <h3 class="font-title text-base font-bold text-white uppercase mb-2 leading-tight">
                {game.titulo}
              </h3>
              <p class="text-sm text-white/80 leading-relaxed">
                {game.descripcion}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  function initGamesCarousel() {
    const track = document.querySelector('.games-carousel-track') as HTMLElement;
    const prevBtn = document.querySelector('.games-carousel-btn-prev') as HTMLButtonElement;
    const nextBtn = document.querySelector('.games-carousel-btn-next') as HTMLButtonElement;

    if (!track || !prevBtn || !nextBtn) return;

    function getScrollAmount() {
      const first = track.querySelector('.game-card') as HTMLElement | null;
      if (!first) return 220;
      const cardWidth = Math.round(first.getBoundingClientRect().width);
      const gapStyle = getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0px';
      const gap = Math.round(parseFloat(gapStyle) || 0);
      return cardWidth + gap;
    }

    let scrollAmount = getScrollAmount();

    let resizeTimeout: any = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        scrollAmount = getScrollAmount();
      }, 120);
    });

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGamesCarousel);
  } else {
    initGamesCarousel();
  }

  document.addEventListener('astro:page-load', initGamesCarousel);

  function initGamesHover() {
    const cards = Array.from(document.querySelectorAll('.game-card')) as HTMLElement[];
    if (!cards.length) return;

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        cards.forEach((c) => {
          c.classList.add('game-card-dim');
          c.classList.remove('game-card-active');
        });
        card.classList.remove('game-card-dim');
        card.classList.add('game-card-active');
      });

      card.addEventListener('mouseleave', () => {
        cards.forEach((c) => {
          c.classList.remove('game-card-dim', 'game-card-active');
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGamesHover);
  } else {
    initGamesHover();
  }

  document.addEventListener('astro:page-load', initGamesHover);
</script>

<style>
  .games-carousel-wrapper {
    overflow: visible;
  }

  .games-carousel-track {
    overflow-y: visible;
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  
  .games-carousel-track::-webkit-scrollbar {
    display: none;
    height: 0;
  }

  .games-carousel-track > a:first-child { margin-left: 1rem; }
  .games-carousel-track > a:last-child { margin-right: 1rem; }
  
  @media (min-width: 1024px) {
    .games-carousel-track > a:first-child { margin-left: 1.5rem; }
    .games-carousel-track > a:last-child { margin-right: 1.5rem; }
  }

  .game-card {
    opacity: 1;
    transform: translateY(0) scale(1);
    box-shadow: none;
  }

  .game-card-active {
    opacity: 1;
    transform: translateY(-6px) scale(1.04);
    box-shadow: 0 0 30px rgba(255, 45, 45, 0.7);
  }

  .game-card-dim {
    opacity: 0.45;
  }
</style>