---
import MainLayout from '../../../layouts/MainLayout.astro';
import ChallengesDetail from '../../../views/Challenges/Detail/index.astro';
import { type Locale, setLocale } from '../../../i18n/i18n';

export async function getStaticPaths() {
  const paths: any[] = [];
  const locale = 'en';
  
  // Cargar retos desde archivos JSON individuales con glob estático
  const modules = import.meta.glob('../../../locales/en/challenges/*.json', { eager: true });
  const files = Object.values(modules) as any[];
  
  console.log(`Encontrados ${files.length} retos para idioma ${locale}`);
  
  for (const mod of files) {
    const challenge = (mod as any).default;
    if (!challenge?.id) continue;
    
    paths.push({
      params: { lang: locale, challengeId: challenge.id },
      props: { challenge, currentLang: locale }
    });
  }
  
  console.log(`Generadas ${paths.length} rutas de retos en inglés`);
  return paths;
}

const { lang, challengeId } = Astro.params as { lang: Locale; challengeId: string };

setLocale(lang);
---

<MainLayout title="" description="">
  <ChallengesDetail currentLang={lang} challengeId={challengeId} />
</MainLayout>
