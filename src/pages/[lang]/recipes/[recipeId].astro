---
// src/pages/[lang]/recipes/[recipeId].astro
import { setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import RecipeDetail from '../../../views/Recipes/Detail/index.astro';

// En modo SSR (output: 'server') getStaticPaths no se usa en tiempo de petición.
// Los parámetros vienen directamente de la URL.
const { lang, recipeId } = Astro.params;

if (!lang || !recipeId) {
  return Astro.redirect('/en');
}

setLocale(lang as Locale);

// Cargar la receta desde los archivos JSON en tiempo de petición (SSR)
const modules = import.meta.glob('../../../locales/*/recipes/*.json', { eager: true });
let recipe: any = null;

for (const path in modules) {
  // Extraer el idioma del path con regex (funciona con rutas relativas y absolutas)
  const langMatch = path.match(/locales\/([^/]+)\//);
  const pathLang = langMatch?.[1];
  if (pathLang === lang) {
    const mod = modules[path] as any;
    const r = mod.default ?? mod;
    if (r?.id === recipeId) {
      recipe = r;
      break;
    }
  }
}

if (!recipe) {
  return Astro.redirect(`/${lang}`);
}

const description = lang === 'es'
  ? `Receta con Taqueritos: ${recipe.title}. Descubre ingredientes y paso a paso para prepararla.`
  : `Taqueritos recipe: ${recipe.title}. Discover ingredients and step-by-step instructions to prepare it.`;
---

<MainLayout title={recipe.title} description={description}>
  <RecipeDetail currentLang={lang} recipeId={recipeId} />
</MainLayout>
