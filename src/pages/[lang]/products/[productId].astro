---
// src/pages/[lang]/products/[productId].astro
import { t, setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import ProductDetail from '../../../views/Products/Detail/index.astro';
import { productCopy } from '../../../config/productMeta';

export const prerender = true;

export function getStaticPaths() {
  // Obtener todos los idiomas y productos disponibles
  const locales: Locale[] = ['en'];
  const paths = [];

  for (const locale of locales) {
    // Obtener productos para este idioma
    const products = t('items', { namespace: 'products', locale: locale }) || [];
    
    // Para cada producto, crear una ruta
    for (const product of products) {
      paths.push({
        params: { lang: locale, productId: product.id },
        props: { product, currentLang: locale }
      });
    }
  }

  console.log(`Generadas ${paths.length} rutas de productos`);
  return paths;
}

const { product } = Astro.props;
const { lang, productId } = Astro.params;

// Establecer el idioma para las traducciones
setLocale(lang as Locale);

// Usar los colores específicos del producto para el encabezado
const specialBackgrounds = ['#FDE820', '#BEDE89'];
const isSpecialBackground = specialBackgrounds.includes(product.background_color);

const headerColors = {
  backgroundColor: product.background_color,
  textColor: product.text_color,
  isSpecialBackground: isSpecialBackground
};
const copy = productCopy(product?.id, lang as string);
---

<MainLayout title={copy?.title || product.name} description={copy?.description} headerColors={headerColors}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.nutrition?.description || copy?.description,
      brand: { '@type': 'Brand', name: 'Taqueritos' },
      manufacturer: { '@type': 'Organization', name: 'Snacks Yummies', url: 'https://www.snacksyummies.com/' },
      image: product.image ? [product.image] : undefined,
      url: `https://www.taqueritos.com/en/products/${product.id}/`,
      nutrition: product.nutrition ? {
        '@type': 'NutritionInformation',
        servingSize: product.nutrition.servingSize,
        calories: product.nutrition.calories,
        fatContent: product.nutrition.totalFat,
        sodiumContent: product.nutrition.sodium,
        carbohydrateContent: product.nutrition.totalCarbs,
        proteinContent: product.nutrition.protein,
      } : undefined,
    })}></script>
  </Fragment>
  <ProductDetail currentLang={lang as Locale} productId={productId} />
</MainLayout>
