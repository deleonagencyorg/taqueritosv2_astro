---
import BlogDetail from '../../../views/Blog/Detail/index.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import { setLocale, type Locale } from '../../../i18n/i18n';
import { getBlogPosts } from '../../../services/api/news';

const { lang, newsId } = Astro.params;
const currentLang: Locale = lang === 'en' ? 'en' : 'es';
setLocale(currentLang);

const allBlogPosts = await getBlogPosts(currentLang);
const blogPost = allBlogPosts.find((post) => post.slug === newsId);
if (!blogPost) {
  return Astro.redirect(`/${currentLang}/blog`);
}
---

<MainLayout title={blogPost.title} description={blogPost.summary}>
  <BlogDetail blogPost={blogPost} currentLang={currentLang} allBlogPosts={allBlogPosts} />
</MainLayout>
