---
// Detalle de retos en inglés: /en/challenges-tournaments/:challengeId
// Esta página no está disponible en inglés, redirigir al home
import { type Locale } from '../../../i18n/i18n';

export async function getStaticPaths() {
  // No generar rutas para inglés
  return [];
}

const { lang, challengeId } = Astro.params as { lang: Locale; challengeId?: string };

if (lang === 'es' && challengeId) {
  return Astro.redirect(`/es/retos-torneos/${challengeId}/`, 301);
}

return Astro.redirect('/en/challenges-tournaments/', 301);
---
