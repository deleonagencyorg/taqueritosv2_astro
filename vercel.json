{
  "redirects": [
    {
      "source": "/gaming",
      "destination": "https://www.taqueritos.com/es/retos-torneos",
      "permanent": true
    },
    {
      "source": "/es/gaming",
      "destination": "https://www.taqueritos.com/es/retos-torneos",
      "permanent": true
    },
    {
      "source": "/en/gaming",
      "destination": "https://www.taqueritos.com/es/retos-torneos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|css|js|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/us",
      "destination": "https://taqueritos-qa-us.vercel.app"
    },
    {
      "source": "/us/:path*",
      "destination": "https://taqueritos-qa-us.vercel.app/:path*"
    }
  ]
}
