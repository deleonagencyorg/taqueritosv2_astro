{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/creators/participations/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/detect-locale/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/geo-headers/?$",
			"dest": "_render"
		},
		{
			"src": "^/gaming/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/about-us/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/blog/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/challenges/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/challenges-tournaments/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/contacto/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/jurados/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/news/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/nosotros/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/noticias/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/participacion/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/recetas/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/recipes/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/retos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/retos-torneos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}